      "blocks": {
        "heading_gFC4Fq": {
          "type": "block--heading",
          "settings": {
            "text": "<strong>A WAR CRY FOR CHANGE: THE REVOLUTION TO RECLAIM VETERAN MENTAL HEALTH</strong>",
            "size": "h2",
            "tag": "h2",
            "alignment": "inherit",
            "color": "",
            "font_size_desktop": 0,
            "font_size_mobile": 0
          }
        },
        "text_Fy6J8C": {
          "type": "block--text",
          "settings": {
            "text": "<p>Grunt Style Foundation aims to address this issue head-on through the launch of its latest initiative: The War Cry for Change: A Revolution to Reclaim Veteran Mental Health. In partnership, Mad in America and Grunt Style Foundation have launched the Veteran Storytelling Campaign as part of GSF’s War Cry for Change and MIA’s Veteran and Military Family Initiative. Our goal is to help veterans, military families, and survivors share their experiences within the American mental health system and their encounters with being prescribed psychotropic medications.</p>",
            "size": "body",
            "alignment": "inherit",
            "color": ""
          }
        }
      },
      "block_order": [
        "heading_gFC4Fq",
        "text_Fy6J8C"
      ]
