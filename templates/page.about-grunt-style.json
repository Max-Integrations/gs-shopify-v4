    "about-section-5": {
      "type": "multicolumn",
      "blocks": {
        "retail": {
          "type": "column",
          "settings": {
            "icon": "none",
            "image": "",
            "title": "RETAIL",
            "text": "<p>We are THE destinations that represents the power of the Grunt Style Brand; bringing to life the Mission, Vision, Values with authentic and genuine experiences.</p><p><strong>VISIT OUR LOCATIONS</strong></p><p><a href=\"/pages/outlet-shoppes-at-atlanta-retail-store\">Atlanta, GA</a> &middot; <a href=\"/pages/branson-tanger-outlet-retail-store\">Branson, MO</a> &middot; <a href=\"/pages/grunt-style-broadway-retail-store\">Broadway, San Antonio, TX</a> &middot; <a href=\"/pages/phoenix-premium-outlets-retail-store\">Chandler, AZ</a> &middot; <a href=\"/pages/destin-commons-retail-store\">Destin, FL</a> &middot; <a href=\"/pages/outlet-shoppes-at-el-paso-retail-store\">El Paso, TX</a> &middot; <a href=\"/pages/las-vegas-south-premium-outlets-retail-store\">Las Vegas, NV</a> &middot; <a href=\"/pages/tampa-premium-outlet-retail-store\">Lutz, FL</a> &middot; <a href=\"/pages/myrtle-beach-retail-store\">Myrtle Beach, SC</a> &middot; <a href=\"/pages/opry-mills-retail-store\">Nashville, TN</a> &middot; <a href=\"/pages/grunt-style-norfolk-retail-store\">Norfolk, VA</a> &middot; <a href=\"/pages/grunt-style-sevierville-store\">Sevierville, TN</a> &middot; <a href=\"/pages/tulsa-premium-outlet-retail-store\">Tulsa, OK</a></p>",
            "link_label": "",
            "link": ""
          }
        },
        "perks": {
          "type": "column",
          "settings": {
            "icon": "none",
            "image": "shopify://shop_images/perks-discount-icon_300x300_a84326da-d174-4ea5-920e-a818739c4cdc.png",
            "title": "",
            "text": "<h4>FOCUSED ON THOSE WHO SERVE </h4><p>We provide more for our Military, First Responders, and Healthcare Heros who are Grunt Style customers. As a token of appreciation for your service, Grunt Style is now teamed up with GovX to give you an exclusive 10% discount in our store. </p>",
            "link_label": "Learn More",
            "link": "shopify://pages/govx-discount"
          }
        },
        "rewards": {
          "type": "column",
          "settings": {
            "icon": "none",
            "image": "",
            "title": "GRUNT STYLE REWARDS",
            "text": "<p><em>5-20% BACK ON EVERY ORDER.</em></p><p>Smart patriots get rewarded every time. Spend $60? That's up to $12 back in rewards, not once, but every time you shop. Add free shipping, birthday perks, and it pays to stick with Grunt Style.</p>",
            "link_label": "JOIN REWARDS NOW",
            "link": "https://www.gruntstyle.com/community/membership"
          }
        }
      },
