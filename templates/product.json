{
  "sections": {
    "main": {
      "type": "section--product",
      "blocks": {
        "title": {
          "type": "block--product-title",
          "settings": {
            "size": "h2",
            "tag": "h1"
          }
        },
        "klaviyo_rating": {
          "type": "shopify://apps/klaviyo-reviews/blocks/average-rating/db20e365-d984-4ac4-9655-e1588d951ca9",
          "settings": {
            "product": "{{product}}"
          }
        },
        "price": {
          "type": "block--product-price",
          "settings": {
            "show_savings": true,
            "savings_style": "percent",
            "show_tax_line": false,
            "conditional_message": "<p>{{ product.metafields.custom.conditional_price_message.value }}</p>",
            "message_color": "#ab192d"
          }
        },
        "promo_exclusions": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>{{ product.metafields.custom.promo_exclusions | metafield_tag }}</p>",
            "text_color": "#ab192d"
          }
        },
        "swatches": {
          "type": "block--product-swatches",
          "settings": {
            "style": "pattern",
            "shape": "circle",
            "size": 32,
            "show_label": true,
            "label": "Color"
          }
        },
        "variant_picker": {
          "type": "block--product-variant-picker",
          "settings": {
            "hide_single_value": true,
            "size_guide_label": "Size guide",
            "size_option_name": "Size",
            "size_guide_page": "men-size-chart"
          }
        },
        "gate_wont_show": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>This product is not available for individual purchase</p>",
            "product_tags": "wont-show",
            "customer_rule": "any",
            "hide_buy_controls": true,
            "boxed": true
          }
        },
        "gate_club": {
          "type": "block--product-message",
          "settings": {
            "text": "<p><strong>Heads Up! You Must Be a Club Member To Purchase This Product.</strong></p><p>Please be advised there is no guarantee all sizes are in stock on this product. Although it may say 'Gone for Good' we may or may not re-release these products for pre-order in the future.</p><p>Already a Member? <a href=\"/account/login\">Sign In!</a></p><p>Want to become a Member? <a href=\"/products/join-now\">Join today!</a></p>",
            "product_tags": "club product",
            "exclude_tags": "collection: Sticker Club Vault, wont-show",
            "customer_rule": "missing_all",
            "customer_tags": "Active Subscriber, Active Club Subscription",
            "hide_buy_controls": true,
            "boxed": true
          }
        },
        "gate_sticker_vault": {
          "type": "block--product-message",
          "settings": {
            "text": "<p><strong>Heads Up! You Must Be a Sticker Club Member To Purchase This Product.</strong></p><p>Already a Member? <a href=\"/account/login\">Sign In!</a></p><p>Want to become a Member? <a href=\"/products/sticker-club-monthly\">Join today!</a></p>",
            "product_tags": "club product, collection: Sticker Club Vault",
            "exclude_tags": "wont-show",
            "customer_rule": "missing_all",
            "customer_tags": "Active Sticker Subscription, Active Club Subscription",
            "hide_buy_controls": true,
            "boxed": true
          }
        },
        "gate_rewards_early": {
          "type": "block--product-message",
          "settings": {
            "text": "<p><strong>Heads Up! You Must Be a Grunt Style Rewards Member To Purchase This Product Early.</strong></p><p>Already a Member of Grunt Style Rewards? <a href=\"/account/login\">Sign In!</a></p><p>Want to become a Member? <a href=\"/community/membership\">Join today!</a></p>",
            "product_tags": "rewards early access",
            "exclude_tags": "club product, wont-show",
            "customer_rule": "missing_all",
            "customer_tags": "inveterate-subscriber, Active Sticker Subscription, Active Club Subscription",
            "hide_buy_controls": true,
            "boxed": true
          }
        },
        "notice_usn": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>*Officially licensed Navy products are only sold and shipped within the United States*</p>",
            "product_tags": "USN",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "any",
            "boxed": true
          }
        },
        "notice_army": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>*Officially licensed Army products are only sold and shipped within the United States*</p>",
            "product_tags": "Army",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "any",
            "boxed": true
          }
        },
        "notice_usmc": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>*Officially licensed Marine Corps products are only sold and shipped within the United States*</p>",
            "product_tags": "USMC",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "any",
            "boxed": true
          }
        },
        "notice_usaf": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>*Officially licensed Air Force products are only sold and shipped within the United States*</p>",
            "product_tags": "USAF",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "any",
            "boxed": true
          }
        },
        "notice_ussf": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>*Officially licensed Space Force products are only sold and shipped within the United States*</p>",
            "product_tags": "USSF",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "any",
            "boxed": true
          }
        },
        "notice_starbucks": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>This product is only available to Starbucks members</p><p>Please <a href=\"/account/login\">sign in</a> or <a href=\"/account/register\">register</a> with your starbucks.com email to purchase.</p>",
            "product_tags": "Starbucks",
            "exclude_tags": "club product, rewards early access, wont-show",
            "customer_rule": "missing_all",
            "customer_tags": "starbucks",
            "boxed": true
          }
        },
        "buy_buttons": {
          "type": "block--product-buy-buttons",
          "settings": {
            "show_quantity": true,
            "add_label": "Add to cart",
            "sold_out_label": "Sold out - email when available",
            "sold_out_disables": false,
            "show_dynamic_checkout": false,
            "show_installments": true
          }
        },
        "limited_message": {
          "type": "block--product-message",
          "settings": {
            "text": "<p>{{ product.metafields.custom.limited_custom_product_message.value }}</p>",
            "alignment": "left"
          }
        },
        "wonderment_eta": {
          "type": "shopify://apps/track-by-loop/blocks/pdpEtas/89d63369-6ee7-4097-ac41-8229c6f90001",
          "settings": {
            "eta_text_font_size": 16,
            "hint_text_font_size": 12
          }
        },
        "store_locator": {
          "type": "block--product-store-locator",
          "settings": {
            "label": "Find a store near you",
            "radius": 50,
            "all_url": "shopify://pages/grunt-style-retail-stores",
            "hide_for_tags": "club product, Sticker Club, dropship"
          }
        },
        "acc_description": {
          "type": "block--product-accordion",
          "settings": {
            "heading": "Product Description",
            "source": "text",
            "text": "<p><strong>{{ product.metafields.custom.limited_custom_product_message.value }}</strong></p>{{ product.description }}",
            "open_default": true,
            "visibility": "always"
          }
        },
        "acc_features": {
          "type": "block--product-accordion",
          "settings": {
            "heading": "{{ product.metafields.custom.pdp_feature_slider_name.value }}",
            "source": "features",
            "open_default": true,
            "visibility": "mobile"
          }
        },
        "acc_material": {
          "type": "block--product-accordion",
          "settings": {
            "heading": "Material Description",
            "source": "text",
            "text": "<p>{{ product.metafields.custom.size_fit.value }}</p>{{ product.metafields.custom.material_description | metafield_tag }}",
            "open_default": false,
            "visibility": "always"
          }
        },
        "value_props": {
          "type": "block--product-value-props",
          "settings": {
            "show_borders": true,
            "hide_for_tags": "Custom Apparel, gift card"
          },
          "blocks": {
            "prop_discounts": {
              "type": "block--product-value-prop",
              "settings": {
                "image": "shopify://shop_images/Military__First_Responders_Discount_Icon_2-min.png",
                "text": "Military & First\nResponder Discounts",
                "link": "shopify://pages/govx-discount"
              }
            },
            "prop_shipping": {
              "type": "block--product-value-prop",
              "settings": {
                "image": "shopify://shop_images/Free_Shipping_Icon-min_1806a916-b9f9-4698-b293-bddfd2a13325.png",
                "text": "FREE SHIPPING OVER $75",
                "link": "shopify://pages/shipping-handling"
              }
            },
            "prop_beer": {
              "type": "block--product-value-prop",
              "settings": {
                "image": "shopify://shop_images/Beer_Guarantee_Icon-min-1.webp",
                "hide_for_tags": "no-beer-guarantee"
              }
            },
            "prop_rewards": {
              "type": "block--product-value-prop",
              "settings": {
                "image": "shopify://shop_images/Loyalty_Icon-min.png",
                "text": "GRUNT STYLE REWARDS - Join & Get 5% Back",
                "link": "https://www.gruntstyle.com/community/membership"
              }
            }
          },
          "block_order": [
            "prop_discounts",
            "prop_shipping",
            "prop_beer",
            "prop_rewards"
          ]
        },
        "complementary": {
          "type": "block--product-complementary",
          "settings": {
            "heading": "LOAD UP",
            "limit": 6
          }
        },
        "badge_usa_250": {
          "type": "block--product-badge",
          "settings": {
            "tag": "USA 250",
            "image": "shopify://shop_images/USA_250_Badge_Primary.svg",
            "position": "top-right"
          }
        },
        "badge_100_series": {
          "type": "block--product-badge",
          "settings": {
            "tag": "100 Series",
            "image": "shopify://shop_images/PDP_Badge_100x100_Club_1_of_100_CGS081.svg",
            "position": "top-right"
          }
        },
        "badge_clubea": {
          "type": "block--product-badge",
          "settings": {
            "tag": "ClubEA",
            "image": "shopify://shop_images/PDP_BADGES_Club_Early_Access.png",
            "position": "top-right"
          }
        },
        "badge_club_exclusive": {
          "type": "block--product-badge",
          "settings": {
            "tag": "Club Exclusive",
            "image": "shopify://shop_images/PDP_BADGES_Club_Exclusive.png",
            "position": "top-right"
          }
        },
        "badge_limited_edition": {
          "type": "block--product-badge",
          "settings": {
            "tag": "Limited Edition",
            "image": "shopify://shop_images/PDP_BADGES_Limited_Edition.png",
            "position": "top-right"
          }
        },
        "badge_new": {
          "type": "block--product-badge",
          "settings": {
            "tag": "new",
            "image": "shopify://shop_images/PDP_BADGES_New.png",
            "position": "top-right"
          }
        },
        "badge_best_seller": {
          "type": "block--product-badge",
          "settings": {
            "tag": "Best Seller",
            "image": "shopify://shop_images/PDP_BADGES_Best_Sellers.png",
            "position": "top-right"
          }
        },
        "badge_dnr": {
          "type": "block--product-badge",
          "settings": {
            "tag": "DNR",
            "image": "shopify://shop_images/PDP_BADGES_Last_Chance.png",
            "position": "top-right"
          }
        },
        "badge_usa_made": {
          "type": "block--product-badge",
          "settings": {
            "tag": "USA Made",
            "image": "shopify://shop_images/PDP_BADGES_Made_in_the_USA.png",
            "position": "top-right"
          }
        }
      },
      "block_order": [
        "title",
        "klaviyo_rating",
        "price",
        "promo_exclusions",
        "swatches",
        "variant_picker",
        "gate_wont_show",
        "gate_club",
        "gate_sticker_vault",
        "gate_rewards_early",
        "notice_usn",
        "notice_army",
        "notice_usmc",
        "notice_usaf",
        "notice_ussf",
        "notice_starbucks",
        "buy_buttons",
        "limited_message",
        "wonderment_eta",
        "store_locator",
        "acc_description",
        "acc_features",
        "acc_material",
        "value_props",
        "complementary",
        "badge_usa_250",
        "badge_100_series",
        "badge_clubea",
        "badge_club_exclusive",
        "badge_limited_edition",
        "badge_new",
        "badge_best_seller",
        "badge_dnr",
        "badge_usa_made"
      ],
      "settings": {
        "show_breadcrumb": true,
        "sticky_atc": true,
        "media_ratio": "square",
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 36,
        "sticky_media": true
      }
    },
    "recommendations": {
      "type": "featured-collections",
      "settings": {
        "section_heading": "You May Also Like",
        "heading_text_align": "center",
        "collection_type": "recommendations",
        "collection_source": "manual",
        "layout_style": "carousel",
        "container_width": "lg",
        "grid_image_size": "square",
        "max_number_products_loaded": 10,
        "number_products_per_view_desktop": "4",
        "number_products_per_view_mobile": "2",
        "enable_product_badges": true,
        "enable_product_title": true,
        "enable_product_price": true,
        "enable_product_swatches": true,
        "enable_product_quick_view": true,
        "color_scheme": "scheme-1",
        "heading_size_desktop": 28,
        "heading_size_mobile": 24,
        "navigation_title_size_desktop": 26,
        "navigation_title_size_mobile": 23,
        "cta_title_size_desktop": 26,
        "cta_title_size_mobile": 23,
        "section_spacing_top_desktop": 40,
        "section_spacing_top_mobile": 30,
        "section_spacing_bottom_desktop": 40,
        "section_spacing_bottom_mobile": 30,
        "heading_spacing_top_desktop": 10,
        "heading_spacing_top_mobile": 10,
        "heading_spacing_bottom_desktop": 10,
        "heading_spacing_bottom_mobile": 10,
        "collection_navigation_spacing_top_desktop": 10,
        "collection_navigation_spacing_top_mobile": 10,
        "collection_navigation_spacing_bottom_desktop": 10,
        "collection_navigation_spacing_bottom_mobile": 10,
        "collection_cta_spacing_top_desktop": 10,
        "collection_cta_spacing_top_mobile": 10,
        "collection_cta_spacing_bottom_desktop": 10,
        "collection_cta_spacing_bottom_mobile": 10,
        "cta_text_color": "#000000",
        "cta_text_color_hover": "#ffffff",
        "cta_background_color": "#ffffff",
        "cta_background_color_hover": "#000000",
        "cta_border_color": "#000000",
        "cta_border_color_hover": "#000000"
      }
    },
    "features": {
      "type": "section--product-features",
      "settings": {
        "heading": "<p>{{ product.metafields.custom.pdp_feature_slider_name.value }}</p>",
        "heading_align": "left",
        "heading_size": 36,
        "heading_size_mobile": 24,
        "card_width": 300,
        "card_width_mobile": 160,
        "link_new_window": false,
        "visibility": "desktop",
        "color_scheme": "scheme-1",
        "padding_top": 12,
        "padding_bottom": 12
      }
    }
  },
  "order": [
    "main",
    "features",
    "recommendations"
  ]
}
