        },
        "text_8cqRj6": {
          "type": "text",
          "settings": {
            "text": "<p>The <strong>Grunt Style Foundation</strong> is a separate legal entity from <strong>Grunt Style, LLC</strong>, and all donations are transferred directly to the Foundation to support its charitable mission.</p>"
