    "irreverent": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "IRREVERENT WARRIORS",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p><b>Our Mission:</b> End veteran suicide by bringing back the platoon-level camaraderie most of us lost when we hung up the uniform.</p>\n<p><b>Here’s How We Do It:</b></p>\n<ul>\n<li><p><b>Silkies Hikes:</b> 8–10 miles of laughs, ruck rash, and real connection.</p></li>\n<li><p><b>Silkies Retreats:</b> Weekend resets with cold plunges, bonfires, and zero bureaucracy.</p></li>\n<li><p><b>Camaraderie Counseling:</b> No red tape, no sterile waiting rooms—just vets healing the way we know best.</p></li>\n<li><p><b> Dark Humor Allowed: </b>Laughter, sweat, and shared misery are part of the therapy.</p></li>\n</ul>\n\n<p><b>Irreverent Warriors</b> is powered by the <b>Grunt Style Foundation (501c3)</b> — a nonprofit on a mission to restore purpose, connection, and pride among veterans.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
