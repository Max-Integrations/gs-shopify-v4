    "testimonials": {
      "type": "custom-testimonials",
      "blocks": {
        "testimonial_bkk8cH": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"The Silkies Hike saved my life. I showed up expecting a walk and left with a brotherhood that checks on me every single day. That's what GSF builds — community that doesn't quit.\"",
            "customer_name": "- SARAH K.",
            "customer_jd": "U.S. Marine Corps Veteran"
          }
        },
        "testimonial_pz4GGa": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"After three deployments and years of struggling, GSF connected me with equine therapy that changed everything. For the first time in a decade, I feel like myself again.\"",
            "customer_name": "- MARCUS T.",
            "customer_jd": "U.S. Army, 3x Deployed"
          }
        },
        "testimonial_GXHJAE": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"Excellent work. Don’t know how anyone could have watched any of the livestreams from your week in DC and not been moved to tears and action. Onward!\"",
            "customer_name": "- Paige Figi",
            "customer_jd": ""
          }
        },
        "testimonial_g9jaQN": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"As an MST Survivor, the healing modalities Grunt Style Foundation introduced me to removed the fear and anxiety, replacing it with an internal peace where the VA methods only masked my symptoms and never addressed the moral injury.\"",
            "customer_name": "- Janae S.",
            "customer_jd": ""
          }
        },
        "testimonial_dzLJbK": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"Every soul at the integration retreat was touched in a way that whispered: You are safe. You are family. You are loved exactly as you are.\"",
            "customer_name": "- Emily J.",
            "customer_jd": ""
          }
        },
        "testimonial_pAyLAJ": {
          "type": "testimonial",
          "settings": {
            "testimonial_heading": "",
            "comment_text": "\"When it comes to healing veterans Grunt Style Integration is a force multiplier, it IS the Trojan Horse that wasn’t expected. Grunt Style Integration is bringing alternative healing, holistic healing, REAL healing to veterans as an alternative to being lost in the sauce of prescription pills and suicidal ideation.\"",
            "customer_name": "- Caros Duran",
            "customer_jd": "Plant Medicine Guide"
          }
        }
      },
