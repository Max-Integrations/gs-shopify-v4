          }
        },
        "yt_short_dPqaTb": {
          "type": "yt_short",
          "settings": {
            "yts_video_url": "https://youtu.be/JMOOeUr7LYM",
            "yts_thumbnail_image": "shopify://shop_images/Thumbnail_1920x1080_EP7_VBT_-_S8_Play_button.jpg",
            "yts_video_title": "",
            "yts_description": "<strong>Episode 7: </strong>Do you have any idea how much of a badass you have to be to be a Force Recon legend?  Violent But True features Major James Capers, a true icon of the U.S. Marine Corps and a true body stacker. I mean they don’t just hand out battlefield commissions every day, and this guy was LITERALLY on the recruiting posters.",
            "enable_cta_link": true,
            "yts_cta_link_type": "link",
            "yts_cta_link_text": "",
            "yts_cta_link_url": "https://youtu.be/JMOOeUr7LYM",
            "yts_cta_link_new_window": true
          }
        },
        "yt_short_3gEwCJ": {
          "type": "yt_short",
          "settings": {
            "yts_video_url": "https://youtu.be/mPrzfG_o-n0",
            "yts_thumbnail_image": "shopify://shop_images/Thumbnail_1920x1080_EP6_VBT_-_S8_Play_button.jpg",
            "yts_video_title": "Episode 6 John chapman",
            "yts_description": "<strong>Episode 6: </strong>John Chapman proved you can be an actual hero, do heroic sh*t, get killed in the process and it all comes down to paperwork in the end.",
            "enable_cta_link": true,
            "yts_cta_link_type": "link",
