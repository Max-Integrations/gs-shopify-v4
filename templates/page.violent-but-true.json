        "yt_short_FRTKUA": {
          "type": "yt_short",
          "settings": {
            "yts_video_url": "https://youtu.be/R0oWzY-vp_4",
            "yts_thumbnail_image": "shopify://shop_images/Thumbnail_1920x1080_EP8_VBT_-_S8_Play_button.jpg",
            "yts_video_title": "",
            "yts_description": "<strong>Episode 8: </strong>Violent But True is back with a tale so insane it belongs in the damn Avengers. Medal of Honor Recipient Sgt. 1st Class LeRoy Petry wasn’t born with superpowers… but Some war stories sound like Marvel comics until you realize they actually happened.",
            "enable_cta_link": true,
            "yts_cta_link_type": "link",
            "yts_cta_link_text": "",
            "yts_cta_link_url": "https://youtu.be/R0oWzY-vp_4",
