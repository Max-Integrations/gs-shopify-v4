            "alignment": "inherit",
            "color": "",
            "font_size_desktop": 0,
            "font_size_mobile": 0
          }
        },
        "text_GNpYAY": {
          "type": "block--text",
          "settings": {
            "text": "<h6>This year, we're taking action. Every purchase of our Memorial Day t-shirts will contribute $5 directly to the Children of Fallen Patriots Foundation - a mission to provide financial support for families of service members who have fallen.</h6><h6></h6><h6>While we honor the fallen, we stand for those still in the fight - those battling invisible wounds long after their service ends.</h6>",
            "size": "body",
            "alignment": "inherit",
            "color": ""
          }
        }
      },
