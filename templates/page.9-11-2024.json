        "text_jBjWJD": {
          "type": "block--text",
          "settings": {
            "text": "<p>September 11, 2001 changed America forever. </p><p>For a moment, differences took a back seat, neighbors became family, and a nation stood together.</p><p>For Grunt Style, 9/11 isn’t a hashtag. It isn’t content. It’s a promise: <strong>Never Forget</strong> means never stop telling the truth about what happened, what it cost, and who stood up when America was on her knees.</p>",
            "size": "body",
            "alignment": "inherit",
            "color": ""
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading_gnteJM",
        "text_jBjWJD"
      ],
      "disabled": true,
      "settings": {
        "section_visibility": "always",
        "bg_image_collection": false,
        "bg_overlay_color": "#000000",
        "bg_overlay_opacity": 30,
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": true,
