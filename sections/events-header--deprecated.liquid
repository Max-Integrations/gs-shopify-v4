      "min": 18,
      "max": 38,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "events_header_cta_text_size_mobile",
      "label": "Link size (mobile)",
      "min": 11,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 24
