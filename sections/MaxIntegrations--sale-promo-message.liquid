                    },
                    {
                        "type": "select",
                        "id": "style",
                        "label": "Style",
                        "options": [
                            { "label": "Solid Button", "value": "btn-primary" },
                            { "label": "Outline Button", "value": "btn-outline" },
                            { "label": "Text Link", "value": "btn-link" }
                        ],
                        "default": "btn-primary"
                    },
                    {
                        "type": "checkbox",
                        "id": "open_in_new_tab",
                        "label": "Open in new tab",
                        "default": false
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Sale Promo Message",
                "blocks": [
                    { "type": "message_line" },
                    { "type": "button" }
                ]
            }
        ]
    }
{% endschema %}