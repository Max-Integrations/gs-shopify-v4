<style>
    #shopify-section-{{ section.id }} {
        --padding-top: {{ section.settings.padding_top_desktop }}px;
        --padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
    
    .sale-promo-{{ section.id }} {
        position: relative;
        width: 100%;
        padding-top: var(--padding-top);
        padding-bottom: var(--padding-bottom);
        overflow: hidden;
        background: {{ section.settings.background_color }}; 
    }

    /* Section Visibility */
    {% if section.settings.visibility == 'small' %}
        @media (min-width: 769px) { #shopify-section-{{ section.id }} { display: none !important; } }
    {% elsif section.settings.visibility == 'large' %}
        @media (max-width: 768px) { #shopify-section-{{ section.id }} { display: none !important; } }
    {% endif %}

    .promo-bg-picture {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    .promo-bg-picture img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Layout Container */
    .promo-content-{{ section.id }} {
        position: relative;
        z-index: 1;
        display: flex;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        {% if section.settings.layout_preset == 'center' %}
            align-items: {{ section.settings.alignment_preset }};
        {% else %}
            align-items: center;
        {% endif %}
    }

    /* Desktop Alignment Logic */
    .sale-promo-{{ section.id }}.layout-left .promo-content-{{ section.id }} { flex-direction: row; justify-content: space-between; text-align: left; }
    .sale-promo-{{ section.id }}.layout-right .promo-content-{{ section.id }} { flex-direction: row-reverse; justify-content: space-between; text-align: right; }
    .sale-promo-{{ section.id }}.layout-center .promo-content-{{ section.id }} { flex-direction: column; justify-content: center; text-align: center; }

    .promo-messages { 
        display: flex; 
        flex-direction: column; 
        gap: {{ section.settings.item_gap_desktop }}px;
        {% if section.settings.layout_preset == 'center' %}
            align-items: {{ section.settings.alignment_preset }};
        {% else %}
            align-items: {{ section.settings.layout_preset }};
        {% endif %}
    }

    .promo-message {
        color: var(--color);
        background-color: var(--background-color);
        font-size: var(--font-size-desktop);
        letter-spacing: var(--letter-spacing);
        padding: var(--padding-y-desktop) var(--padding-x-desktop);
    }

    /* The Stretched Link Fix: covers the banner, sits under the buttons */
    .promo-stretched-link {
        position: absolute;
        inset: 0;
        z-index: 5; 
    }

    .promo-btn {
        display: inline-flex;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
    }
    .promo-btn:hover { opacity: 0.8; }
    
    .btn-primary { background: #000; color: #fff; border: 1px solid #000; }
    .btn-outline { background: transparent; color: #000; border: 1px solid #000; }
    .btn-link { background: transparent; color: inherit; padding: 0; text-decoration: underline; }

    /* Mobile Flex Override */
    @media (max-width: 768px) {
        .promo-content-{{ section.id }} {
            flex-direction: column !important;
            justify-content: center;
            text-align: center;
            align-items: center;
        }

        .promo-messages { 
            gap: {{ section.settings.item_gap_mobile }}px;
            align-items: center;
        }

        .promo-message {
            padding: var(--padding-y-mobile) var(--padding-x-mobile);
            font-size: var(--font-size-mobile);
        }

        #shopify-section-{{ section.id }} {
            --padding-top: {{ section.settings.padding_top_mobile }}px;
            --padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }
    }
</style>

<div class="sale-promo-{{ section.id }} layout-{{ section.settings.layout_preset }}">
    
    {% if section.settings.banner_link != blank %}
        <a href="{{ section.settings.banner_link }}" class="promo-stretched-link" {% if section.settings.open_in_new_tab %}target="_blank"{% endif %} aria-label="Promo Banner Link"></a>
    {% endif %}

    {% if section.settings.background_image_desktop != blank or section.settings.background_image_mobile != blank %}
        <picture class="promo-bg-picture">
            {% if section.settings.background_image_mobile != blank %}
                <source media="(max-width: 768px)" srcset="{{ section.settings.background_image_mobile | image_url: width: 800 }}">
            {% endif %}
            
            {% assign desktop_img = section.settings.background_image_desktop | default: section.settings.background_image_mobile %}
            {{ desktop_img | image_url: width: 2000 | image_tag: loading: 'lazy' }}
        </picture>
    {% endif %}

    <div class="promo-content-{{ section.id }}">
        
        <div class="promo-messages">
            {% for block in section.blocks %}
                {% if block.type == 'message_line' %}
                    <div 
                        class="promo-message"
                        style="
                            --color: {{ block.settings.text_color }}; 
                            --background-color: {{ block.settings.background_color }}; 
                            --padding-x-desktop: {{ block.settings.padding_horizontal_desktop }}px;
                            --padding-y-desktop: {{ block.settings.padding_vertical_desktop }}px;
                            --padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;
                            --padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
                            --font-size-desktop: {{ block.settings.size_scale_desktop }};
                            --font-size-mobile: {{ block.settings.size_scale_mobile }};
                            --letter-spacing: {{ block.settings.letter_spacing }}px;
                            " 
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.text }}
                    </div>
                {% elsif block.type == 'button' and section.settings.layout_preset == 'center' %}
                        <a href="{{ block.settings.url }}" class="promo-btn {{ block.settings.style }}" {% if block.settings.open_in_new_tab %}target="_blank"{% endif %} {{ block.shopify_attributes }}>
                            {{ block.settings.text }}
                        </a>
                    {% endif %}
                {% endfor %}
        </div>

        {% if section.settings.layout_preset != 'center' %}
            {% assign button_blocks = section.blocks | where: "type", "button" %}
            {% if button_blocks.size > 0 %}
                <div class="promo-actions">
                    {% for block in button_blocks %}
                        <a href="{{ block.settings.url }}" class="promo-btn {{ block.settings.style }}" {% if block.settings.open_in_new_tab %}target="_blank"{% endif %} {{ block.shopify_attributes }}>
                            {{ block.settings.text }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}

    </div>
</div>
{% schema %}
    {
        "name": "Sale Promo Message",
        "class": "promotional-message-sale",
        "settings": [
            {
                "type": "header",
                "content": "Layout & Visibility"
            },
            {
                "type": "select",
                "id": "visibility",
                "label": "Visibility",
                "options": [
                    { "label": "Always", "value": "always" },
                    { "label": "Mobile only", "value": "small" },
                    { "label": "Desktop only", "value": "large" }
                ],
                "default": "always"
            },
            {
                "type": "select",
                "id": "layout_preset",
                "label": "Layout position",
                "options": [
                    { "label": "Stacked vertically in order", "value": "center" },
                    { "label": "Text left, CTA right", "value": "left" },
                    { "label": "Text right, CTA left", "value": "right" }
                ],
                "default": "center"
            },
            {
                "type": "select",
                "id": "alignment_preset",
                "label": "Layout alignment",
                "options": [
                    { "label": "Left", "value": "start" },
                    { "label": "Center", "value": "center" },
                    { "label": "Right", "value": "end" }
                ],
                "default": "center",
                "visible_if": "{{ section.settings.layout_preset == 'center' }}"
            },
            {
                "type": "header",
                "content": "Background & Banner Link"
            },
            {
                "type": "color",
                "id": "background_color",
                "label": "Background color/gradient",
                "default": "#5D5D39"
            },
            {
                "type": "image_picker",
                "id": "background_image_desktop",
                "label": "Background image (Desktop)"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background image (Mobile)"
            },
            {
                "type": "url",
                "id": "banner_link",
                "label": "Full banner link",
                "info": "Leave blank if banner is not clickable."
            },
            {
                "type": "checkbox",
                "id": "open_in_new_tab",
                "label": "Open banner link in new tab",
                "default": false
            },
            {
                "type": "header",
                "content": "Spacing"
            },
            {
                "type": "range",
                "id": "padding_top_desktop",
                "label": "Top padding (desktop)",
                "min": 0,
                "max": 128,
                "step": 4,
                "unit": "px",
                "default": 48
            },
            {
                "type": "range",
                "id": "padding_bottom_desktop",
                "label": "Bottom padding (desktop)",
                "min": 0,
                "max": 128,
                "step": 4,
                "unit": "px",
                "default": 48
            },
            {
                "type": "range",
                "id": "padding_top_mobile",
                "label": "Top padding (mobile)",
                "min": 0,
                "max": 128,
                "step": 4,
                "unit": "px",
                "default": 48
            },
            {
                "type": "range",
                "id": "padding_bottom_mobile",
                "label": "Bottom padding (mobile)",
                "min": 0,
                "max": 128,
                "step": 4,
                "unit": "px",
                "default": 48
            },
            {
                "type": "range",
                "id": "item_gap_desktop",
                "label": "Gap between items (desktop)",
                "min": 0,
                "max": 32,
                "step": 2,
                "unit": "px",
                "default": 4
            },
            {
                "type": "range",
                "id": "item_gap_mobile",
                "label": "Gap between items (mobile)",
                "min": 0,
                "max": 32,
                "step": 2,
                "unit": "px",
                "default": 4
            }
        ],
        "blocks": [
            {
                "type": "message_line",
                "name": "Message Line",
                "limit": 3,
                "settings": [
                        {
                        "type": "header",
                        "content": "Content"
                        },
                    {
                        "type": "inline_richtext",
                        "id": "text",
                        "label": "Text"
                    },
                        {
                        "type": "header",
                        "content": "Content style"
                        },
                    {
                        "type": "select",
                        "id": "size_scale_desktop",
                        "label": "Typography size (desktop)",
                        "options": [
                            { "label": "Small", "value": "0.875rem" },
                            { "label": "Medium", "value": "1rem" },
                            { "label": "Large", "value": "1.125rem" },
                            { "label": "XL", "value": "1.5rem" },
                            { "label": "2XL", "value": "2rem" },
                            { "label": "3XL", "value": "2.5rem"  },
                            { "label": "4XL", "value": "3rem"  },
                            { "label": "5XL", "value": "4rem"  },
                            { "label": "6XL", "value": "5rem"  }
                        ],
                        "default": "1rem"
                    },
                    {
                        "type": "select",
                        "id": "size_scale_mobile",
                        "label": "Typography size (mobile)",
                        "options": [
                            { "label": "Small", "value": "0.875rem" },
                            { "label": "Medium", "value": "1rem" },
                            { "label": "Large", "value": "1.125rem" },
                            { "label": "XL", "value": "1.5rem" },
                            { "label": "2XL", "value": "2rem" },
                            { "label": "3XL", "value": "2.5rem"  },
                            { "label": "4XL", "value": "3rem"  },
                            { "label": "5XL", "value": "4rem"  },
                            { "label": "6XL", "value": "5rem"  }
                        ],
                        "default": "1rem"
                    },
                    {
                        "type": "color",
                        "id": "text_color",
                        "label": "Text color",
                        "default": "#000000"
                    },
                    {
                        "type": "color",
                        "id": "background_color",
                        "label": "Background color",
                        "default": "#00000000"
                    },
                    {
                        "type": "range",
                        "id": "letter_spacing",
                        "label": "Space between letters",
                        "default": 0,
                        "min": 0,
                        "max": 16,
                        "step": 1
                    },
                    {
                    "type": "header",
                    "content": "Layout"
                    },
                    {
                        "type": "range",
                        "id": "padding_horizontal_desktop",
                        "label": "Horizontal padding (desktop)",
                        "default": 8,
                        "min": 0,
                        "max": 128,
                        "step": 2
                    },
                    {
                        "type": "range",
                        "id": "padding_vertical_desktop",
                        "label": "Vertical padding (desktop)",
                        "default": 8,
                        "min": 0,
                        "max": 128,
                        "step": 2
                    },
                    {
                        "type": "range",
                        "id": "padding_horizontal_mobile",
                        "label": "Horizontal padding (mobile)",
                        "default": 8,
                        "min": 0,
                        "max": 128,
                        "step": 2
                    },
                    {
                        "type": "range",
                        "id": "padding_vertical_mobile",
                        "label": "Vertical padding (mobile)",
                        "default": 8,
                        "min": 0,
                        "max": 128,
                        "step": 2
                    },
                ]
            },
            {
                "type": "button",
                "name": "Button / Link",
                "limit": 2,
                "settings": [
                    {
                        "type": "text",
