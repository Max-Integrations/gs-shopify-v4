      },
      {
        "type": "color",
        "id": "chevron_color_text",
        "label": "Color",
        "default": "#ab192d"
      },
      {
        "type": "select",
        "id": "chevron_row_fill",
        "label": "Fill",
        "options": [
          {
            "value": "solid",
            "label": "Solid"
          },
          {
            "value": "outline",
            "label": "Outline"
          }
        ],
        "default": "solid",
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "range",
        "id": "chevron_row_size",
        "label": "Size (desktop)",
        "min": 20,
        "max": 140,
        "step": 2,
        "unit": "px",
        "default": 80,
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "range",
        "id": "chevron_row_size_mobile",
        "label": "Size (mobile)",
        "min": 16,
        "max": 120,
        "step": 2,
        "unit": "px",
        "default": 64,
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "range",
        "id": "chevron_row_gap",
        "label": "Space between chevrons (desktop)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 30,
        "visible_if": "{{ section.settings.show_chevrons }}",
        "info": "0 merges them into one solid run. Raise it to separate them into stripes."
      },
      {
        "type": "range",
        "id": "chevron_row_gap_mobile",
        "label": "Space between chevrons (mobile)",
        "min": 0,
        "max": 80,
        "step": 1,
        "unit": "px",
        "default": 30,
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "range",
        "id": "chevron_row_space_above",
        "label": "Space above",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 24,
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "range",
        "id": "chevron_row_space_below",
        "label": "Space below",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0,
        "visible_if": "{{ section.settings.show_chevrons }}"
      },
      {
        "type": "header",
        "content": "Chevrons over the image"
      },
