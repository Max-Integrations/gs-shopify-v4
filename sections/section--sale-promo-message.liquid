<style>
    {% if section.settings.section-visibility == 'small' %}
        @media (min-width: 769px) {
            #shopify-section-{{ section.id }} {
                display: none !important;
            }
        }
    {% elsif section.settings.section-visibility == 'large' %}
        @media (max-width: 768px) {
            #shopify-section-{{ section.id }} {
                display: none !important;
            }
        }
    {% endif %}
    
    #shopify-section-{{ section.id }} {
        .sale-promo-message-wrapper {
            width: 100vw;
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
            display: flex;
            flex-wrap: wrap;
            {% if section.settings.section-layout-preset == 'left' %}
                flex-direction: row;
                justify-content: space-between;
            {% elsif section.settings.section-layout-preset == 'right' %}
                flex-direction: row-reverse;
                justify-content: space-between;
            {% else %}
                flex-direction: column;
                justify-content: center;
            {% endif %}
            align-items: center;
            overflow: hidden;
            gap: {{ section.settings.section-gap-desktop }}px;
            padding-top: {{ section.settings.section-padding-top-desktop }}px;
            padding-right: {{ section.settings.section-padding-right-desktop }}px;
            padding-bottom: {{ section.settings.section-padding-bottom-desktop }}px;
            padding-left: {{ section.settings.section-padding-left-desktop }}px;
            margin-top: {{ section.settings.section-margin-top-desktop }}px;
            margin-bottom: {{ section.settings.section-margin-bottom-desktop }}px;
            {% if section.settings.section-background-type == 'color' %}
                background-color: {{ section.settings.section-background-color }};
            {% endif %}
        }

        .promo-message-wrapper {
            display: flex;
            flex-direction: column;
            gap: {{ section.settings.promo-text-gap-desktop }}px;
            color: {{ section.settings.promo-text-color }};
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .promo-bg-image-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .promo-bg-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

        .promo-bg-mobile { 
            display: block; 
        }

        .promo-bg-desktop { 
            display: none; 
        }

        @media screen and (max-width: 768px){
            
            .sale-promo-message-wrapper {
                flex-direction: column;
                justify-content: center;
                gap: {{ section.settings.section-gap-mobile }}px;
                padding-top: {{ section.settings.section-padding-top-mobile }}px;
                padding-right: {{ section.settings.section-padding-right-mobile }}px;
                padding-bottom: {{ section.settings.section-padding-bottom-mobile }}px;
                padding-left: {{ section.settings.section-padding-left-mobile }}px;
                margin-top: {{ section.settings.section-margin-top-mobile }}px;
                margin-bottom: {{ section.settings.section-margin-bottom-mobile }}px;
            }

            .promo-message-wrapper {
                gap: {{ section.settings.promo-text-gap-mobile }}px;
            }
        }

        @media screen and (min-width: 769px) {

            .promo-bg-mobile { 
                display: none; 
            }
            
            .promo-bg-desktop { 
                display: block; 
            }
        }
    }
</style>

{% if section.blocks.size > 0 %}
    {% assign is_global_link = false %}
    {% assign has_background_image = false %}
    
    {% if section.settings.section-background-image-desktop != blank or section.settings.section-background-image-mobile != blank %}
        {% assign has_background_image = true %}
    {% endif %}

    {% if section.settings.section-background-type == 'image' and has_background_image and section.settings.section-background-hyperlink and section.settings.section-background-hyperlink-url != empty %}
        {% assign is_global_link = true %}
    {% endif %}

    {% if is_global_link %}
        <a class="sale-promo-message-wrapper" href="{{ section.settings.section-background-hyperlink-url }}"{% if section.settings.section-background-hyperlink-target == 'blank' %} target="_blank"{% endif %}>
    {% else %}
        <div class="sale-promo-message-wrapper">
    {% endif %}

        {% if section.settings.section-background-type == 'image' and has_background_image %}
            {% assign desktop_img = section.settings.section-background-image-desktop %}
            {% assign mobile_img = section.settings.section-background-image-mobile | default: desktop_img %}
            {% assign desktop_img = desktop_img | default: mobile_img %}
            
            <div class="promo-bg-image-container">
                {{ mobile_img | image_url: width: 800 | image_tag: class: 'promo-bg-image promo-bg-mobile', loading: 'lazy', alt: mobile_img.alt | escape }}
                {{ desktop_img | image_url: width: 2000 | image_tag: class: 'promo-bg-image promo-bg-desktop', loading: 'lazy', alt: desktop_img.alt | escape }}
            </div>
        {% endif %}
        
        <div class="promo-message-wrapper">
            {% assign block_index = 0 %}
            {% for block in section.blocks %}
                {% if block.type == 'message_line' %}
                    {% assign block_index = block_index | plus: 1 %}
                    <span class="promo-message">{{ block.settings.message_line_text }}</span>
                    <style>
                    @media (max-width: 768px) {
                        #shopify-section-{{ section.id }} .promo-message-wrapper .promo-message:nth-of-type({{ block_index }}) { font-size: {{ block.settings.message_line_font_size_mobile }}px; }
                    }
            
                    @media (min-width: 769px) {
                        #shopify-section-{{ section.id }} .promo-message-wrapper .promo-message:nth-of-type({{ block_index }}) { font-size: {{ block.settings.message_line_font_size_desktop }}px; }
                    }
                    </style>
                {% endif %}
            {% endfor %}
        </div> 

        {% assign cta_count = 0 %}
        {% for block in section.blocks %}
            {% if block.type == 'link_cta_button' %}
                {% assign cta_count = cta_count | plus: 1 %}
            {% endif %}
        {% endfor %}

        {% if cta_count > 0 %}
            <style>
                #shopify-section-{{ section.id }} .links-cta-wrapper {
                    display: flex;
                    flex-wrap: wrap;
                    gap: {{ section.settings.cta-gap-desktop }}px;
                    justify-content: center;
                    align-items: center;
                    position: relative;
                    z-index: 1;
                }
                @media screen and (max-width: 768px){
                    #shopify-section-{{ section.id }} .links-cta-wrapper {
                        gap: {{ section.settings.cta-gap-mobile }}px;
                    }
                }
            </style>
            
            <div class="links-cta-wrapper">
                {% for block in section.blocks %}
                    {% if block.type == 'link_cta_button' %}
                        
                        {% if is_global_link %}
                            <span class="promo-cta promo-cta-{{ block.id }}">
                                {{ block.settings.link_cta_text }}
                            </span>
                        {% else %}
                            <a href="{{ block.settings.link_cta_url }}" class="promo-cta promo-cta-{{ block.id }}"{% if block.settings.open_in_new_window %} target="_blank"{% endif %}>
                                {{ block.settings.link_cta_text }}
                            </a>
                        {% endif %}

                        <style>
                            .promo-cta-{{ block.id }} {
                                display: inline-flex;
                                justify-content: center;
                                align-items: center;
                                text-decoration: none;
                                text-align: center;
                                color: {{ section.settings.cta-text-color }};
                                font-weight: {{ section.settings.cta-font-weight }};
                                {% if section.settings.cta-interactable-style == 'button' %}
                                    background-color: {{ section.settings.cta-background-color }};
                                    border: {{ section.settings.cta-border-width }}px solid {{ section.settings.cta-border-color }};
                                    padding: {{ section.settings.cta-padding-top-desktop }}px {{ section.settings.cta-padding-right-desktop }}px {{ section.settings.cta-padding-bottom-desktop }}px {{ section.settings.cta-padding-left-desktop }}px;
                                {% endif %}
                            }
                            @media screen and (max-width: 768px) {
                                .promo-cta-{{ block.id }} {
                                    font-size: {{ section.settings.cta-font-size-mobile }}px;
                                    {% if section.settings.cta-interactable-style == 'button' %}
                                        padding: {{ section.settings.cta-padding-top-mobile }}px {{ section.settings.cta-padding-right-mobile }}px {{ section.settings.cta-padding-bottom-mobile }}px {{ section.settings.cta-padding-left-mobile }}px;
                                    {% endif %}
                                }
                            }
                            @media screen and (min-width: 769px) {
                                .promo-cta-{{ block.id }} {
                                    font-size: {{ section.settings.cta-font-size-desktop }}px;
                                }
                            }
                        </style>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}

    {% if is_global_link %}
        </a>
    {% else %}
        </div>
    {% endif %}
{% endif %}

