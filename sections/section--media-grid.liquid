{% comment %}
  ==================================================================
  MEDIA GRID (theme-block version)
  Replaces sections/media-grid--deprecated.liquid, and since 2026-09-22
  also images-grid, section--stories-single-image and
  multicolumn-with-content-hover (all renamed --deprecated).
  ==================================================================
  A heading over a grid or carousel of image/video tiles. Tiles are
  block--media-tile THEME BLOCKS whose content is their own child
  blocks (block--heading, block--text, block--button, app blocks), so a
  tile carries any number of lines.

  ------------------------------------------------------------------
  SETTINGS MODEL
  ------------------------------------------------------------------
  Section: layout (grid | carousel), columns (desktop 1-6, mobile 1-4),
  tile height (fixed row heights, or the image's natural / square /
  portrait / landscape ratio), tile width for centred rows of small
  tiles, gap, where the content sits (over the image or below it),
  an optional card background and padding, shadow, hover reveal,
  circle-badge headings, a heading, the tile colours that apply to
  every tile when content is over the image, colour scheme and Dawn's
  padding pair.
  Tiles (block--media-tile): media or a collection (which supplies the
  image, title and link unless overridden), link, span, position,
  alignment, overlay colour/opacity and what the overlay does on hover,
  and text revealed on hover.
  Child blocks: content plus optional per-block overrides.

  ------------------------------------------------------------------
  WHAT THE FOUR OLD SECTIONS MAPPED TO
  ------------------------------------------------------------------
  - images-grid (28 instances): layout carousel/grid, tile ratio from
    the image, content below the image, a collection picker per tile
    with the "current collection stays bright, the rest dim" behaviour
    (the tile carries .is-current; the CSS dims its siblings with
    :has(), so the test lives in one place, blocks/block--media-tile).
  - stories-single-image (About history): carousel, fixed 600/300px
    tiles, 60% scrim lifted on hover, circle-badge year headings,
    description as the tile's hover text.
  - multicolumn-with-content-hover (homepage "About the brand"):
    carousel of square tiles, content below, description as hover text
    with the overlay shown only on hover.

  ------------------------------------------------------------------
  WHY THE CHILD BLOCK STYLES ARE RESTATED IN section--media-grid.css
  ------------------------------------------------------------------
  Shopify bundles every {% stylesheet %} into compiled_assets/styles.css
  and loads it BEFORE Dawn's base.css, so a block's own rules lose to
  Dawn's .h1-.h6 classes at equal specificity. The section stylesheet
  loads after base.css and scopes the same rules under .gs-media-grid,
  which is what makes the heading colour/size overrides and <strong>
  inside headings actually take effect. Headings inside tiles are
  weight 400 so bold from the rich text editor is visible (the theme's
  heading weight is 700, which made <strong> a no-op).

  The carousel is a native scroll-snap track driven by the shared
  gs-swatch-scroller.js (loaded once from layout/theme.liquid).
  ==================================================================
{% endcomment %}

{{ 'section--media-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign layout = s.layout | default: 'grid'
  assign ratio = s.tile_ratio | default: 'fixed'
  assign placement = s.content_placement | default: 'overlay'

-%}

<div
  class="gs-media-grid color-{{ s.color_scheme }} gradient gs-mg--visibility-{{ s.section_visibility | default: 'always' }} gs-mg--{{ layout }} gs-mg--ratio-{{ ratio }} gs-mg--{{ placement }} gs-mg--width-{{ s.tile_width | default: 'full' }}{% if s.heading_badge %} gs-mg--badge{% endif %}"
  style="
    --padding-top: {{ s.padding_top }}px;
    --padding-bottom: {{ s.padding_bottom }}px;
    --padding-top-mobile: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    --padding-bottom-mobile: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
    --cols-desktop: {{ s.columns_desktop | default: 4 }};
    --cols-mobile: {{ s.columns_mobile | default: 1 }};
    --desktopHeight: {{ s.desktop_row_height }}px;
    --mobileHeight: {{ s.mobile_row_height }}px;
    --columnGap: {{ s.mobile_grid_gap }}px;
    --columnGapDesktop: {{ s.desktop_grid_gap }}px;
    --mg-card-pad: {{ s.card_padding | default: 0 }}px;
    {%- unless s.card_background == blank or s.card_background == 'rgba(0,0,0,0)' %}
    --mg-card-bg: {{ s.card_background }};
    {%- endunless %}
    {%- if placement == 'overlay' %}
    --mg-heading: {{ s.heading_color | default: '#ffffff' }};
    --mg-text: {{ s.text_color | default: '#ffffff' }};
    --mg-btn-bg: {{ s.btn_bg_color | default: '#ffffff' }};
    --mg-btn-text: {{ s.btn_text_color | default: '#000000' }};
    --mg-btn-bg-hover: {{ s.btn_hover_color | default: '#000000' }};
    --mg-btn-text-hover: {{ s.btn_hover_text_color | default: '#ffffff' }};
    {%- endif %}
  "
>
  <div class="{% if s.section_width %}gs-mg--fullwidth{% else %}page-width{% endif %}">
    {%- if s.heading != blank -%}
      <div class="section-title {{ s.heading_alignment | default: 'text-center' }}">
        <h2 class="mg-heading inline-richtext {{ s.heading_size | default: 'h3' }}">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- comment -%}
        One track for both layouts: content_for 'blocks' may appear only
        once. The carousel adds the scroller attributes and arrows.
      {%- endcomment -%}
      <div class="gs-mg__scroller"{% if layout == 'carousel' %} data-swatch-scroller{% endif %}>
        {%- if layout == 'carousel' -%}
          <button
            type="button"
            class="gs-mg__nav"
            data-swatch-scroll="prev"
            aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous' }}"
            hidden
          >
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
        <div
          class="media-grid-wrapper{% if layout == 'carousel' %} media-grid-wrapper--carousel{% endif %}{% if s.enable_shadow %} shadow-enabled{% endif %}{% if s.enable_hover_content %} content-on-hover{% endif %}"
          {% if layout == 'carousel' %}data-swatch-track{% endif %}
        >
          {% content_for 'blocks' %}
        </div>
        {%- if layout == 'carousel' -%}
          <button
            type="button"
            class="gs-mg__nav"
            data-swatch-scroll="next"
            aria-label="{{ 'general.slider.next_slide' | t | default: 'Next' }}"
            hidden
          >
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Media grid",
  "tag": "section",
  "class": "gs-media-grid-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    { "type": "block--media-tile" }
  ],
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns_desktop", "label": "Tiles per row (desktop)", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Tiles per row (mobile)", "min": 1, "max": 4, "step": 1, "default": 1 },
    {
      "type": "select",
      "id": "tile_ratio",
      "label": "Tile height",
      "info": "Fixed uses the row heights below; the others follow the image.",
      "options": [
        { "value": "fixed", "label": "Fixed row height" },
        { "value": "adapt", "label": "Natural image height" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "fixed"
    },
    { "type": "range", "id": "desktop_row_height", "label": "Row height (desktop)", "min": 200, "max": 600, "step": 5, "unit": "px", "default": 400 },
    { "type": "range", "id": "mobile_row_height", "label": "Row height (mobile)", "min": 150, "max": 300, "step": 5, "unit": "px", "default": 200 },
    {
      "type": "select",
      "id": "tile_width",
      "label": "Tile width",
      "info": "Grid only. Smaller tiles sit centred in their slot.",
      "options": [
        { "value": "full", "label": "Full slot" },
        { "value": "three-quarter", "label": "Three quarters" },
        { "value": "half", "label": "Half" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "desktop_grid_gap", "label": "Gap (desktop)", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 5 },
    { "type": "range", "id": "mobile_grid_gap", "label": "Gap (mobile)", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 5 },
    { "type": "checkbox", "id": "section_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Show on",
      "options": [
        { "value": "always", "label": "All devices" },
        { "value": "small", "label": "Mobile only" },
        { "value": "large", "label": "Desktop only" }
      ],
      "default": "always"
    },

    { "type": "header", "content": "Tiles" },
    {
      "type": "select",
      "id": "content_placement",
      "label": "Tile content",
      "options": [
        { "value": "overlay", "label": "Over the image" },
        { "value": "below", "label": "Below the image" }
      ],
      "default": "overlay"
    },
    { "type": "color", "id": "card_background", "label": "Card background", "info": "Empty for no card." },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "checkbox", "id": "enable_shadow", "label": "Tile shadow", "default": false },
    { "type": "checkbox", "id": "enable_hover_content", "label": "Reveal content on hover", "default": false },
    { "type": "checkbox", "id": "heading_badge", "label": "Circle badge headings", "info": "Tile headings in a bordered circle, as on the About page timeline.", "default": false },

    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ],
      "default": "text-center"
    },

    { "type": "header", "content": "Tile colors", "info": "Apply to every tile when content is over the image. Below the image the colour scheme applies. A child block can override its own." },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "btn_bg_color", "label": "Button", "default": "#ffffff" },
    { "type": "color", "id": "btn_text_color", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "btn_hover_color", "label": "Button hover", "default": "#000000" },
    { "type": "color", "id": "btn_hover_text_color", "label": "Button hover text", "default": "#ffffff" },

    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [
    {
      "name": "Media grid",
      "settings": { "columns_desktop": 2 },
      "blocks": [
        {
          "type": "block--media-tile",
          "blocks": [ { "type": "block--heading", "settings": { "text": "<strong>First tile</strong>" } } ]
        },
        {
          "type": "block--media-tile",
          "blocks": [ { "type": "block--heading", "settings": { "text": "<strong>Second tile</strong>" } } ]
        }
      ]
    },
    {
      "name": "Image strip",
      "settings": { "layout": "carousel", "columns_desktop": 5, "columns_mobile": 2, "tile_ratio": "adapt", "content_placement": "below", "heading": "Image strip" },
      "blocks": [
        { "type": "block--media-tile" },
        { "type": "block--media-tile" },
        { "type": "block--media-tile" },
        { "type": "block--media-tile" },
        { "type": "block--media-tile" }
      ]
    }
  ]
}
{% endschema %}
