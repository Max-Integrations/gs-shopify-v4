{% comment %}
  Ported from gs-shopify-v3 sections/collection-carousel.liquid by scripts/port-section.py
  (2026-10 client review: "modules to carry over"). Schema labels are
  literal strings, colour schemes are Dawn's, and the v3 snippets this
  theme lacks are inlined so the section stays self-contained.
{% endcomment %}
{% liquid
  # Collection source: 'manual' uses the section blocks (default, unchanged behavior).
  # 'metafield' pulls the collections selected in the blog post's Promoted Collections metafield.
  assign use_metafield = false
  assign items = section.blocks
  if section.settings.collection_source == 'metafield'
    assign use_metafield = true
    assign items = article.metafields.blogpost.promoted_collections.value
  endif
  assign item_count = items.size
%}
{% unless use_metafield and item_count == 0 %}
{{ 'collection-carousel.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} section-padding{% if section.settings.enable_gradient %} gradiant{% endif %}">
  <div class="container-sm">
    {% if section.settings.heading != blank %}
      <div class="section-title {{ section.settings.heading_alignment }}" >
        {%- capture highlightPrefix -%}
          <span class="line-marker {% if section.settings.highlight_style == 'background' %}highlight-background {% if section.settings.bg__color == 'gradient' %}highlight-background-gradient{% else %}highlight-background-solid{% endif %}{% endif %}">
        {%- endcapture -%}
        {%- capture highlightSuffix -%}
        {% if section.settings.highlight_style != 'background' %}
          {% case section.settings.highlight_style %}
    {% when 'underline' %}
        <svg class="marker-svg marker-svg-syle-1" viewBox="0 0 296 4" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path d="M0 2H295.21" stroke="currentColor" stroke-width="4" />
         </svg>
            
