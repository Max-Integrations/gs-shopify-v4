  {% liquid
    assign is_current_collection_in_collection_carousel = false

    for item in items
      if use_metafield
        assign current_check_collection = item
      else
        assign current_check_collection = item.settings.collection
      endif
      if current_check_collection.url == request.path
        assign is_current_collection_in_collection_carousel = true
      endif
    endfor
  %}
    <div class="collection-carousel-wrapper {% if section.settings.enable_border %}border-enabled{% endif %} {% if item_count >5 and section.settings.carousel_type == 'carousel' %}slider-active {% endif %} pause-on-hover {{ section.settings.shape }} {% if section.settings.carousel_type == 'marquee'%}marquee-enable{% elsif section.settings.carousel_type == 'stacked' %}collection-stacked{% elsif section.settings.carousel_type == 'tiles' %}collection-stacked rounded-tiles{% else %}slider{% if section.settings.carousel_type == 'grid'%} grid{% endif %}{% endif %} {% if section.settings.shape == 'customshapes' %}shapes-enabled{% endif %}" 
     {% if item_count >5 and section.settings.carousel_type == 'carousel' %}   
       data-slideshow='
      {
      "cellAlign":"left",
      "contain": true,
      "pageDots": false,
      "draggable": true,
      "prevNextButtons": false,
      "wrapAround":true,
      "groupCells": true,
      "cellSelector":".collection-carousel-item"
      }'
      {% elsif section.settings.carousel_type == 'stacked' %} data-stacked {% else %}data-marquee data-marquee-speed="{{ section.settings.scrolling_speed }}"
      data-marquee-speed-mobile="{{ section.settings.scrolling_speed_mobile }}"{% endif %}
      {% if is_current_collection_in_collection_carousel %}current-collection-in-collection-carousel{% endif %}
    >
      {%liquid
        assign imageSize = 200
        if section.settings.carousel_type == 'stacked'
        assign imageSize = 90
        endif
        if section.settings.carousel_type == 'marquee'
          assign limit = 3 
          if item_count <= 2
            assign limit = 10 
          elsif item_count <= 4
            assign limit = 4
          endif 
        else
          assign limit=1
        endif 
      %}
        {% for i in (1..limit) %}
          {% if section.settings.carousel_type == 'marquee' %}
            <div class="collection-carousel-marquee {{ section.settings.direction }}" data-marque-node>
          {% endif %}
          {% assign animationDelay = 500 %}
          {% for item in items %}
            {%-liquid
                assign imageContent = ''
                assign collectionproductscount=0
                assign collection = ''

                # Normalize block vs metafield-collection into shared vars so the markup below is source-agnostic.
                if use_metafield
                  assign collection = item
                  assign block_image = blank
                  assign block_heading = blank
                  assign block_id = 'mf-' | append: forloop.index
                else
                  assign collection = item.settings.collection
                  assign block_image = item.settings.image
                  assign block_heading = item.settings.collection_heading
                  assign block_id = item.id
                endif

                if block_image != blank
                  assign imageContent = block_image
                elsif collection.featured_image
                  assign imageContent = collection.featured_image
                endif
                if section.settings.image_style == 'landscape'
                  assign tileImgRatio = 75 
                elsif section.settings.image_style == 'square'
                  assign tileImgRatio = 100 
                elsif section.settings.image_style == 'portrait'
                  assign tileImgRatio = 125
                else
                  if imageContent != blank
                    assign tileImgRatio = 1 | divided_by: imageContent.aspect_ratio | times: 100
                  else
                    assign tileImgRatio = 100 
                  endif                  
                endif
                unless section.settings.shape == 'customshapes'
                  if section.settings.carousel_type == 'tiles'
                  assign imageRatio = tileImgRatio
                  else
                    assign imageRatio = 100 
                  endif
                else
                  assign imageRatio = 100 
                endunless
               if collection != blank
               assign collectionproductscount = collection.all_products_count
                if collection.all_products_count > 99
                assign collectionproductscount = "99+"
                endif
               endif 
               assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1
               assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index
            -%}
            {% capture collection_product_count%}
              {% if  collection != blank  and section.settings.product_count and collection.all_products_count > 0 %}
                <sup class="collection-item-count">{{ collectionproductscount }} 
                  {% if section.settings.carousel_type == 'stacked' or section.settings.carousel_type == 'tiles' %}
                    {% if collection.all_products_count == 1 %}
                      {{'sections.collection_carousel.item' | t }}
                    {% elsif collection.all_products_count > 1 %}
                      {{'sections.collection_carousel.items' | t }}
                    {% endif %}
                  {% endif %} 
               </sup>
              {% endif %}
            {% endcapture %}
            {% liquid
              if section.settings.carousel_type == 'tiles'
              assign animationDelay = animationDelay | plus:100
              endif
            %}
            <div class="collection-carousel-item{% if section.settings.carousel_type == 'carousel' or section.settings.carousel_type == 'marquee' %} hover-effect{% endif %}{% if section.settings.title_on_hover %} title-on-hover{% endif %}{% if collection.url == request.path %} selected-collection{% endif %}" {% unless use_metafield %} {{ item.shopify_attributes }}{% endunless %} id="collection-carousel-item-{{ block_id }}"{% if section.settings.carousel_type == 'tiles' %} {% if false %}data-aos="fade-up" data-aos-duration="{{ animationDelay }}" {%  endif%}{% endif %}>
              <a class="collection-carousel-image" aria-label="{%- if block_heading != blank -%}{{ block_heading -}}{%- elsif collection != blank -%}{{- collection.title | strip_html -}}{%- else -%}{{- 'sections.collection_carousel.collection' | t  -}}{%- endif %} "
                {% if collection.url == blank %}role="link"aria-disabled="true"{% else %}href="{{ collection.url | default : '#' }}"{% endif %}{% if section.settings.carousel_type != 'tiles' %} {% endif %}>
