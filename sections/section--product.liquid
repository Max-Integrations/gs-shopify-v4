{% comment %}
  ==================================================================
  PRODUCT
  Replaces sections/main-product.liquid (renamed deprecated--main-product)
  ==================================================================
  The product band: breadcrumb, media gallery, and the buy box. Matches
  the v3 PDP layout (gallery left with a thumbnail rail, buy box right
  and sticky on desktop; stacked on mobile with a fixed add-to-cart bar).

  ------------------------------------------------------------------
  THEME BLOCKS, BECAUSE OF THE APPS
  ------------------------------------------------------------------
  Four apps put blocks in this buy box: Klaviyo (average rating), Skio
  (subscription plan picker), Wishlist Plus, and Loop/Wonderment
  (delivery ETA). A section may accept `@app` blocks ALONGSIDE theme
  blocks, but it may not mix `@app` with locally defined blocks. So
  every buy-box element is a theme block in blocks/, and the generic
  block--heading / block--text / block--button work here too.

  v3 put 37 block types in one section and dispatched them from a
  968-line snippet. This carries 12, and the messaging, badge and
  gating blocks each absorb a family of v3 types. See the plan in
  docs/ for the full mapping.

  ------------------------------------------------------------------
  GATING (v3's pdp-overrides.liquid, 94 lines of hardcoded rules)
  ------------------------------------------------------------------
  v3 hardcoded ten business rules that hide the variant picker,
  quantity and add-to-cart for club products, early access, licensed
  branch products and so on. Here each block--product-message carries
  its own condition and an optional "hide buy controls" flag. A block
  whose condition matches and has the flag emits one <style> rule that
  hides everything carrying .gs-product__gated (picker, quantity, add
  to cart, and the sticky bar). That is exactly what v3's snippet did,
  minus the hardcoding. A new rule is a new block, not new code.

  THE SECTION CANNOT READ ITS THEME BLOCKS. Verified on the dev theme
  2026-09-29: section.blocks reports every theme block as type
  "@theme" with no settings, so a "section reads the blocks and
  decides" pass never matches. Anything a block knows, the block must
  act on itself. Do not reintroduce a section-side pass.

  ------------------------------------------------------------------
  THREE CONSTRAINTS THAT SHAPE THIS FILE
  ------------------------------------------------------------------
  1. Theme blocks render only through {% content_for 'blocks' %}, all
     of them, in merchant order, in one place. They cannot be rendered
     individually and cannot be passed variables.
  2. So the badge, which belongs over the GALLERY and not in the buy
     box, cannot be rendered where it is placed. block--product-badge
     renders its <img data-gs-badge> in the buy box (hidden there by
     CSS) when the product carries its tag, and gs-product.js moves
     the first one into .gs-product__media and drops the rest, so the
     first matching block wins, as v3's pdp-gs-badge did. The
     custom.product_image_badge_override metafield is product-level,
     so this section renders that one directly and it takes priority.
  3. The form id must be shared between the buy-buttons block (which
     owns the <form>) and the variant picker, which sits outside it and
     joins by the form= attribute. Blocks cannot see section.id, so
     each derives the same id from the product: ProductForm-<id>. One
     product section per page, so it is unique. Nothing in this file
     needs it.

  ------------------------------------------------------------------
  STRUCTURED DATA
  ------------------------------------------------------------------
  Neither v3 nor the previous v4 section emitted any. Dawn does, and
  Google reads it for rich results, so the Product JSON-LD is here.
  ==================================================================
{% endcomment %}

{{ 'gs-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gs-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings

  # Badge from the product-level override metafield. Tag-matched badges
  # are rendered by block--product-badge itself and moved over the
  # gallery by gs-product.js (see the comment block above).
  assign badge_image = product.metafields.custom.product_image_badge_override
  assign badge_position = 'top-right'
-%}

<div
  class="gs-product color-{{ s.color_scheme }} gradient gs-product--ratio-{{ s.media_ratio | default: 'square' }}{% if s.sticky_media %} gs-product--sticky{% endif %}"
  style="--gs-product-pad-top: {{ s.padding_top }}px; --gs-product-pad-bottom: {{ s.padding_bottom }}px;"
  id="GsProduct-{{ section.id }}"
  data-gs-product
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-url="{{ product.url }}"
>
  <div class="page-width">
    {%- if s.show_breadcrumb -%}
      <nav class="gs-product__breadcrumb" aria-label="Breadcrumbs">
        <ol>
          <li><a href="{{ routes.root_url }}">Home</a></li>
          {%- comment -%}
            v3 shows Home / All Products / <type> / <product>, using the
            collection the customer arrived through in place of "All
            Products" when there is one. v3 also restored that
            collection from a localStorage value written on collection
            pages; that is a cross-page side effect for one crumb, so it
            is not carried over.
          {%- endcomment -%}
          {%- if collection != blank and collection.handle != 'all' -%}
            <li><a href="{{ collection.url }}">{{ collection.title | strip_html | truncatewords: 5 }}</a></li>
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
          {%- endif -%}
          {%- if product.type != blank -%}
            <li>{{ product.type | link_to_type }}</li>
          {%- endif -%}
          <li aria-current="page">{{ product.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="gs-product__grid">
      {%- comment -%}
        ---------------- Media ----------------
        Matches the live v3 gallery: a vertical thumbnail rail on the
        left with a chevron at each end, the main image to its right
        with circular prev/next arrows overlaid, a zoom control top
        left and the badge top right. The whole column sticks while
        the (much taller) buy box scrolls past it.

        On mobile the rail drops below the image and runs horizontally,
        and the gallery is swiped rather than arrowed.
      {%- endcomment -%}
      <div class="gs-product__media">
        <div class="gs-product__media-sticky">
          <div class="gs-product__media-inner">
            {%- if product.media.size > 1 -%}
              <div class="gs-product__rail">
                <button type="button" class="gs-product__rail-btn" data-gs-rail="up" aria-label="Previous images">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 15 L12 7 L20 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="gs-product__thumbs" data-gs-thumbs>
                  {%- for media in product.media -%}
                    <a
                      class="gs-product__thumb{% if forloop.first %} is-active{% endif %}"
                      href="#GsMedia-{{ section.id }}-{{ media.id }}"
                      data-thumb-for="{{ media.id }}"
                      aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
                    >
                      <img
                        src="{{ media.preview_image | image_url: width: 220 }}"
                        srcset="{{ media.preview_image | image_url: width: 110 }} 110w, {{ media.preview_image | image_url: width: 220 }} 220w"
                        sizes="110px"
                        alt=""
                        width="110"
                        height="110"
                        loading="lazy"
                      >
                    </a>
                  {%- endfor -%}
                </div>
                <button type="button" class="gs-product__rail-btn" data-gs-rail="down" aria-label="More images">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 9 L12 17 L20 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            {%- endif -%}

            <div class="gs-product__stage">
              {%- if badge_image != blank -%}
                <img
                  class="gs-product__badge gs-product__badge--{{ badge_position }}"
                  src="{{ badge_image | image_url: width: 200 }}"
                  srcset="{{ badge_image | image_url: width: 100 }} 100w, {{ badge_image | image_url: width: 200 }} 200w"
                  sizes="100px"
                  alt=""
                  width="100"
                  height="100"
                  loading="lazy"
                >
              {%- endif -%}

              {%- if product.media.size > 0 -%}
                <button type="button" class="gs-product__zoom-btn" data-gs-zoom-current aria-label="Zoom">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              {%- endif -%}

              <div class="gs-product__gallery" data-gs-gallery>
                {%- if product.media.size > 0 -%}
                  {%- for media in product.media -%}
                    <div
                      class="gs-product__slide"
                      id="GsMedia-{{ section.id }}-{{ media.id }}"
                      data-media-id="{{ media.id }}"
                    >
                      {%- case media.media_type -%}
                        {%- when 'image' -%}
                          <button
                            type="button"
                            class="gs-product__zoom-open"
                            data-gs-zoom="{{ forloop.index0 }}"
                            aria-label="{{ 'products.product.media.open_media' | t: index: forloop.index | default: 'Open media' }}"
                          >
                            <img
                              src="{{ media | image_url: width: 1200 }}"
                              srcset="
                                {{ media | image_url: width: 600 }} 600w,
                                {{ media | image_url: width: 900 }} 900w,
                                {{ media | image_url: width: 1200 }} 1200w,
                                {{ media | image_url: width: 1800 }} 1800w
                              "
                              sizes="(min-width: 990px) 50vw, 100vw"
                              alt="{{ media.alt | escape }}"
                              width="{{ media.width }}"
                              height="{{ media.height }}"
                              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                            >
                          </button>
                        {%- else -%}
                          {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
                      {%- endcase -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="gs-product__slide">
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if product.media.size > 1 -%}
                <button type="button" class="gs-product__nav gs-product__nav--prev" data-gs-nav="prev" aria-label="Previous image">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button type="button" class="gs-product__nav gs-product__nav--next" data-gs-nav="next" aria-label="Next image">
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ---------------- Buy box ---------------- {%- endcomment -%}
      <div class="gs-product__info">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>

  {%- comment -%}
    Zoom: one dialog listing every image at full size, opened at the
    slide that was tapped. Dawn's product-modal does the same thing
    with a custom element; this is a native <dialog> and the same
    open/close wiring the size guide and store locator use.
  {%- endcomment -%}
  {%- if product.media.size > 0 -%}
    <dialog class="gs-product__dialog gs-product__dialog--zoom" id="GsZoom-{{ section.id }}" data-gs-zoom-dialog aria-label="Product images">
      <div class="gs-product__dialog-box gs-product__zoom-box">
        <button type="button" class="gs-product__dialog-close" data-gs-dialog-close aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5"/></svg>
        </button>
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <img
              class="gs-product__zoom-image"
              data-zoom-index="{{ forloop.index0 }}"
              src="{{ media | image_url: width: 1800 }}"
              srcset="{{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 990px) 900px, 100vw"
              alt="{{ media.alt | escape }}"
              width="{{ media.width }}"
              height="{{ media.height }}"
              loading="lazy"
            >
          {%- endif -%}
        {%- endfor -%}
      </div>
    </dialog>
  {%- endif -%}

  {%- comment -%}
    Sticky add to cart (mobile). v3 duplicated the whole variant picker
    in its bar and synced the two; this bar holds image, title, price
    and ONE button that submits the real form through form=, the same
    attribute the option radios use. gs-product.js shows it when the
    real button scrolls out of view and mirrors the button state. It
    carries .gs-product__gated so a gating message hides it too.
  {%- endcomment -%}
  {%- if s.sticky_atc -%}
    {%- liquid
      assign sv = product.selected_or_first_available_variant
      assign sticky_media = sv.featured_media | default: product.featured_media
    -%}
    <div class="gs-product__sticky gs-product__gated" data-gs-atc-bar hidden>
      <div class="gs-product__sticky-media">
        {%- if sticky_media != blank -%}
          <img src="{{ sticky_media | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy" data-gs-atc-image>
        {%- endif -%}
      </div>
      <div class="gs-product__sticky-info">
        <p class="gs-product__sticky-title">{{ product.title }}</p>
        <p class="gs-product__sticky-price" data-gs-atc-price>{{ sv.price | money }}</p>
      </div>
      <button
        type="submit"
        form="ProductForm-{{ product.id }}"
        class="button gs-product__sticky-submit"
        data-gs-atc-submit
        {% unless sv.available %}aria-disabled="true"{% endunless %}
      >
        {%- if sv.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- comment -%}
    Variant data for the client. Prices are included so the price can
    update without a section fetch (v4's old section re-render was a
    no-op for price because gs-price read product.price_min).

    Money is pre-formatted BY LIQUID here rather than formatted in
    JavaScript. window.Shopify.money_format is not defined on this
    store, so any JS formatter is guessing at the shop's format and
    will drift from every price Liquid renders elsewhere.
  {%- endcomment -%}
  <script type="application/json" data-gs-variants>
    [
      {%- for v in product.variants -%}
        {
          "id": {{ v.id }},
          "options": {{ v.options | json }},
          "available": {{ v.available }},
          "price": {{ v.price }},
          "compare_at_price": {{ v.compare_at_price | default: 0 }},
          "price_money": {{ v.price | money | json }},
          "compare_money": {{ v.compare_at_price | default: 0 | money | json }},
          "saving_money": {{ v.compare_at_price | default: 0 | minus: v.price | money | json }},
          "media": {{ v.featured_media.id | default: 0 }},
          "sku": {{ v.sku | default: '' | json }},
          "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
          "inventory_policy": {{ v.inventory_policy | default: 'deny' | json }},
          "tracked": {% if v.inventory_management == blank %}false{% else %}true{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  {%- comment -%} Rich results. Neither v3 nor the old v4 section had this. {%- endcomment -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "gs-product-section",
  "enabled_on": { "templates": ["product"] },
  "blocks": [
    { "type": "block--product-title" },
    { "type": "block--product-price" },
    { "type": "block--product-variant-picker" },
    { "type": "block--product-buy-buttons" },
    { "type": "block--product-swatches" },
    { "type": "block--product-message" },
    { "type": "block--product-badge" },
    { "type": "block--product-accordion" },
    { "type": "block--product-value-props" },
    { "type": "block--product-store-locator" },
    { "type": "block--product-complementary" },
    { "type": "block--product-countdown" },
    { "type": "block--product-inventory" },
    { "type": "block--product-icon-text" },
    { "type": "block--product-fomo" },
    { "type": "block--custom-liquid" },
    { "type": "block--heading" },
    { "type": "block--text" },
    { "type": "block--button" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "checkbox", "id": "sticky_media", "label": "Keep the gallery in view while scrolling", "info": "Desktop only.", "default": true },
    { "type": "checkbox", "id": "sticky_atc", "label": "Sticky add to cart bar", "info": "Mobile only, as on the live site.", "default": true },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "block--product-title" },
        { "type": "block--product-price" },
        { "type": "block--product-variant-picker" },
        { "type": "block--product-buy-buttons" }
      ]
    }
  ]
}
{% endschema %}
