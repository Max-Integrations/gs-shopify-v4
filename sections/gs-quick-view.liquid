{% comment %}
  ==================================================================
  GS QUICK VIEW
  ==================================================================
  A compact product view, fetched into a dialog from a product card.

  NOT PORTED FROM v3. v3's product-quick-view.liquid depends on globals
  from its 283 KB theme.js. This is fetched with the Section Rendering
  API instead:

      /products/{handle}?section_id=gs-quick-view

  which renders this section in that product's context. No client-side
  product templating, so price and availability have one source of truth.

  ------------------------------------------------------------------
  WHY THE CARD BUTTON IS STILL A LINK
  ------------------------------------------------------------------
  The card's QUICK VIEW is a real <a href> to the product page.
  gs-quick-view.js intercepts the click and opens this instead. With
  JavaScript off, or if the fetch fails, the link navigates normally -
  the customer always reaches the product.

  ------------------------------------------------------------------
  VARIANT SELECTION
  ------------------------------------------------------------------
  Radio inputs, same pattern as the PDP. Selecting a variant updates the
  hidden id and the price without another round trip, using a minimal
  variant map - id, options, available, price - not the whole object.

  Add to cart posts to /cart/add.js and opens Dawn's cart drawer.
  ==================================================================
{% endcomment %}

{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'GsQuickViewForm-' | append: product.id
-%}

<div class="gs-qv" data-quick-view-content data-product-url="{{ product.url }}">
  {%- comment -%}
    Inside the content node on purpose: gs-quick-view.js keeps only
    [data-quick-view-content] from the fetched markup, so a stylesheet
    outside it never reached the page. The card that opens the dialog
    loads the same file too (gs-card-product), so the shell is styled
    before the fetch returns.
  {%- endcomment -%}
  {{ 'gs-quick-view.css' | asset_url | stylesheet_tag }}
  <div class="gs-qv__media">
    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 800 }}"
        srcset="{{ product.featured_media | image_url: width: 500 }} 500w, {{ product.featured_media | image_url: width: 800 }} 800w"
        sizes="(min-width: 750px) 40vw, 90vw"
        alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
        width="{{ product.featured_media.width }}"
        height="{{ product.featured_media.height }}"
      >
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="gs-qv__info">
    {%- comment -%}
      No vendor line: on this store the vendor field holds internal
      groupings ("presale", "Womens Tees") that mean nothing to the
      customer (2026-10 client review).
    {%- endcomment -%}
    <h2 class="gs-qv__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h2>

    {%- render 'gs-reviews', cardProduct: product, showCount: true -%}

    <div class="gs-qv__price" data-qv-price>
      {%- render 'gs-price', cardProduct: product, cardVariant: current, useVariantPrice: true -%}
    </div>

    {%- unless product.has_only_default_variant -%}
      <div class="gs-qv__options">
        {%- for option in product.options_with_values -%}
          <fieldset class="gs-qv__option">
            <legend class="gs-qv__option-name">
              {{ option.name }}
              <span data-qv-selected="{{ option.position }}">{{ option.selected_value }}</span>
            </legend>
            {%- liquid
              # Size pills show letter codes (S, M, L, XL, 2XL...) with the
              # full value kept on the radio, the legend and the title
              # attribute. Any value not in the map ("One Size", "32x30")
              # and any non-size option print unchanged.
              assign option_name_lc = option.name | downcase
              assign is_size_option = false
              if option_name_lc contains 'size'
                assign is_size_option = true
              endif
            -%}
            <div class="gs-qv__option-values">
              {%- for value in option.values -%}
                {%- assign input_id = 'GsQvOption-' | append: product.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                {%- liquid
                  assign short_value = value
                  if is_size_option
                    assign size_key = value | downcase | remove: ' ' | remove: '-' | remove: '_'
                    case size_key
                      when 'xxsmall', '2xsmall', 'xxs', '2xs'
                        assign short_value = '2XS'
                      when 'xsmall', 'extrasmall', 'xs'
                        assign short_value = 'XS'
                      when 'small', 's'
                        assign short_value = 'S'
                      when 'medium', 'm'
                        assign short_value = 'M'
                      when 'large', 'l'
                        assign short_value = 'L'
                      when 'xlarge', 'extralarge', 'xl'
                        assign short_value = 'XL'
                      when 'xxlarge', '2xlarge', 'xxl', '2xl'
                        assign short_value = '2XL'
                      when 'xxxlarge', '3xlarge', 'xxxl', '3xl'
                        assign short_value = '3XL'
                      when 'xxxxlarge', '4xlarge', 'xxxxl', '4xl'
                        assign short_value = '4XL'
                      when '5xlarge', '5xl'
                        assign short_value = '5XL'
                      when '6xlarge', '6xl'
                        assign short_value = '6XL'
                    endcase
                  endif
                -%}
                <input
                  type="radio"
                  class="gs-qv__option-input"
                  id="{{ input_id }}"
                  name="qv-{{ option.name | escape }}-{{ option.position }}"
                  value="{{ value | escape }}"
                  {% if option.selected_value == value %}checked{% endif %}
                  data-qv-option
                >
                <label
                  class="gs-qv__option-label{% unless value.available %} is-unavailable{% endunless %}"
                  for="{{ input_id }}"
                  title="{{ value | escape }}"
                >
                  {{- short_value -}}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    {%- comment -%}
      Shipping line: the product-level PreOrder Message metafield the PDP
      shows ("This Item is Ready To Ship."), or the theme-setting fallback
      when the product has none. The delivery-date estimate on the PDP is
      the Track by Loop app block, which cannot render in a standalone
      section, so it is not repeated here.
    {%- endcomment -%}
    {%- liquid
      assign ship_msg = product.metafields.custom.limited_custom_product_message.value | strip_html | strip
      if ship_msg == blank
        assign ship_msg = settings.quickview_shipping_fallback | strip
      endif
    -%}
    {%- if ship_msg != blank -%}
      <p class="gs-qv__shipping" data-qv-shipping>{{ ship_msg | escape }}</p>
    {%- endif -%}

    {%- form 'product', product, id: form_id, class: 'gs-qv__form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-qv-variant-id>
      <input type="hidden" name="quantity" value="1">

      <button
        type="submit"
        name="add"
        class="gs-qv__submit"
        data-qv-submit
        {% unless current.available %}disabled{% endunless %}
      >
        <span data-qv-submit-text>
          {%- if current.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    {%- endform -%}

    <p class="gs-qv__error" role="alert" hidden data-qv-error></p>

    <a class="gs-qv__full-link" href="{{ product.url }}">
      {{ 'products.product.view_full_details' | t }}
    </a>
  </div>

  {%- comment -%}
    Minimal variant map - four fields, not the whole object. Same
    approach as the PDP.
  {%- endcomment -%}
  <script type="application/json" data-qv-variants>
[
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "options": {{ variant.options | json }},
      "available": {{ variant.available }},
      "price": {{ variant.price | json }},
      "compare": {% if variant.compare_at_price %}{{ variant.compare_at_price | json }}{% else %}null{% endif %}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
  </script>
</div>

{% schema %}
{
  "name": "Quick view",
  "settings": []
}
{% endschema %}
