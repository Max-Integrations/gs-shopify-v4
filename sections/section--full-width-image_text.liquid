{% comment %}
  ==================================================================
  FULL WIDTH IMAGE & TEXT
  ==================================================================
  A full-width banner: background colour or image (desktop and mobile
  files), an optional whole-banner link, and message lines and buttons
  laid out stacked, or text one side and CTA the other.

  THEME BLOCKS (2026-09-22): the content is block--message-line and
  block--button theme blocks, so the button is the same block used
  everywhere in the theme. The old local blocks' settings map onto them
  one for one (sizes in px instead of a rem scale, 1rem = 10px here).
  Row layouts used to wrap messages and buttons in two groups; with
  content_for there are no wrappers, so the stylesheet does the grouping:
  stacked layouts are a wrapping flex row where every message line takes
  a full row and consecutive buttons share one; the text-left/right
  layouts are a grid with a `1fr` text column and spare auto columns the
  buttons flow into (theme blocks cannot be counted from the section).

  2026-10-13 (client request): buttons side by side was not working, and
  mobile had no settings of its own. Layout position and alignment now
  exist per breakpoint (layout_preset / alignment_preset are desktop,
  layout_preset_mobile / alignment_mobile are mobile), plus "Buttons
  (desktop)" / "Buttons (mobile)" (side by side or stacked). The
  stylesheet keys off `layout-desktop-*` / `layout-mobile-*` classes.
  ==================================================================
{% endcomment %}
{%- liquid
    assign desktop_img = section.settings.background_image_desktop | default: section.settings.background_image_mobile
    assign mobile_img = section.settings.background_image_mobile | default: section.settings.background_image_desktop

    assign auto_height = false
    if section.settings.image_height_auto and desktop_img != blank
        assign auto_height = true
    endif

    # Theme blocks are opaque to the section: block.type is '@theme' and
    # block.settings is empty here, so nothing about the lines or buttons
    # (count, text) can be read. The stretched link therefore gets a
    # generic accessible name, and the stylesheet groups buttons without
    # knowing how many there are.
    assign banner_label = 'View promotion'

    # Desktop and mobile each have their own layout position; the
    # alignment selects only matter for the stacked position.
    assign layout_desktop = section.settings.layout_preset | default: 'center'
    assign layout_mobile = section.settings.layout_preset_mobile | default: 'center'
    assign content_align = section.settings.alignment_preset | default: 'center'
    assign content_align_mobile = section.settings.alignment_mobile | default: 'center'

    # LCP: first two sections load eagerly and preload their CSS/image
    assign is_lcp = false
    assign fetch_priority = 'auto'
    assign loading_strategy = 'lazy'
    if section.index <= 2
        assign is_lcp = true
        assign fetch_priority = 'high'
        assign loading_strategy = 'eager'
    endif
-%}

{{ 'section--full-width-image_text.css' | asset_url | stylesheet_tag: preload: is_lcp }}

<div
    class="fwit-promo layout-desktop-{{ layout_desktop }} layout-mobile-{{ layout_mobile }} visibility-{{ section.settings.visibility }} buttons-desktop-{{ section.settings.buttons_desktop | default: 'side_by_side' }} buttons-mobile-{{ section.settings.buttons_mobile | default: 'stacked' }}{% if auto_height %} image-auto-height{% endif %}"
    style="
        --section-background: {{ section.settings.background_color }};
        --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
        --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
        --section-padding-x-desktop: {{ section.settings.padding_horizontal_desktop }}px;
        --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
        --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        --section-padding-x-mobile: {{ section.settings.padding_horizontal_mobile }}px;
        --item-gap-desktop: {{ section.settings.item_gap_desktop }}px;
        --item-gap-mobile: {{ section.settings.item_gap_mobile }}px;
        --button-gap: {{ section.settings.button_gap }}px;
        --content-align: {{ content_align }};
        --content-align-mobile: {{ content_align_mobile }};
    "
>
    {% if section.settings.banner_link != blank %}
        <a href="{{ section.settings.banner_link }}" class="promo-stretched-link" {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <span class="visually-hidden">{{ banner_label }}</span>
        </a>
    {% endif %}

    {% if desktop_img != blank %}
        <picture class="promo-bg-picture">
            {% if mobile_img != blank %}
                <source
                    media="(max-width: 768px)"
                    srcset="{{ mobile_img | image_url: width: 1200 }}"
                    width="{{ mobile_img.width }}"
                    height="{{ mobile_img.height }}">
            {% endif %}
            {{
                desktop_img
                | image_url: width: 2000
                | image_tag:
                    alt: desktop_img.alt,
                    width: desktop_img.width,
                    height: desktop_img.height,
                    widths: '600, 900, 1200, 1500, 2000',
                    sizes: '100vw',
                    loading: loading_strategy,
                    fetchpriority: fetch_priority,
                    preload: is_lcp 
            }}
        </picture>
    {% endif %}

    {%- if section.settings.overlay_opacity > 0 and desktop_img != blank -%}
        {%- comment -%}
            v3's overlay (overlay_color / overlay_opacity): a tint between
            the image and the copy so white text reads on a busy photo.
        {%- endcomment -%}
        {%- assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0 -%}
        {%- assign overlay_base = section.settings.overlay_color | default: '#000000' -%}
        <div class="promo-overlay" style="background-color: {{ overlay_base | color_modify: 'alpha', overlay_alpha }};" aria-hidden="true"></div>
    {%- endif -%}

    <div class="promo-content">
        {%- comment -%}
            Theme blocks render in the order the merchant placed them. The
            "text left / CTA right" layouts are a two-column grid in the
            stylesheet (message lines in one column, buttons in the other),
            which replaces the group wrappers the old local blocks needed.
        {%- endcomment -%}
        {% content_for 'blocks' %}
    </div>
</div>

{% schema %}
{
    "name": "Sale Promo Message",
    "class": "promotional-message-sale",
    "settings": [
        {
            "type": "header",
            "content": "Layout & Visibility"
        },
        {
            "type": "select",
            "id": "visibility",
            "label": "Visibility",
            "options": [
                { "label": "Desktop and Mobile", "value": "always" },
                { "label": "Mobile Only", "value": "small" },
                { "label": "Desktop Only", "value": "large" }
            ],
            "default": "always"
        },
        {
            "type": "select",
            "id": "layout_preset",
            "label": "Layout position (desktop)",
            "options": [
                { "label": "Stacked vertically in order", "value": "center" },
                { "label": "Text left, CTA right", "value": "left" },
                { "label": "Text right, CTA left", "value": "right" }
            ],
            "default": "center"
        },
        {
            "type": "select",
            "id": "alignment_preset",
            "label": "Layout alignment (desktop)",
            "options": [
                { "label": "Left", "value": "start" },
                { "label": "Center", "value": "center" },
                { "label": "Right", "value": "end" }
            ],
            "default": "center",
            "visible_if": "{{ section.settings.layout_preset == 'center' }}"
        },
        {
            "type": "select",
            "id": "layout_preset_mobile",
            "label": "Layout position (mobile)",
            "options": [
                { "label": "Stacked vertically in order", "value": "center" },
                { "label": "Text left, CTA right", "value": "left" },
                { "label": "Text right, CTA left", "value": "right" }
            ],
            "default": "center"
        },
        {
            "type": "select",
            "id": "alignment_mobile",
            "label": "Layout alignment (mobile)",
            "options": [
                { "label": "Left", "value": "start" },
                { "label": "Center", "value": "center" },
                { "label": "Right", "value": "end" }
            ],
            "default": "center",
            "visible_if": "{{ section.settings.layout_preset_mobile == 'center' }}"
        },
        {
            "type": "header",
            "content": "Background & Banner Link"
        },
        {
            "type": "color_background",
            "id": "background_color",
            "label": "Background color/gradient",
            "default": "#5D5D39"
        },
        {
            "type": "image_picker",
            "id": "background_image_desktop",
            "label": "Background image (Desktop)"
        },
        {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Background image (Mobile)"
        },
        {
            "type": "checkbox",
            "id": "image_height_auto",
            "label": "Auto image height",
            "default": true,
            "info": "On: the image runs edge to edge and sets the section height. Off: the height comes from the padding settings and the image is cover-cropped behind the content."
        },
        { "type": "color", "id": "overlay_color", "label": "Image overlay color", "default": "#000000" },
        { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "info": "A tint between the image and the text. 0 is off.", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
        {
            "type": "url",
            "id": "banner_link",
            "label": "Full banner link",
            "info": "Leave blank if banner is not clickable."
        },
        {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open banner link in new tab",
            "default": false
        },
        {
            "type": "header",
            "content": "Desktop Spacing"
        },
        {
            "type": "range",
            "id": "padding_top_desktop",
            "label": "Top padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "padding_bottom_desktop",
            "label": "Bottom padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "padding_horizontal_desktop",
            "label": "Horizontal padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 24
        },
        {
            "type": "range",
            "id": "item_gap_desktop",
            "label": "Gap between items",
            "min": 0,
            "max": 32,
            "step": 2,
            "unit": "px",
            "default": 4
        },
        {
            "type": "header",
            "content": "Mobile Spacing"
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Top padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Bottom padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "padding_horizontal_mobile",
            "label": "Horizontal padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 24
        },
        {
            "type": "range",
            "id": "item_gap_mobile",
            "label": "Gap between items",
            "min": 0,
            "max": 32,
            "step": 2,
            "unit": "px",
            "default": 4
        },
        {
            "type": "header",
            "content": "Buttons"
        },
        {
            "type": "select",
            "id": "buttons_desktop",
            "label": "Buttons (desktop)",
            "options": [
                { "label": "Side by side", "value": "side_by_side" },
                { "label": "Stacked", "value": "stacked" }
            ],
            "default": "side_by_side"
        },
        {
            "type": "select",
            "id": "buttons_mobile",
            "label": "Buttons (mobile)",
            "options": [
                { "label": "Side by side", "value": "side_by_side" },
                { "label": "Stacked", "value": "stacked" }
            ],
            "default": "stacked",
            "info": "Side by side wraps onto a second row when the buttons do not fit."
        },
        {
            "type": "range",
            "id": "button_gap",
            "label": "Gap between side-by-side buttons",
            "min": 0,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 12,
            "info": "Stacked buttons use the gap between items instead."
        }
    ],
    "blocks": [
      {
        "type": "block--message-line"
      },
      {
        "type": "block--button"
      }
    ],
    "presets": [
      {
        "name": "Full Width Image & Text",
        "blocks": [
          {
            "type": "block--message-line",
            "settings": {
              "text": "Your message here",
              "size_desktop": 50,
              "size_mobile": 24,
              "text_color": "#ffffff"
            }
          },
          {
            "type": "block--button",
            "settings": {
              "label": "Shop now"
            }
          }
        ]
      }
    ]
}
{% endschema %}