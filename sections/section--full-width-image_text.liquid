        },
        {
            "type": "url",
            "id": "banner_link",
            "label": "Full banner link",
            "info": "Leave blank if banner is not clickable."
        },
        {
            "type": "checkbox",
            "id": "open_in_new_tab",
            "label": "Open banner link in new tab",
            "default": false
