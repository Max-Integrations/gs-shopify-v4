            "id": "padding_top_mobile",
            "label": "Top padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
            "default": 48
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Bottom padding",
            "min": 0,
            "max": 128,
            "step": 4,
            "unit": "px",
