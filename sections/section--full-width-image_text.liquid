{%- liquid
    assign desktop_img = section.settings.background_image_desktop | default: section.settings.background_image_mobile
    assign mobile_img = section.settings.background_image_mobile | default: section.settings.background_image_desktop

    assign auto_height = false
    if section.settings.image_height_auto and desktop_img != blank
        assign auto_height = true
    endif

    # Banner label: first non-empty message line
    assign message_blocks = section.blocks | where: 'type', 'message_line'
    assign button_blocks = section.blocks | where: 'type', 'button'

    # The stacked layout renders blocks in the order the merchant placed them.
    # The row layouts keep the text-side / CTA-side split, so messages are
    # forced ahead of buttons and each run is wrapped in its own group.
    assign grouped = true
    assign render_blocks = message_blocks | concat: button_blocks
    if section.settings.layout_preset == 'center'
        assign grouped = false
        assign render_blocks = section.blocks
    endif

    assign banner_label = 'View promotion'
    if message_blocks.size > 0 and message_blocks.first.settings.text != blank
        assign banner_label = message_blocks.first.settings.text | strip_html | strip
    endif

    assign content_align = 'center'
    assign messages_align = section.settings.layout_preset
    if section.settings.layout_preset == 'center'
        assign content_align = section.settings.alignment_preset
        assign messages_align = section.settings.alignment_preset
    endif

    # LCP: first two sections load eagerly and preload their CSS/image
    assign is_lcp = false
    assign fetch_priority = 'auto'
    assign loading_strategy = 'lazy'
    if section.index <= 2
        assign is_lcp = true
        assign fetch_priority = 'high'
        assign loading_strategy = 'eager'
    endif
-%}

{{ 'section--full-width-image_text.css' | asset_url | stylesheet_tag: preload: is_lcp }}

<div
    class="fwit-promo layout-{{ section.settings.layout_preset }} visibility-{{ section.settings.visibility }}{% if auto_height %} image-auto-height{% endif %}"
    style="
        --section-background: {{ section.settings.background_color }};
        --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
        --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
        --section-padding-x-desktop: {{ section.settings.padding_horizontal_desktop }}px;
        --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
        --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        --section-padding-x-mobile: {{ section.settings.padding_horizontal_mobile }}px;
        --item-gap-desktop: {{ section.settings.item_gap_desktop }}px;
        --item-gap-mobile: {{ section.settings.item_gap_mobile }}px;
        --button-gap: {{ section.settings.button_gap }}px;
        --content-align: {{ content_align }};
        --messages-align: {{ messages_align }};
    "
>
    {% if section.settings.banner_link != blank %}
        <a href="{{ section.settings.banner_link }}" class="promo-stretched-link" {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <span class="visually-hidden">{{ banner_label }}</span>
        </a>
    {% endif %}

    {% if desktop_img != blank %}
        <picture class="promo-bg-picture">
            {% if mobile_img != blank %}
                <source
                    media="(max-width: 768px)"
                    srcset="{{ mobile_img | image_url: width: 1200 }}"
                    width="{{ mobile_img.width }}"
                    height="{{ mobile_img.height }}">
            {% endif %}
            {{
                desktop_img
                | image_url: width: 2000
                | image_tag:
                    alt: desktop_img.alt,
                    width: desktop_img.width,
                    height: desktop_img.height,
                    widths: '600, 900, 1200, 1500, 2000',
                    sizes: '100vw',
                    loading: loading_strategy,
                    fetchpriority: fetch_priority,
                    preload: is_lcp 
            }}
        </picture>
    {% endif %}

    <div class="promo-content">
        {%- comment -%}
            Group wrappers are opened and closed in separate branches, so the source
            looks unbalanced even though every rendered group is closed exactly once.
        {%- endcomment -%}
        {% # theme-check-disable UnclosedHTMLElement %}
        {%- for block in render_blocks -%}
            {%- if grouped -%}
                {%- assign prev_index = forloop.index0 | minus: 1 -%}
                {%- if forloop.first or render_blocks[prev_index].type != block.type -%}
                    <div class="{% if block.type == 'button' %}promo-actions{% else %}promo-messages{% endif %}">
                {%- endif -%}
            {%- endif -%}

            {%- case block.type -%}
                {%- when 'message_line' -%}
                    <div
                        class="promo-message"
                        style="
                            --color: {{ block.settings.text_color }};
                            --background-color: {{ block.settings.background_color }};
                            --padding-x-desktop: {{ block.settings.padding_horizontal_desktop }}px;
                            --padding-y-desktop: {{ block.settings.padding_vertical_desktop }}px;
                            --padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;
                            --padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
                            --font-size-desktop: {{ block.settings.size_scale_desktop }};
                            --font-size-mobile: {{ block.settings.size_scale_mobile }};
                            --letter-spacing: {{ block.settings.letter_spacing }}px;
                        "
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.text }}
                    </div>

                {%- when 'button' -%}
                    <a
                        href="{{ block.settings.url }}"
                        class="promo-btn"
                        style="
                            --color: {{ block.settings.text_color }};
                            --background-color: {{ block.settings.background_color }};
                            --border-color: {{ block.settings.border_color }};
                            --border-width: {{ block.settings.border_width }}px;
                            --padding-x-desktop: {{ block.settings.padding_horizontal_desktop }}px;
                            --padding-y-desktop: {{ block.settings.padding_vertical_desktop }}px;
                            --padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;
                            --padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
                            --font-size-desktop: {{ block.settings.size_scale_desktop }};
                            --font-size-mobile: {{ block.settings.size_scale_mobile }};
                            --letter-spacing: {{ block.settings.letter_spacing }}px;
                            {% if block.settings.text_color_hover != blank %}--color-hover: {{ block.settings.text_color_hover }};{% endif %}
                            {% if block.settings.background_color_hover != blank %}--background-color-hover: {{ block.settings.background_color_hover }};{% endif %}
                            {% if block.settings.border_color_hover != blank %}--border-color-hover: {{ block.settings.border_color_hover }};{% endif %}
                            {% if block.settings.text_color_hover != blank or block.settings.background_color_hover != blank or block.settings.border_color_hover != blank %}--hover-opacity: 1;{% endif %}
                        "
                        {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                        {{ block.shopify_attributes }}
                    >
                        {{ block.settings.text }}
                    </a>
            {%- endcase -%}

            {%- if grouped -%}
                {%- if forloop.last or render_blocks[forloop.index].type != block.type -%}
                    </div>
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
        {% # theme-check-enable UnclosedHTMLElement %}
    </div>
</div>

{% schema %}
{
