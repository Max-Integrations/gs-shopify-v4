      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "multicolumn_yts_heading_bold",
      "label": "Bold heading",
      "default": false
    },
    {
      "type": "text_alignment",
      "id": "multicolumn_yts_heading_alignment",
      "label": "Heading alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Columns"
