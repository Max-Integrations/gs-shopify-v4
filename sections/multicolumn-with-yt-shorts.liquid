      "default": false
    },
    {
      "type": "range",
      "id": "mutlicolumn_yts_top_space_desktop",
      "label": "Top spacing (desktop)",
      "default": 75,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "mutlicolumn_yts_bottom_space_desktop",
      "label": "Bottom spacing (desktop)",
      "default": 75,
      "min": 0,
      "max": 150,
      "step": 5
    },
    {
      "type": "range",
      "id": "mutlicolumn_yts_top_space_mobile",
      "label": "Top spacing (mobile)",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "mutlicolumn_yts_bottom_space_mobile",
      "label": "Bottom spacing (mobile)",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "text_alignment",
