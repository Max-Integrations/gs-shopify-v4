{% comment %}
  Ported from gs-shopify-v3 sections/slideshow.liquid by scripts/port-section.py
  (2026-10 client review: "modules to carry over"). Schema labels are
  literal strings, colour schemes are Dawn's, and the v3 snippets this
  theme lacks are inlined so the section stays self-contained.
{% endcomment %}
{{ 'slideshow.css' | asset_url | stylesheet_tag }}
<div class="slide-show-wrapper p-0">
  {% liquid
    assign zoomclass = ''
    assign slider_thumbnail = section.settings.slider_thumbnail
    case slider_thumbnail
      when 'dots'
        assign dots = true
      when 'arrow-count'
        assign dots = false
      when 'only-arrow'
        assign dots = false
    endcase
    if section.settings.slider_transition == 'fade'
      assign zoomclass = 'zoom-animate-slide'
    endif
  %}
  <div
    class="no-js-slider slideshow-outer {{ section.settings.layout_type }} {% if section.settings.slider_transition == 'fade' %}slideshow-zoom{% endif %} banner-fullwidth"
    {% if section.settings.slider_thumbnail == 'arrow-count' %}
      data-slideshow-pagination
    {% endif %}
    {% if section.blocks.size > 1 %}
      data-slideshow='
        {
        "contain": true,
        "cellAlign": "left",
        "imagesLoaded": true,
        "lazyLoad": true,
        "fade": {% if section.settings.slider_transition == 'fade' %}true{% else %}false{% endif %},
        "pageDots": {{dots}},
        "autoPlay": {% if section.settings.auto_rotate == true %}{{ section.settings.change_slides_speed | times: 1000 }}{% else %}false{% endif %},
        "draggable": true,
        "prevNextButtons": false,
        "groupCells": true,
        "cellSelector":".slideshow-item",
        "zoom": true
        }
      '
    {% endif %}
  >
    {% for block in section.blocks %}
      {% capture slideImage %}
          {% liquid
            assign mobileImage = false
            if block.settings.image_mobile != blank
              assign mobileImage = true
              assign mobileClass = 'mobile-img d-block d-md-none ' | append: zoomclass
              echo block.settings.image_mobile | image_url: width: 1200 | image_tag: class: mobileClass, loading: 'lazy'
            endif
            assign desktopClass = '' | append: zoomclass
            if mobileImage
              assign desktopClass = 'd-none d-md-block ' | append: zoomclass
       
            endif
            if block.settings.image_desktop != blank
              echo block.settings.image_desktop | image_url: width: 2000 | image_tag: class: desktopClass, loading: 'lazy'
            elsif block.settings.image_desktop == blank and mobileImage
              assign placeholderClass = 'placeholder-svg d-none d-md-block ' | append:zoomclass
              echo 'hero-apparel-2' | placeholder_svg_tag: placeholderClass 
            else
              assign placeholderClass = 'placeholder-svg ' | append:zoomclass
              echo 'hero-apparel-1' | placeholder_svg_tag: placeholderClass
            endif
          %}
    {% endcapture %}
      <div
        id="slideshow_item_{{ block.id }}"
        class="slideshow-item {% if section.settings.desktop_height == 'adapt_image' %}desktop-adapt-height{%- else -%} desktop-fixed-height {% endif %} {% if section.settings.mobile_height == 'adapt_image' %} mobile-adapt-height{%- else -%} mobile-fixed-height{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.slide_as_link == true %}
          {% if block.settings.btn_link != blank %}
            <a class="slideshow-link" href="{{ block.settings.btn_link }}" aria-label="Media link"></a>
          {% endif %}
        {% endif %}
        <div class="slideshow-media media">
          {% if block.settings.slider_video != blank %}
            <deferred-media class="deferred-media">
              <template>
                <video id="slider_video-{{ block.id }}" class="videoBackgroundFile" autoplay muted loop playsinline>
                  <source
                    src="{% if block.settings.slider_video.sources[0].url contains 'mp4' %}{{ block.settings.slider_video.sources[0].url -}}{% else %}{{ block.settings.slider_video.sources[1].url -}}{% endif %}"
                    type="video/mp4"
                  >
                </video>
             </template>
                <div class="deferred-media-placeholder">
                    {%- if block.settings.slider_video.preview_image != blank -%}<img class="{{ '' }}" src="{{ block.settings.slider_video.preview_image | image_url: width: 600 }}" srcset="{{ block.settings.slider_video.preview_image | image_url: width: 300 }} 300w, {{ block.settings.slider_video.preview_image | image_url: width: 600 }} 600w, {{ block.settings.slider_video.preview_image | image_url: width: 900 }} 900w, {{ block.settings.slider_video.preview_image | image_url: width: 1200 }} 1200w, {{ block.settings.slider_video.preview_image | image_url: width: 1500 }} 1500w, {{ block.settings.slider_video.preview_image | image_url: width: 2000 }} 2000w" sizes="(max-width: 600px) 300px, (max-width: 900px) 600px, (max-width: 1200px) 900px, (max-width: 1500px) 1200px, 100vw" width="{{ block.settings.slider_video.preview_image.width }}" height="{{ block.settings.slider_video.preview_image.height }}" alt="{{ block.settings.slider_video.preview_image.alt | escape }}" loading="lazy" style="object-position: {{ block.settings.slider_video.preview_image.presentation.focal_point | default: 'center' }}">{%- endif -%}
                </div>
                 <noscript>
                        <a
                          href="{{ block.settings.slider_video | external_video_url }}"
                          target="_blank"
                          class="unstyled-link"
                          aria-label="{{ block.settings.slider_video.alt | default: product.title | strip_html }}"
                        >
                          {% comment %}theme-check-disable ImgWidthAndHeight{% endcomment %}
                          <img
                            src="{{ block.settings.slider_video.preview_image | image_url: width: 2048 }}"
                            alt="{{ block.settings.slider_video.preview_image.alt | escape }}"
                            loading="lazy"
                          >
                          {% comment %}theme-check-enable ImgWidthAndHeight{% endcomment %}
                        </a>
                      </noscript>
            </deferred-media>
          {%- else -%}
            {{ slideImage }}
          {% endif %}
        </div>
        {% if block.settings.heading != blank
          or block.settings.description != blank
          or block.settings.btn_link != blank
        %}
          <div class="slideshow-content-wrapper">
            <div class="slideshow-content {{ block.settings.content_width }}-width {{ block.settings.desktop_content_position }} {{ block.settings.mobile_content_position }} {{ block.settings.desktop_alignment }} {{ block.settings.mobile_alignment }}">
              <div class="slideshow-content-inner">
                {% if block.settings.heading != blank %}
                  <{{ block.settings.seo_heading }} class="slideshow-heading {{ block.settings.font_family }}-font {{ block.settings.heading_size }}">
                    {{- block.settings.heading -}}
                  </{{ block.settings.seo_heading }}>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="slideshow-desc">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.btn_link != blank or block.settings.btn_link2 != blank %}
                  <div class="slideshow-button-box">
                    {% if block.settings.slide_as_link == false %}
                      {% if block.settings.btn_link != blank and block.settings.btn_text != blank %}
                        <a
                          href="{{ block.settings.btn_link }}"
                          class="{% if block.settings.button_as_link %}hyperlink {% else %} button{% if false %} button-shadow{% endif %}{% endif %} slideshow-button {{ block.settings.button_size }}-btn"
                          title="{{ block.settings.btn_text }}"
                        >
                          {{- block.settings.btn_text -}}
                        </a>
                      {% endif %}
                      {% if block.settings.btn_link2 != blank and block.settings.btn_text2 != blank %}
                        <a
                          href="{{ block.settings.btn_link2 }}"
                          class="{% if block.settings.button_as_link2 %}hyperlink {% else %} button{% if false %} button-shadow{% endif %}{% endif %} slideshow-button {{ block.settings.button_size }}-btn"
                          title="{{ block.settings.btn_text }}"
                        >
                          {{- block.settings.btn_text2 -}}
                        </a>
                      {% endif %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
    {% if section.blocks.size > 1 %}
      {% if section.settings.slider_thumbnail == 'arrow-count' %}
        <div class="navigation-arrow-button-list no-js-hidden">
          <button class="navigation-arrow-button previous" type="button" aria-label="Previous" data-slideshow-navigation-button data-swatch-scroll="prev"><svg class="navigation-arrow-button-icon" width="9" height="12" viewBox="0 0 9 12" fill="none" aria-hidden="true"><path d="M6.8999 10.6L2.0999 5.8L6.8999 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="slider-pagination"><span class="current-slide">1</span><span class="slide-spacer">/</span><span class="total-slides">{{ section.blocks.size }}</span></div><button class="navigation-arrow-button next" type="button" aria-label="Next" data-slideshow-navigation-button data-swatch-scroll="next"><svg class="navigation-arrow-button-icon" width="7" height="12" viewBox="0 0 7 12" fill="none" aria-hidden="true"><path d="M1.1001 10.6L5.9001 5.8L1.1001 1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      {% elsif section.settings.slider_thumbnail == 'only-arrow' %}
        {%- assign arrow_class = 'navigation-button-icon' -%}<button class="custom-navigation-button flickity-button flickity-prev-next-button swiper-button previous" type="button" aria-label="Previous" data-slideshow-navigation-button data-swatch-scroll="prev"><svg class="{{ arrow_class }}" width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true" focusable="false"><path d="M12 6H1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 1.5L1 6L5.5 10.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button class="custom-navigation-button flickity-button flickity-prev-next-button swiper-button next" type="button" aria-label="Next" data-slideshow-navigation-button data-swatch-scroll="next"><svg class="{{ arrow_class }}" width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true" focusable="false"><path d="M1.5 6H12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 1.5L12.5 6L8 10.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      {% endif %}
    {% endif %}
  </div>
</div>
<style>
    #shopify-section-{{ section.id }}{
      {% if section.settings.desktop_height == '100vh'%}
        --slideshow-height: {{ section.settings.desktop_height }};
      {% else %}
      --slideshow-height: {{ section.settings.desktop_height }};
      {% endif %}
      {% if section.blocks.first.settings.image_desktop != blank %}
        --imageRatio : {{- 1 | divided_by : section.blocks.first.settings.image_desktop.aspect_ratio | times: 100 -}}%;
        {% else %}
        --imageRatio : 50%;
      {% endif %}
      }
      {% if section.settings.slider_transition == 'fade' %}
      #shopify-section-{{ section.id }} .flickity-slider{ transform: none !important; }
      #shopify-section-{{ section.id }} .slideshow_item{
        left: 0 !important;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
        z-index: -1;
        left: 0 !important;
      opacity: 0;
      transition: "opacity 0.3s ease-in-out";
    }
    #shopify-section-{{ section.id }} .slideshow_item.is-selected{
      opacity: 1;
      z-index: 0
    }
  {% endif %}
    {% for block in section.blocks %}
      #slideshow_item_{{ block.id }}{
        --slideshow-heading-color:{{block.settings.text_color }};
        --slideshow-text-color: {{ block.settings.description_color }};
        --overlay-bg:{{ block.settings.overlay_color }};
        --overlay-opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }};
        --content-bg:{{ block.settings.content_overlay_color.red }},{{ block.settings.content_overlay_color.green }},{{ block.settings.content_overlay_color.blue }};
        --content-bg-alpha:{{ block.settings.content_overlay_opacity | divided_by:100.0 }};
        --linkColor: {{ block.settings.btn_text_color.red }},{{ block.settings.btn_text_color.green }},{{ block.settings.btn_text_color.blue }};
        --buttonBackground: {{ block.settings.btn_bg_color.red }},{{ block.settings.btn_bg_color.green }},{{ block.settings.btn_bg_color.blue }};
        {% unless block.settings.btn_shadow_color == 'rgba(0,0,0,0)' or block.settings.btn_shadow_color == blank %}
          --buttonShadow:{{ block.settings.btn_shadow_color }};
        {% endunless %}
        --buttonColor: {{ block.settings.btn_text_color.red }},{{ block.settings.btn_text_color.green }},{{ block.settings.btn_text_color.blue }};
        --buttonBorder: {{ block.settings.btn_border_color.red }},{{ block.settings.btn_border_color.green }},{{ block.settings.btn_border_color.blue }};
        --buttonBackgroundHover:{{ block.settings.btn_hover_color.red }},{{ block.settings.btn_hover_color.green }},{{ block.settings.btn_hover_color.blue }};
        --buttonColorHover:{{ block.settings.btn_hover_text_color.red }},{{ block.settings.btn_hover_text_color.green }},{{ block.settings.btn_hover_text_color.blue }};
        --buttonBorderHover:{{ block.settings.btn_hover_border_color.red }},{{ block.settings.btn_hover_border_color.green }},{{ block.settings.btn_hover_border_color.blue }};

      }
      
    {% endfor %}
      @media screen and (max-width:767px) {
        #shopify-section-{{ section.id }}{
          {% if section.settings.mobile_height == '100vh'%}
            --slideshow-height: {{ section.settings.mobile_height }};
          {% else %}
          --slideshow-height: {{ section.settings.mobile_height }};
          {% endif %}
          {% if section.blocks.first.settings.image_mobile != blank %}
            --imageRatio : {{- 1 | divided_by : section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 -}}%;
            {% else %}
            --imageRatio : 50%;
          {% endif %}
        }
        {% for block in section.blocks %}
          #slideshow_item_{{ block.id }}{
            --slideshow-heading-color:{{block.settings.m_text_color }};
            --slideshow-text-color: {{ block.settings.m_description_color }};
            --buttonBackground: {{ block.settings.m_btn_bg_color.red }},{{ block.settings.m_btn_bg_color.green }},{{ block.settings.m_btn_bg_color.blue }};
            {% unless block.settings.m_btn_shadow_color == 'rgba(0,0,0,0)' or block.settings.m_btn_shadow_color == blank %}
              --buttonShadow:{{ block.settings.m_btn_shadow_color }};
            {% endunless %}
            --linkColor:{{ block.settings.m_btn_text_color.red }},{{ block.settings.m_btn_text_color.green }},{{ block.settings.m_btn_text_color.blue }};
            --buttonColor: {{ block.settings.m_btn_text_color.red }},{{ block.settings.m_btn_text_color.green }},{{ block.settings.m_btn_text_color.blue }};
            --buttonBorder: {{ block.settings.m_btn_border_color.red }},{{ block.settings.m_btn_border_color.green }},{{ block.settings.m_btn_border_color.blue }};
          }
        {% endfor %}
      }
      {% if section.settings.section_visibility == 'large' %}
        @media (max-width: 767px) {
          #shopify-section-{{ section.id }}{
            display: none !important;
          }
        }
        {% elsif section.settings.section_visibility == 'small' %}
          @media (min-width: 768px) {
            #shopify-section-{{ section.id }}{
              display: none !important;
            }
          }
      {% endif %}
      

</style>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "slideshow-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Section visibility",
      "default": "always",
      "options": [
        {
          "label": "Always",
          "value": "always"
        },
        {
          "label": "Small devices only",
          "value": "small"
        },
        {
          "label": "Large devices only",
          "value": "large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "select",
      "id": "slider_thumbnail",
      "label": "Pagination style",
      "default": "only-arrow",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "arrow-count",
          "label": "Arrows with count"
        },
        {
          "value": "only-arrow",
          "label": "Arrows"
        }
      ]
    },
    {
      "type": "select",
      "id": "slider_transition",
      "label": "Animation style",
      "default": "slide",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop height",
      "default": "550px",
      "options": [
        {
          "value": "400px",
          "label": "400px"
        },
        {
          "value": "550px",
          "label": "550px"
        },
        {
          "value": "650px",
          "label": "650px"
        },
        {
          "value": "750px",
          "label": "750px"
        },
        {
          "value": "850px",
          "label": "850px"
        },
        {
          "value": "100vh",
          "label": "Fullscreen"
        },
        {
          "value": "adapt_image",
          "label": "Auto adapt to first slide"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile height",
      "default": "450px",
      "options": [
        {
          "value": "450px",
          "label": "450px"
        },
        {
          "value": "550px",
          "label": "550px"
        },
        {
          "value": "650px",
          "label": "650px"
        },
        {
          "value": "100vh",
          "label": "Fullscreen"
        },
        {
          "value": "adapt_image",
          "label": "Auto adapt to first slide"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)"
        },
        {
          "type": "video",
          "id": "slider_video",
          "label": "Background video",
          "info": "It supports only .mp4 videos."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h1",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ]
        },
        {
          "type": "select",
          "id": "seo_heading",
          "label": "Heading tag",
          "info": "Specify heading code types for SEO and search engines for crawling purposes.",
          "default": "h1",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ]
        },
        {
          "type": "select",
          "id": "font_family",
          "label": "Font family",
          "options": [
            {
              "value": "heading",
              "label": "Heading"
            },
            {
              "value": "body",
              "label": "Body"
            }
          ],
          "default": "heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Use this text to share information about your brand with your customers."
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "default": "large",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "extra-large",
              "label": "Extra large"
            }
          ]
        },
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Text",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "checkbox",
          "id": "slide_as_link",
          "label": "Apply link to slide",
          "info": "Using this, both buttons will not be visible.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "button_as_link",
          "label": "Show button as link",
          "default": false
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "text",
          "id": "btn_text2",
          "label": "Text",
          "default": "Button text"
        },
        {
          "type": "url",
          "id": "btn_link2",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "checkbox",
          "id": "button_as_link2",
          "label": "Show button as link",
          "default": false
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "content_width",
          "label": "Desktop width",
          "default": "large",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },
        {
          "type": "select",
          "id": "desktop_content_position",
          "label": "Desktop position",
          "default": "d-center",
          "options": [
            {
              "value": "d-top-left",
              "label": "Top left"
            },
            {
              "value": "d-top-center",
              "label": "Top center"
            },
            {
              "value": "d-top-right",
              "label": "Top right"
            },
            {
              "value": "d-center-left",
              "label": "Middle left"
            },
            {
              "value": "d-center",
              "label": "Middle center"
            },
            {
              "value": "d-center-right",
              "label": "Middle right"
            },
            {
              "value": "d-bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "d-bottom-center",
              "label": "Bottom center"
            },
            {
              "value": "d-bottom-right",
              "label": "Bottom right"
            }
          ]
        },
        {
          "type": "select",
