{% comment %}
  ==================================================================
  INFLUENCER HIGHLIGHTS
  Ported from gs-shopify-v3
  sections/influencers-overview-profile-highlights.liquid
  ==================================================================
  Grid of influencer profile cards: image, name, subcopy, CTA.

  Setting IDs are byte-for-byte identical to v3.

  ------------------------------------------------------------------
  A MISSING SEMICOLON BROKE TWO DECLARATIONS
  ------------------------------------------------------------------
  v3 built the CTA style inline:

      {% raw %}{%- if ... == "circle" -%}border-radius: 50%{%- endif -%} color: {{ ... }};{% endraw %}

  With "circle" selected that renders as

      border-radius: 50% color: #000000;

  - one malformed declaration. The browser discards it, so the button
  gets NEITHER the rounding NOR the text colour. Choosing circle broke
  the very thing it was meant to style.

  ------------------------------------------------------------------
  THE FONT STACK WAS QUOTED AS ONE FAMILY NAME
  ------------------------------------------------------------------
      font-family: "Roboto, sans-serif";

  That is a single quoted family literally named `Roboto, sans-serif`,
  which does not exist - so the profile copy fell back to inherited
  type. Quoting a whole stack is a different bug from the unquoted
  multi-word family found elsewhere in this theme, but the effect is the
  same: the font never applied.

  ------------------------------------------------------------------
  OTHER v3 FIXES
  ------------------------------------------------------------------
  - `assign total_influencers = section.blocks.size` was never read.
  - A long inline style attribute per card, rebuilt on every render.
  - target="_blank" with no rel="noopener noreferrer".
  - Images requested at a fixed 400px with no srcset.
  - No alt fallback on profile photos.
  - !important on the mobile CTA rules.
  - Times New Roman offered as a brand font.
  ==================================================================
{% endcomment %}

{{ 'gs-influencer.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="page-width" id="gs-influencers-{{ section.id }}">
    <div class="gs-influencers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings

          case b.highlight_cta_text_font
            when 'Engravers MT'
              assign cta_font = '"Engravers MT", var(--headingFont)'
            when 'heading'
              assign cta_font = 'var(--headingFont)'
            else
              assign cta_font = 'var(--bodyFont)'
          endcase
        -%}

        <div
          class="gs-influencer"
          style="
            --inf-cta-bg: {{ b.highlight_cta_bg_color }};
            --inf-cta-color: {{ b.highlight_cta_text_color }};
            --inf-cta-font: {{ cta_font }};
            --inf-cta-radius: {% if b.highlight_cta_button_type == 'circle' %}50%{% else %}0{% endif %};
          "
          {{ block.shopify_attributes }}
        >
          {%- if b.highlight_image != blank -%}
            {%- assign img = b.highlight_image -%}
            <div class="gs-influencer__media">
              <img
                src="{{ img | image_url: width: 500 }}"
                srcset="
                  {{ img | image_url: width: 300 }} 300w,
                  {{ img | image_url: width: 500 }} 500w,
                  {{ img | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 990px) 25vw, 50vw"
                alt="{{ img.alt | escape | default: b.title | strip_html | escape }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          <div class="gs-influencer__details">
            {%- if b.title != blank -%}
              <div class="gs-influencer__name">{{ b.title }}</div>
            {%- endif -%}

            {%- if b.highlight_subcopy != blank -%}
              <div class="gs-influencer__subcopy">{{ b.highlight_subcopy }}</div>
            {%- endif -%}

            {%- if b.highlight_cta != blank and b.highlight_cta_btn_link != blank -%}
              <a
                class="gs-influencer__cta"
                href="{{ b.highlight_cta_btn_link }}"
                {% if b.highlight_cta_link_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{- b.highlight_cta -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Influencer Highligh (old)",
  "tag": "section",
  "class": "influencers-overview-highlight",
  "settings": [
    {
      "type": "header",
      "content": "Influencer Profile Highlights"
    }
  ],
  "blocks": [
    {
      "name": "Highlight",
      "type": "highlight",
      "settings": [
        {
          "type": "image_picker",
          "id": "highlight_image",
          "label": "Profile image"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Name",
          "default": "<p>Name</p>"
        },
        {
          "type": "richtext",
          "id": "highlight_subcopy",
          "label": "Subcopy",
          "default": "<p>Subcopy</p>"
        },
        {
          "type": "text",
          "id": "highlight_cta",
          "label": "CTA text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "highlight_cta_btn_link",
          "label": "CTA link"
        },
        {
          "type": "checkbox",
          "id": "highlight_cta_link_new_window",
          "label": "Open in a new tab",
          "default": false
        },
        {
          "type": "color",
          "id": "highlight_cta_bg_color",
          "label": "CTA background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "highlight_cta_text_color",
          "label": "CTA text color",
          "default": "#000000"
        },
        {
          "type": "select",
          "id": "highlight_cta_text_font",
          "label": "CTA font",
          "info": "Engravers MT has no font file in this theme yet and will fall back.",
          "options": [
            {
              "value": "body",
              "label": "Theme body font"
            },
            {
              "value": "heading",
              "label": "Theme heading font"
            },
            {
              "value": "Engravers MT",
              "label": "Engravers MT"
            }
          ],
          "default": "body"
        },
        {
          "type": "select",
          "id": "highlight_cta_button_type",
          "label": "CTA shape",
          "info": "In v3, choosing Circle broke both the shape and the text colour.",
          "options": [
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "circle",
              "label": "Circle"
            }
          ],
          "default": "square"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
