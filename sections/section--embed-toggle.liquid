{% comment %}
  ==================================================================
  EMBED TOGGLE
  ==================================================================
  A button that reveals an embedded frame (a job board, a form, a
  booking widget). Replaces v3's snippets/show-iframe-with-cta.liquid,
  which the careers page pulled in through a custom-liquid section
  with the Paylocity recruiting URL.

  The iframe's src is only set when the visitor opens it, so a heavy
  third-party page does not load for everyone. Open state is exposed
  with aria-expanded / aria-controls.
  ==================================================================
{% endcomment %}

{{ 'section--embed-toggle.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign uid = 'GsEmbed-' | append: section.id
  case s.ratio
    when '4:3'
      assign ratio = '75%'
    when '3:4'
      assign ratio = '133.33%'
    else
      assign ratio = '56.25%'
  endcase
-%}

<div
  class="gs-embed color-{{ s.color_scheme | default: 'scheme-4' }}"
  id="{{ uid }}"
  style="--gs-embed-ratio: {{ ratio }}; --gs-embed-pad-top: {{ s.padding_top | default: 32 }}px; --gs-embed-pad-bottom: {{ s.padding_bottom | default: 32 }}px;"
>
  <div class="page-width gs-embed__inner">
    {%- if s.heading != blank -%}
      <h2 class="gs-embed__heading h2">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.embed_url != blank -%}
      <button
        type="button"
        class="button gs-embed__toggle"
        data-gs-embed-toggle
        aria-expanded="{% if s.open_by_default %}true{% else %}false{% endif %}"
        aria-controls="{{ uid }}-frame"
        data-label-open="{{ s.cta_label | default: 'View' | escape }}"
        data-label-close="{{ s.close_label | default: 'Hide' | escape }}"
      >
        {%- if s.open_by_default -%}{{ s.close_label | default: 'Hide' }}{%- else -%}{{ s.cta_label | default: 'View' }}{%- endif -%}
      </button>

      <div class="gs-embed__frame" id="{{ uid }}-frame" data-gs-embed-frame {% unless s.open_by_default %}hidden{% endunless %}>
        <iframe
          title="{{ s.frame_title | default: s.cta_label | default: 'Embedded content' | escape }}"
          {% if s.open_by_default %}src="{{ s.embed_url }}"{% else %}data-src="{{ s.embed_url }}"{% endif %}
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ uid }}');
    if (!root || root.gsBound) return;
    root.gsBound = true;
    var btn = root.querySelector('[data-gs-embed-toggle]');
    var frame = root.querySelector('[data-gs-embed-frame]');
    if (!btn || !frame) return;
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      var iframe = frame.querySelector('iframe');
      if (!open && iframe && iframe.dataset.src) {
        iframe.src = iframe.dataset.src;
        delete iframe.dataset.src;
      }
      frame.hidden = open;
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      btn.textContent = open ? btn.dataset.labelOpen : btn.dataset.labelClose;
      if (!open) frame.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  })();
</script>

{% schema %}
{
  "name": "Embed toggle",
  "tag": "section",
  "class": "gs-embed-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "embed_url", "label": "Embed URL", "info": "The page to show in the frame, e.g. a job board." },
    { "type": "text", "id": "frame_title", "label": "Frame title", "info": "Read by screen readers." },
    { "type": "text", "id": "cta_label", "label": "Button label (closed)", "default": "View opportunities" },
    { "type": "text", "id": "close_label", "label": "Button label (open)", "default": "Hide opportunities" },
    { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false },
    {
      "type": "select",
      "id": "ratio",
      "label": "Frame shape",
      "options": [
        { "value": "16:9", "label": "Wide (16:9)" },
        { "value": "4:3", "label": "Standard (4:3)" },
        { "value": "3:4", "label": "Tall (3:4)" }
      ],
      "default": "16:9"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    { "name": "Embed toggle" }
  ]
}
{% endschema %}
