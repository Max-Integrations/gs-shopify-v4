      "label": "Hover background color",
      "default": "#2A2A2A"
    },
    {
      "type": "select",
      "id": "item_animate_hover",
      "label": "Hover animation",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Float up",
          "value": "float-up"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "item_padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_item_border",
      "label": "Show border?",
      "default": true
