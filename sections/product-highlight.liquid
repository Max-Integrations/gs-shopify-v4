{% comment %}
  ==================================================================
  PRODUCT HIGHLIGHT
  Ported from gs-shopify-v3 sections/product-highlight.liquid
  ==================================================================
  Homepage: "SUPPORT THOSE WHO SERVE" - a split panel with copy and two
  CTAs on one side, an image with optional chevron arrows on the other.

  ------------------------------------------------------------------
  THREE SETTINGS REFERENCED IN CSS THAT DO NOT EXIST
  ------------------------------------------------------------------
  1. product_highlight_image_arrows_spacing_desktop
  2. product_highlight_image_arrows_spacing_mobile
     Used as: height: calc(100% - ({{ ... }}px * 2))
     The real settings are product_highlight_image_spacing_desktop /
     _mobile - without "arrows". So the CSS emitted
         height: calc(100% - (px * 2))
     which is invalid, and the declaration was dropped entirely. The
     vertical arrow column has therefore never had its intended height.

  3. product_highlight_image_heading_spacing_mobile
     Used as: top: {{ ... }}px -> `top: px`. Also invalid, also dropped.

  All three now use the settings that actually exist.

  ------------------------------------------------------------------
  A SETTING THAT DOES NOTHING
  ------------------------------------------------------------------
  product_highlight_text_content_cta_bg_color is defined, exposed in the
  editor, and NEVER REFERENCED in the CSS. The .custom-cta rule set a
  border but no background-color. Anyone who changed that colour saw no
  effect. Now wired up.

  ------------------------------------------------------------------
  TRAILING COMMA - SIXTH OCCURRENCE
  ------------------------------------------------------------------
  After the final range setting, before the closing bracket. Sixth
  section with this defect. `shopify theme check` catches all of them.

  ------------------------------------------------------------------
  BOTH IMAGES WERE DOWNLOADED ON EVERY DEVICE
  ------------------------------------------------------------------
  v3 rendered the desktop AND mobile images as two <img> tags and toggled
  them with display:none. Browsers still fetch a display:none image, so
  every visitor downloaded both. Now a <picture> element with a media
  query, so exactly one is fetched.

  ------------------------------------------------------------------
  GLOBAL CSS WITH VERY GENERIC NAMES
  ------------------------------------------------------------------
  v3 declared .custom-cta, .desktop-image, .mobile-image, .row-reverse
  and .col-reverse globally, once per section instance.

  .custom-cta in particular COLLIDES with featured-collections.liquid,
  which uses the same class for its collection CTA. Whichever section
  rendered last won. Everything here is namespaced under .gs-ph.

  ------------------------------------------------------------------
  OTHER FIXES
  ------------------------------------------------------------------
  - Decorative chevrons are now aria-hidden. Seven of them announced as
    unlabelled graphics is noise for a screen reader.
  - .product-highlight-paragraph * universal selector replaced.
  - Arrow counts (7 horizontal, 6 vertical) remain hardcoded, as in v3.
    They are decorative; worth making settings if the pattern spreads.
  - t: keys -> English.

  All schema setting IDs are byte-for-byte identical to v3.
  ==================================================================
{% endcomment %}

{{ 'gs-product-highlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign img_desktop = s.image
  assign img_mobile = s.image_mobile | default: s.image
  assign has_cta = false
  if s.link_cta_1_text != blank or s.link_cta_2_text != blank
    assign has_cta = true
  endif
-%}

<div
  class="gs-ph"
  style="
    --ph-text-bg: {{ s.product_highlight_text_content_bg_color }};
    --ph-text-pad: {{ s.product_highlight_text_content_spacing_desktop }}px;
    --ph-text-pad-mobile: {{ s.product_highlight_text_content_spacing_mobile }}px;
    --ph-text-gap: {{ s.product_highlight_text_content_gap_desktop }}px;
    --ph-text-gap-mobile: {{ s.product_highlight_text_content_gap_mobile }}px;
    --ph-heading-color: {{ s.product_highlight_text_content_heading_color }};
    --ph-heading-size: {{ s.product_highlight_text_content_heading_font_size_desktop }}px;
    --ph-heading-size-mobile: {{ s.product_highlight_text_content_heading_font_size_mobile }}px;
    --ph-para-color: {{ s.product_highlight_text_content_paragraph_color }};
    --ph-para-size: {{ s.product_highlight_text_content_paragraph_font_size_desktop }}px;
    --ph-para-size-mobile: {{ s.product_highlight_text_content_paragraph_font_size_mobile }}px;
    --ph-cta-color: {{ s.product_highlight_text_content_link_cta_color }};
    --ph-cta-bg: {{ s.product_highlight_text_content_cta_bg_color | default: 'transparent' }};
    --ph-cta-border-color: {{ s.product_highlight_text_content_cta_border_color }};
    --ph-cta-border-width: {% if s.link_cta_style == 'button' %}{{ s.product_highlight_text_content_cta_border_width }}px{% else %}0px{% endif %};
    --ph-cta-size: {{ s.product_highlight_text_content_link_cta_text_font_size_desktop }}px;
    --ph-cta-size-mobile: {{ s.product_highlight_text_content_link_cta_text_font_size_mobile }}px;
    --ph-cta-gap: {{ s.product_highlight_text_link_cta_gap_desktop }}px;
    --ph-cta-gap-mobile: {{ s.product_highlight_text_link_cta_gap_mobile }}px;
    --ph-text-arrow-size: {{ s.product_highlight_text_content_arrows_size_desktop }}px;
    --ph-text-arrow-size-mobile: {{ s.product_highlight_text_content_arrows_size_mobile }}px;
    --ph-text-arrow-gap: {{ s.product_highlight_text_arrows_gap_between_desktop }}px;
    --ph-text-arrow-gap-mobile: {{ s.product_highlight_text_arrows_gap_between_mobile }}px;
    --ph-img-pad: {{ s.product_highlight_image_spacing_desktop }}px;
    --ph-img-pad-mobile: {{ s.product_highlight_image_spacing_mobile }}px;
    --ph-img-heading-color: {{ s.product_highlight_image_heading_color }};
    --ph-img-heading-size: {{ s.product_highlight_image_heading_font_size_desktop }}px;
    --ph-img-heading-size-mobile: {{ s.product_highlight_image_heading_font_size_mobile }}px;
    --ph-img-arrow-size: {{ s.product_highlight_image_arrows_size_desktop }}px;
    --ph-img-arrow-size-mobile: {{ s.product_highlight_image_arrows_size_mobile }}px;
    --ph-img-arrow-gap: {{ s.product_highlight_image_arrows_gap_between_desktop }}px;
    --ph-img-arrow-gap-mobile: {{ s.product_highlight_image_arrows_gap_between_mobile }}px;
    --ph-heading-arrow-gap: {{ s.product_highlight_heading_arrows_gap_desktop }}px;
    --ph-heading-arrow-gap-mobile: {{ s.product_highlight_heading_arrows_gap_mobile }}px;
  "
>
  <div class="gs-ph__flex{% if s.reverse_desktop %} gs-ph--row-reverse{% endif %}{% if s.reverse_mobile %} gs-ph--col-reverse{% endif %}">

    <div class="gs-ph__text{% if s.enable_product_highlight_text_content_arrows %} gs-ph__text--has-arrows{% endif %}">
      {%- if s.product_highlight_text_content_heading != blank -%}
        <h2 class="gs-ph__heading">{{ s.product_highlight_text_content_heading }}</h2>
      {%- endif -%}

      {%- if s.product_highlight_text_content_paragraph != blank -%}
        <div class="gs-ph__paragraph rte">{{ s.product_highlight_text_content_paragraph }}</div>
      {%- endif -%}

      {%- if has_cta -%}
        <div class="gs-ph__ctas{% if s.link_cta_layout == 'stacked' %} gs-ph__ctas--stacked{% endif %}">
          {%- if s.link_cta_1_text != blank -%}
            <a class="gs-ph__cta{% if s.link_cta_style == 'button' %} gs-ph__cta--button{% endif %}" href="{{ s.link_cta_1_link }}">
              {{- s.link_cta_1_text -}}
            </a>
          {%- endif -%}
          {%- if s.link_cta_2_text != blank -%}
            <a class="gs-ph__cta{% if s.link_cta_style == 'button' %} gs-ph__cta--button{% endif %}" href="{{ s.link_cta_2_link }}">
              {{- s.link_cta_2_text -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.enable_product_highlight_text_content_arrows -%}
        <div class="gs-ph__arrows gs-ph__arrows--horizontal" aria-hidden="true">
          {%- for i in (1..7) -%}
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path
                d="M100 0L50 50L100 100H50L0 50L50 0H100Z"
                {% if s.product_highlight_text_content_arrows_display == 'solid' %}
                  fill="{{ s.product_highlight_text_content_arrows_color }}"
                {% else %}
                  fill="none" stroke="{{ s.product_highlight_text_content_arrows_color }}" stroke-width="2"
                {% endif %}
              />
            </svg>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="gs-ph__image">
      {%- if img_desktop != blank -%}
        {%- comment -%}
          <picture> so only ONE image is fetched. v3 rendered both and
          toggled display, which still downloads both.
        {%- endcomment -%}
        <picture>
          <source
            media="(max-width: 768px)"
            srcset="
              {{ img_mobile | image_url: width: 600 }} 600w,
              {{ img_mobile | image_url: width: 900 }} 900w,
              {{ img_mobile | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
          <img
            class="gs-ph__img"
            src="{{ img_desktop | image_url: width: 1200 }}"
            srcset="
              {{ img_desktop | image_url: width: 900 }} 900w,
              {{ img_desktop | image_url: width: 1200 }} 1200w,
              {{ img_desktop | image_url: width: 1600 }} 1600w,
              {{ img_desktop | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 769px) 55vw, 100vw"
            alt="{{ img_desktop.alt | escape }}"
            width="{{ img_desktop.width }}"
            height="{{ img_desktop.height }}"
            loading="lazy"
          >
        </picture>
      {%- endif -%}

      {%- if s.product_highlight_image_heading != blank or s.enable_product_highlight_image_arrows -%}
        <div class="gs-ph__overlay">
          {%- if s.product_highlight_image_heading != blank -%}
            <div class="gs-ph__image-heading">{{ s.product_highlight_image_heading }}</div>
          {%- endif -%}

          {%- if s.enable_product_highlight_image_arrows -%}
            <div class="gs-ph__arrows gs-ph__arrows--vertical" aria-hidden="true">
              {%- for i in (1..6) -%}
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" focusable="false">
                  <path
                    d="M100 0L50 50L100 100H50L0 50L50 0H100Z"
                    transform="rotate(-90 50 50)"
                    {% if s.product_highlight_image_arrows_display == 'solid' %}
                      fill="{{ s.product_highlight_image_arrows_color }}"
                    {% else %}
                      fill="none" stroke="{{ s.product_highlight_image_arrows_color }}" stroke-width="2"
                    {% endif %}
                  />
                </svg>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Highlight",
  "tag": "section",
  "class": "section gs-ph-section",
  "settings": [
    { "type": "header", "content": "General" },
    { "type": "checkbox", "id": "reverse_desktop", "label": "Reverse layout (desktop)", "default": false },
    { "type": "checkbox", "id": "reverse_mobile", "label": "Reverse layout (mobile)", "default": false },
    { "type": "color", "id": "product_highlight_text_content_bg_color", "label": "Content background", "default": "#FFFFFF" },

    { "type": "header", "content": "Text panel" },
    { "type": "text", "id": "product_highlight_text_content_heading", "label": "Heading", "default": "Your Heading Here" },
    { "type": "color", "id": "product_highlight_text_content_heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "range", "id": "product_highlight_text_content_heading_font_size_desktop", "label": "Heading size (desktop)", "min": 12, "max": 96, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "product_highlight_text_content_heading_font_size_mobile", "label": "Heading size (mobile)", "min": 12, "max": 72, "step": 2, "unit": "px", "default": 24 },
    { "type": "richtext", "id": "product_highlight_text_content_paragraph", "label": "Paragraph", "default": "<p>Your description text here.</p>" },
    { "type": "color", "id": "product_highlight_text_content_paragraph_color", "label": "Paragraph color", "default": "#000000" },
    { "type": "range", "id": "product_highlight_text_content_paragraph_font_size_desktop", "label": "Paragraph size (desktop)", "min": 12, "max": 96, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "product_highlight_text_content_paragraph_font_size_mobile", "label": "Paragraph size (mobile)", "min": 12, "max": 72, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Buttons" },
    {
      "type": "select",
      "id": "link_cta_style",
      "label": "Style",
      "options": [
        { "value": "text", "label": "Text link" },
        { "value": "button", "label": "Button" }
      ],
      "default": "button"
    },
    { "type": "text", "id": "link_cta_1_text", "label": "Button 1 text", "default": "Learn More" },
    { "type": "url", "id": "link_cta_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "link_cta_2_text", "label": "Button 2 text", "default": "Shop Now" },
    { "type": "url", "id": "link_cta_2_link", "label": "Button 2 link" },
    {
      "type": "select",
      "id": "link_cta_layout",
      "label": "Button layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "side-by-side", "label": "Side by side" }
      ],
      "default": "side-by-side"
    },
    { "type": "color", "id": "product_highlight_text_content_link_cta_color", "label": "Button text", "default": "#000000" },
    {
      "type": "color",
      "id": "product_highlight_text_content_cta_bg_color",
      "label": "Button background",
      "info": "This setting existed in v3 but was never applied. It works now.",
      "default": "rgba(0,0,0,0)"
    },
    { "type": "color", "id": "product_highlight_text_content_cta_border_color", "label": "Button border", "default": "#000000" },
    { "type": "range", "id": "product_highlight_text_content_cta_border_width", "label": "Button border width", "min": 1, "max": 10, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "product_highlight_text_content_link_cta_text_font_size_desktop", "label": "Button size (desktop)", "min": 12, "max": 96, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "product_highlight_text_content_link_cta_text_font_size_mobile", "label": "Button size (mobile)", "min": 12, "max": 72, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "product_highlight_text_link_cta_gap_desktop", "label": "Gap between buttons (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_text_link_cta_gap_mobile", "label": "Gap between buttons (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },

    { "type": "header", "content": "Text panel spacing" },
    { "type": "range", "id": "product_highlight_text_content_spacing_desktop", "label": "Padding (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_text_content_spacing_mobile", "label": "Padding (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "product_highlight_text_content_gap_desktop", "label": "Gap between items (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_text_content_gap_mobile", "label": "Gap between items (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },

    { "type": "header", "content": "Text panel chevrons" },
    { "type": "checkbox", "id": "enable_product_highlight_text_content_arrows", "label": "Show chevrons", "default": false },
    {
      "type": "select",
      "id": "product_highlight_text_content_arrows_display",
      "label": "Chevron style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "product_highlight_text_content_arrows_color", "label": "Chevron color", "info": "Fill when solid, stroke when outline.", "default": "#000000" },
    { "type": "range", "id": "product_highlight_text_content_arrows_size_desktop", "label": "Chevron size (desktop)", "min": 2, "max": 128, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "product_highlight_text_content_arrows_size_mobile", "label": "Chevron size (mobile)", "min": 2, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "product_highlight_text_arrows_gap_between_desktop", "label": "Chevron gap (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_text_arrows_gap_between_mobile", "label": "Chevron gap (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },

    { "type": "header", "content": "Image panel" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional - falls back to the desktop image." },
    { "type": "text", "id": "product_highlight_image_heading", "label": "Image heading" },
    { "type": "color", "id": "product_highlight_image_heading_color", "label": "Image heading color", "default": "#000000" },
    { "type": "range", "id": "product_highlight_image_heading_font_size_desktop", "label": "Image heading size (desktop)", "min": 12, "max": 96, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "product_highlight_image_heading_font_size_mobile", "label": "Image heading size (mobile)", "min": 12, "max": 72, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "product_highlight_image_spacing_desktop", "label": "Image content padding (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_image_spacing_mobile", "label": "Image content padding (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },

    { "type": "header", "content": "Image panel chevrons" },
    { "type": "checkbox", "id": "enable_product_highlight_image_arrows", "label": "Show chevrons", "default": false },
    {
      "type": "select",
      "id": "product_highlight_image_arrows_display",
      "label": "Chevron style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "outline"
    },
    { "type": "color", "id": "product_highlight_image_arrows_color", "label": "Chevron color", "default": "#000000" },
    { "type": "range", "id": "product_highlight_image_arrows_size_desktop", "label": "Chevron size (desktop)", "min": 2, "max": 128, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "product_highlight_image_arrows_size_mobile", "label": "Chevron size (mobile)", "min": 2, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "product_highlight_image_arrows_gap_between_desktop", "label": "Chevron gap (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_image_arrows_gap_between_mobile", "label": "Chevron gap (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 },
    { "type": "range", "id": "product_highlight_heading_arrows_gap_desktop", "label": "Gap between heading and chevrons (desktop)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "product_highlight_heading_arrows_gap_mobile", "label": "Gap between heading and chevrons (mobile)", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 25 }
  ],
  "presets": [{ "name": "Product Highlight" }]
}
{% endschema %}
