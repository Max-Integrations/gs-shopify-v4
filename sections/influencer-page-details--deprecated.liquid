          "label": "Profile URL"
        }
      ]
    },
    {
      "name": "YouTube",
      "type": "youtube",
      "limit": 1,
      "settings": [
        {
          "type": "url",
          "id": "youtube_handle",
          "label": "Profile URL"
        }
      ]
    }
