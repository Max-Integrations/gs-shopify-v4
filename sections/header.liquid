              -%}
              {%- capture icon_svg -%}
                {%- case block.settings.icon -%}
                  {%- when 'accessibility' -%}
                    {%- comment -%}v3 snippets/header-icons.liquid wheelchair glyph{%- endcomment -%}
                    <svg viewBox="0 0 100 100" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M50.44,31.82c4.66,0,8.45-3.79,8.45-8.46s-3.79-8.46-8.45-8.46-8.46,3.79-8.46,8.46,3.79,8.46,8.46,8.46ZM50.44,18.14c2.87,0,5.21,2.34,5.21,5.22s-2.34,5.22-5.21,5.22-5.22-2.34-5.22-5.22,2.34-5.22,5.22-5.22Z"/><path d="M67.63,30.23h0c-11.54,3.37-23.73,3.38-35.26,0-2.55-.75-5.28.61-6.19,3.11-.49,1.34-.4,2.77.23,4.02.63,1.25,1.72,2.17,3.08,2.58,2.56.75,5.2,1.37,7.83,1.84,1.28.23,2.58.42,3.88.58-.04,2.86-.22,10.27-1.06,15.61-1.09,6.97-2.96,12.53-5.54,16.54-1.32,2.05-.99,4.74.78,6.41,1.1,1.04,2.59,1.55,4.08,1.36,1.49-.17,2.82-1,3.66-2.29,3.22-5,5.54-11.58,6.88-19.59,1.35,7.99,3.66,14.58,6.89,19.59.82,1.27,2.15,2.1,3.65,2.29.21.02.41.04.62.04,1.29,0,2.53-.49,3.47-1.39,1.76-1.67,2.09-4.36.78-6.41-2.58-3.99-4.44-9.56-5.54-16.54-.89-5.61-1.04-13.52-1.06-15.61,1.3-.16,2.6-.35,3.88-.58,2.64-.47,5.27-1.09,7.83-1.84,1.35-.4,2.44-1.32,3.07-2.58.64-1.28.72-2.71.23-4.02-.91-2.49-3.62-3.86-6.18-3.11ZM70.69,35.91c-.23.46-.61.78-1.09.92-2.44.72-4.96,1.31-7.48,1.76-1.38.24-2.8.45-4.18.61-1.35.14-2.37,1.28-2.37,2.65,0,1.02.08,10.11,1.1,16.62,1.17,7.43,3.2,13.42,6.02,17.79.47.74.35,1.71-.28,2.31-.4.38-.91.56-1.46.49-.55-.07-1.02-.36-1.32-.83-3.1-4.8-5.3-11.26-6.55-19.19-.15-1.01-.3-2.04-.42-3.09-.16-1.33-1.3-2.33-2.64-2.33s-2.48,1-2.64,2.34c-.12,1.04-.27,2.09-.42,3.08-1.25,7.94-3.46,14.4-6.54,19.19-.31.47-.79.77-1.32.83-.54.06-1.08-.12-1.48-.5-.64-.6-.75-1.56-.28-2.3,2.83-4.39,4.86-10.38,6.02-17.8.93-5.93,1.08-14.22,1.1-16.61.02-1.36-.99-2.51-2.35-2.67-1.41-.16-2.82-.37-4.2-.61-2.51-.45-5.03-1.04-7.47-1.75-.49-.15-.88-.48-1.11-.93-.23-.46-.26-.96-.08-1.45.33-.89,1.31-1.38,2.24-1.11,12.04,3.53,24.77,3.56,36.83.07l.24-.06c.92-.27,1.91.22,2.24,1.12.18.47.15.97-.09,1.45Z"/><path d="M50,0C22.43,0,0,22.43,0,50s22.43,50,50,50,50-22.43,50-50S77.57,0,50,0ZM50,91.9c-23.1,0-41.9-18.8-41.9-41.9S26.9,8.1,50,8.1s41.9,18.8,41.9,41.9-18.8,41.9-41.9,41.9Z"/></svg>
                  {%- when 'headset' -%}
                    {%- comment -%}v3 snippets/header-icons.liquid headset glyph{%- endcomment -%}
                    <svg viewBox="0 0 100 100" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M98.83,70.42l-3.95-18.64s-.01-.05-.02-.07c-.35-1.59-1.27-2.94-2.51-3.91.04-.26.09-.52.13-.78l.02-.24c0-4.85-.83-9.51-2.33-13.86.97-.96,1.33-2.45.79-3.79C84.24,12.34,67.63,1.06,49.63,1.06S14.63,12.58,8.05,29.72c-.61,1.6.02,3.36,1.43,4.23-1.29,4.05-1.98,8.36-1.98,12.83l.17,1c-1.25.98-2.18,2.34-2.53,3.93,0,.02-.01.05-.02.07l-3.95,18.64c-.09.44-.17.88-.16,1.32.05,3.06,1.9,6.12,4.53,6.72,2.48.57,5.26.33,12.3,1.66,1.87.35,5.8-.77,7.48-2.08,1.84-1.44-.04-6.5-.62-8.33l-6-18.77c-1.18-3.69-2.43-6.22-6.1-5.04l-2.08.5s-.01,0-.02,0c.04-4.25.76-8.33,2.04-12.16.9-.34,1.67-1.04,2.04-2.01,5.55-14.46,19.63-24.17,35.04-24.17s29.17,9.51,34.84,23.67c.5,1.24,1.63,2.02,2.87,2.16,1.36,3.93,2.12,8.13,2.16,12.51,0,0-.01,0-.02,0l-2.08-.5c-3.67-1.17-4.92,1.35-6.1,5.04l-6,18.77c-.58,1.83-2.46,6.89-.62,8.33,1.23.97,3.69,1.82,5.64,2.07-.36.92-.71,1.8-1.04,2.63-1.69,4.19-4.88,9.18-10.46,9.18l-9.98-.12h-.02v-.24c0-2.15-1.76-3.92-3.92-3.92h-10.78c-2.15,0-3.92,1.76-3.92,3.92v3.47c0,2.15,1.76,3.92,3.92,3.92h10.78c2.15,0,3.92-1.76,3.92-3.92v-.24l9.98.12c5.75,0,10.34-3.82,13.25-11.06.49-1.23,1.02-2.57,1.57-4.01,5.96-1.03,8.52-.87,10.82-1.39,2.63-.6,4.49-3.66,4.53-6.72,0-.45-.07-.89-.16-1.32Z"/></svg>
                  {%- when 'help' -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
                      <path d="M9.5 9a2.5 2.5 0 115 .5c0 1.5-2.5 2-2.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      <circle cx="12" cy="17" r="1" fill="currentColor"/>
                    </svg>
                  {%- when 'pin' -%}
                    {%- comment -%}v3 snippets/header-icons.liquid retail-store pin glyph{%- endcomment -%}
                    <svg viewBox="-16 0 100 100" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M34.02,0C15.26,0,0,15.26,0,34.03c0,23.95,15.67,50.03,31.14,63.41l2.97,2.57,2.89-2.66c12.48-11.47,31.04-37.79,31.04-63.32C68.05,15.26,52.78,0,34.02,0ZM33.94,88.03c-12.68-12.48-25.13-34.45-25.13-54,0-13.9,11.31-25.22,25.21-25.22s25.22,11.31,25.22,25.22c0,18.67-12.55,40.88-25.3,54Z"/><path d="M34.02,20.33c-8.52,0-15.46,6.93-15.46,15.46s6.93,15.46,15.46,15.46,15.46-6.93,15.46-15.46-6.93-15.46-15.46-15.46ZM34.02,47.72c-6.58,0-11.93-5.35-11.93-11.93s5.35-11.93,11.93-11.93,11.93,5.35,11.93,11.93-5.35,11.93-11.93,11.93Z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                      <path d="M12 2l2.9 6.3 6.9.8-5 4.7 1.3 6.8L12 17.4 5.9 20.6 7.2 13.8l-5-4.7 6.9-.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                    </svg>
                {%- endcase -%}
              {%- endcapture -%}

              {%- if block.settings.behaviour == 'accessibility' -%}
                {%- comment -%}
                  accessiBe binds .acsb-trigger as its opener (its own
                  floating button is hidden by gs-accessibe.js).
                {%- endcomment -%}
                <button type="button" class="{{ icon_classes }} acsb-trigger" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
                  {{ icon_svg }}
                </button>
              {%- elsif block.settings.link != blank -%}
                <a class="{{ icon_classes }}" href="{{ block.settings.link }}" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
                  {{ icon_svg }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        {%- if s.show_search and search_show != 'desktop' and search_show != 'none' -%}
          {%- comment -%}
            Mobile only: drops the search field under the top row.
          {%- endcomment -%}
          <button
            type="button"
            class="gs-header__icon gs-header__icon--mobile"
            data-gs-search-toggle
            aria-expanded="false"
            aria-controls="GsHeaderSearchWrap-{{ section.id }}"
            aria-label="{{ 'general.search.search' | t }}"
          >
            <svg viewBox="0 0 18 19" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.72l5.4 5.4a.5.5 0 01-.71.7l-5.41-5.38z" fill="currentColor" fill-rule="evenodd"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          {%- comment -%}
            .gs-header__account is the stable hook for Swym's wishlist
            launcher selector (Theme settings > Swym Wishlist Launcher
            Button: .gs-header__icons .gs-header__account). The href is
            /customer_authentication/redirect with new customer accounts,
            so an href-based selector does not work here.
          {%- endcomment -%}
          <a
            class="gs-header__icon gs-header__account{{ account_vis_class }}"
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            aria-label="{%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}"
          >
            {%- comment -%}v3 snippets/header-icons.liquid account glyph{%- endcomment -%}
            <svg viewBox="0 0 100 100" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M50,0C22.43,0,0,22.43,0,50s22.43,50,50,50,50-22.43,50-50S77.57,0,50,0ZM34.08,41.02c0-8.78,7.14-15.92,15.92-15.92s15.92,7.14,15.92,15.92-7.14,15.92-15.92,15.92-15.92-7.14-15.92-15.92ZM69.16,41.02c0-10.57-8.6-19.16-19.16-19.16s-19.16,8.6-19.16,19.16c0,8.41,5.45,15.55,13,18.12-10.82,1.66-20.41,7.66-26.68,16.83-5.66-7.15-9.05-16.17-9.05-25.97,0-23.1,18.8-41.9,41.9-41.9s41.9,18.8,41.9,41.9c0,9.8-3.39,18.83-9.06,25.97-6.27-9.17-15.86-15.17-26.68-16.83,7.55-2.57,13-9.72,13-18.12ZM50,61.89c12.51,0,23.86,6.2,30.64,16.64-7.65,8.21-18.56,13.36-30.64,13.36s-22.99-5.15-30.64-13.36c6.78-10.44,18.13-16.64,30.64-16.64Z"/></svg>
          </a>
        {%- endif -%}

        <a
          class="gs-header__icon gs-header__cart{{ cart_vis_class }}"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'templates.cart.cart' | t }}"
          {% if settings.cart_type == 'drawer' %}id="cart-icon-bubble"{% endif %}
        >
          {%- comment -%}
            v3 snippets/header-icons.liquid cart glyph. The cart drawer swaps
            this link's contents for sections/cart-icon-bubble.liquid after
            each add; keep the two identical.
          {%- endcomment -%}
          <svg viewBox="0 0 100 100" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M99.96,90.12l-5.73-62.32c-.35-3.8-3.49-6.66-7.3-6.66h-13.75v-6.31c0-7.9-6.43-14.33-14.33-14.33-3.82,0-7.29,1.51-9.87,3.96-2.3-1.57-5.08-2.5-8.07-2.5-7.9,0-14.33,6.43-14.33,14.33v4.85h-12.78c-3.77,0-6.91,2.83-7.29,6.58L.05,90.02c-.25,2.42.54,4.84,2.17,6.65s3.96,2.84,6.39,2.84h82.78c2.41,0,4.73-1.02,6.36-2.81,1.63-1.78,2.43-4.19,2.21-6.59ZM70.26,14.82v6.31h-15.01v-4.85c0-3.85-1.54-7.35-4.02-9.93,2.02-1.82,4.69-2.94,7.62-2.94,6.29,0,11.41,5.12,11.41,11.41ZM49.3,8.59c1.86,2.03,3.01,4.73,3.01,7.7v4.85h-4.88v-6.31c0-2.3.69-4.44,1.87-6.24ZM29.5,16.29c0-6.29,5.12-11.41,11.41-11.41,2.27,0,4.37.67,6.15,1.81-1.6,2.31-2.54,5.11-2.54,8.13v6.31h-15.01v-4.85ZM92.35,91.78c-.14.16-.46.42-.96.42h-18.21v-57.95c0-.81-.65-1.46-1.46-1.46s-1.46.65-1.46,1.46v57.95H8.61c-.5,0-.82-.27-.96-.43-.14-.16-.38-.5-.33-1l6.47-62.32h12.78v5.6c-3.4.68-5.96,3.68-5.96,7.28,0,4.1,3.33,7.43,7.42,7.43s7.43-3.33,7.43-7.43c0-3.59-2.57-6.6-5.96-7.28v-5.6h22.82v5.6c-3.4.68-5.96,3.68-5.96,7.28,0,4.1,3.33,7.43,7.42,7.43s7.42-3.33,7.42-7.43c0-3.59-2.57-6.59-5.96-7.28v-5.6h6.5l25.21.02,5.73,62.32c.04.5-.19.84-.33.99ZM28.04,36.82c2.48,0,4.5,2.02,4.5,4.5s-2.02,4.5-4.5,4.5-4.5-2.02-4.5-4.5,2.02-4.5,4.5-4.5ZM53.78,36.82c2.48,0,4.5,2.02,4.5,4.5s-2.02,4.5-4.5,4.5-4.5-2.02-4.5-4.5,2.02-4.5,4.5-4.5Z"/></svg>
          <span class="gs-header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" aria-hidden="true">
            {{- cart.item_count -}}
          </span>
          <span class="visually-hidden">
            {{ 'sections.header.cart_count' | t: count: cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </div>

  {%- comment -%}
    ------------------------------------------------------------------
    MOBILE DRAWER (2026-10-20)
    ------------------------------------------------------------------
    A port of v3's snippets/mobile-menu.liquid so phones get the same
    menu as live: a full-height light panel under the header with the
    main menu as uppercase accordions (three levels), v3's four
    hard-coded utility links, then a grey block built from the three
    footer menus. The desktop mega-menu nav below is untouched and is
    hidden on phones while this is open (gs-header.css, .gs-mnav).
    Accordion + open/close handling is in the script at the bottom.
  {%- endcomment -%}
  {%- if menu != blank -%}
    {%- capture gs_mnav_chevron -%}<svg viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
    <div class="gs-mnav" id="GsMobileNav">
      <div class="gs-mnav__primary">
        <ul class="gs-mnav__list">
          {%- for link in menu.links -%}
            <li class="gs-mnav__item">
              <div class="gs-mnav__row gs-mnav__row--top">
                <a class="gs-mnav__link" href="{{ link.url }}">{{ link.title | escape }}</a>
                {%- if link.links.size > 0 -%}
                  <button type="button" class="gs-mnav__toggle" aria-expanded="false" aria-label="Expand {{ link.title | escape }}" data-gs-mnav-toggle>{{ gs_mnav_chevron }}</button>
                {%- endif -%}
              </div>
              {%- if link.links.size > 0 -%}
                <ul class="gs-mnav__sub" hidden>
                  {%- for child in link.links -%}
                    <li class="gs-mnav__subitem">
                      {%- if child.links.size > 0 -%}
                        <div class="gs-mnav__row gs-mnav__row--group">
                          <a class="gs-mnav__group-link" href="{{ child.url }}">{{ child.title | escape }}</a>
                          <button type="button" class="gs-mnav__toggle" aria-expanded="false" aria-label="Expand {{ child.title | escape }}" data-gs-mnav-toggle>{{ gs_mnav_chevron }}</button>
                        </div>
                        <ul class="gs-mnav__sub2" hidden>
                          {%- for grandchild in child.links -%}
                            <li><a class="gs-mnav__sublink" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <a class="gs-mnav__sublink" href="{{ child.url }}">{{ child.title | escape }}</a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- comment -%} v3 hard-coded these four after the menu (mobile-menu.liquid). {%- endcomment -%}
          {%- assign gs_mnav_extra = 'Store Locator|/pages/grunt-style-retail-stores,Subscribe to Intel|/pages/subscribe,My Wishlists|/pages/my-wishlist,Order Custom Apparel|/pages/custom-orders' | split: ',' -%}
          {%- for pair in gs_mnav_extra -%}
            {%- assign parts = pair | split: '|' -%}
            <li class="gs-mnav__item">
              <div class="gs-mnav__row gs-mnav__row--top">
                <a class="gs-mnav__link" href="{{ parts[1] }}">{{ parts[0] }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Grey block: the three footer menus as accordions, as on live. {%- endcomment -%}
      <div class="gs-mnav__secondary">
        <ul class="gs-mnav__list">
          {%- assign gs_mnav_footer = 'customer-service,footer-menu-2021-policies,footer-menu-2021-about-us' | split: ',' -%}
          {%- for handle in gs_mnav_footer -%}
            {%- assign footer_list = linklists[handle] -%}
            {%- if footer_list.links.size > 0 -%}
              <li class="gs-mnav__item">
                <div class="gs-mnav__row gs-mnav__row--small">
                  <span class="gs-mnav__link">{{ footer_list.title | replace: 'Footer-Menu-2021', '' | replace: 'Footer Menu-2021', '' | strip | escape }}</span>
                  <button type="button" class="gs-mnav__toggle" aria-expanded="false" aria-label="Expand {{ footer_list.title | escape }}" data-gs-mnav-toggle>{{ gs_mnav_chevron }}</button>
                </div>
                <ul class="gs-mnav__sub" hidden>
                  {%- for l in footer_list.links -%}
                    <li><a class="gs-mnav__sublink" href="{{ l.url }}">{{ l.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  {%- if menu != blank -%}
    <nav class="gs-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <div class="page-width">
        <ul class="gs-header__nav-list" id="GsDesktopNav">
          {%- for link in menu.links -%}
            {%- liquid
              assign link_title_down = link.title | downcase | strip

              # Title-string match, as in v3. See the header note.
              assign is_highlight = false
              if highlight_match != '' and link_title_down == highlight_match
                assign is_highlight = true
              endif

              # Count matching promo blocks so the column is only rendered
              # when there is something to put in it.
              assign promo_count = 0
              for promo in mega_blocks
                assign promo_title = promo.settings.menu_title | downcase | strip
                if promo_title == link_title_down and promo.settings.nav_image != blank
                  assign promo_count = promo_count | plus: 1
                endif
              endfor
            -%}

            {%- if link.links.size > 0 -%}
              <li class="gs-header__nav-item gs-header__nav-item--has-children{% if is_highlight %} gs-header__nav-item--highlight{% endif %}">
                <details class="gs-mega" data-gs-mega>
                  <summary class="gs-header__nav-link" data-gs-mega-url="{{ link.url }}">
                    {{- link.title -}}
                    <svg class="gs-header__nav-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false">
                      <path d="M11 1L6 6L1 1" stroke="currentColor" stroke-width="2" fill="none"/>
                    </svg>
                  </summary>

                  <div class="gs-mega__panel">
                    <div class="page-width gs-mega__inner{% if promo_count == 0 %} gs-mega__inner--no-promo{% endif %}">
                      {%- if promo_count > 0 -%}
                        <div class="gs-mega__promo gs-mega__promo--{{ promo_count }}">
                          {%- for promo in mega_blocks -%}
                            {%- liquid
                              assign promo_title = promo.settings.menu_title | downcase | strip
                              if promo_title != link_title_down
                                continue
                              endif
                              if promo.settings.nav_image == blank
                                continue
                              endif
                              assign promo_img = promo.settings.nav_image
                            -%}
                            <a
                              class="gs-mega__tile"
                              href="{{ promo.settings.nav_link | default: link.url }}"
                              {{ promo.shopify_attributes }}
                            >
                              <img
                                src="{{ promo_img | image_url: width: 600 }}"
                                srcset="{{ promo_img | image_url: width: 400 }} 400w, {{ promo_img | image_url: width: 600 }} 600w"
                                sizes="300px"
                                alt="{{ promo_img.alt | escape | default: promo.settings.nav_label | escape }}"
                                width="{{ promo_img.width }}"
                                height="{{ promo_img.height }}"
                                loading="lazy"
                              >
                              {%- if promo.settings.nav_label != blank -%}
                                <span class="gs-mega__tile-label">{{ promo.settings.nav_label }}</span>
                              {%- endif -%}
                            </a>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      <div class="gs-mega__columns">
                        {%- for child in link.links -%}
                          <div class="gs-mega__column">
                            <a class="gs-mega__column-title" href="{{ child.url }}">{{ child.title }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="gs-mega__sublist">
                                {%- for grandchild in child.links -%}
                                  <li>
                                    <a class="gs-mega__sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            {%- else -%}
              <li class="gs-header__nav-item{% if is_highlight %} gs-header__nav-item--highlight{% endif %}">
                <a
                  class="gs-header__nav-link"
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
          {%- if s.account_in_mobile_menu and shop.customer_accounts_enabled -%}
            <li class="gs-header__nav-item gs-header__nav-item--mobile-only gs-header__nav-item--account">
              <a
                class="gs-header__nav-link"
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              >
                {%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </nav>
  {%- endif -%}
</header>

<script>
  (function () {
    if (window.gsHeaderBound) return;
    window.gsHeaderBound = true;

    // Desktop with a real pointer: hover opens, the label is a link.
    var hoverNav = window.matchMedia('(min-width: 990px) and (hover: hover)');
    var closeTimer = null;   // closes every menu after the pointer leaves the nav
    var switchTimer = null;  // pending switch to another tab while one is open

    function openMega() {
      return document.querySelector('details[data-gs-mega][open]');
    }

    function closeAllMega(except) {
      document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
        if (d !== except) d.open = false;
      });
    }

    function cancelClose() { clearTimeout(closeTimer); closeTimer = null; }
    function cancelSwitch() { clearTimeout(switchTimer); switchTimer = null; }

    function bindHover(details) {
      if (details.gsHoverBound) return;
      details.gsHoverBound = true;

      details.addEventListener('mouseenter', function () {
        if (!hoverNav.matches) return;
        cancelClose();
        cancelSwitch();
        if (details.open) return;
        if (!openMega()) {
          closeAllMega(details);
          details.open = true;
          return;
        }
        // Another menu is open: only take over once the pointer has
        // settled here, so a diagonal move into a panel that clips a
        // neighbouring label does not swap menus under the cursor.
        switchTimer = setTimeout(function () {
          switchTimer = null;
          closeAllMega(details);
          details.open = true;
        }, 120);
      });

      details.addEventListener('mouseleave', function () {
        if (!hoverNav.matches) return;
        cancelSwitch();
      });
    }

    // The nav (panels included, they are descendants) is the hover
    // region. Leaving it closes after a short grace; re-entering cancels.
    function bindNav(nav) {
      if (nav.gsNavBound) return;
      nav.gsNavBound = true;

      nav.addEventListener('mouseenter', function () {
        if (hoverNav.matches) cancelClose();
      });

      nav.addEventListener('mouseleave', function () {
        if (!hoverNav.matches) return;
        cancelSwitch();
        cancelClose();
        closeTimer = setTimeout(function () {
          closeTimer = null;
          closeAllMega(null);
        }, 200);
      });
    }

    function bindAll() {
      document.querySelectorAll('details[data-gs-mega]').forEach(bindHover);
      document.querySelectorAll('.gs-header__nav').forEach(bindNav);
      bindSticky();
    }

    document.addEventListener('click', function (evt) {
      if (!evt.target || !evt.target.closest) return;

      // Hover already opened the panel, so a mouse click on the label goes
      // to the parent link instead of collapsing the menu under the cursor.
      // evt.detail is 0 for Enter/Space, which must keep toggling.
      var megaLabel = evt.target.closest('summary[data-gs-mega-url]');
      if (megaLabel && hoverNav.matches && evt.detail > 0) {
        var url = megaLabel.getAttribute('data-gs-mega-url');
        if (url && url !== '#' && url !== '') {
          evt.preventDefault();
          window.location.href = url;
          return;
        }
      }

      // Mobile drawer accordions (see the MOBILE DRAWER note).
      var mnavToggle = evt.target.closest('[data-gs-mnav-toggle]');
      if (mnavToggle) {
        var mnavRow = mnavToggle.parentElement;
        var mnavPanel = mnavRow.nextElementSibling;
        var mnavOpen = mnavToggle.getAttribute('aria-expanded') === 'true';
        mnavToggle.setAttribute('aria-expanded', mnavOpen ? 'false' : 'true');
        mnavRow.classList.toggle('is-open', !mnavOpen);
        if (mnavPanel) mnavPanel.hidden = mnavOpen;
        return;
      }

      var toggle = evt.target.closest('[data-gs-nav-toggle]');
      if (toggle) {
        var header = toggle.closest('.gs-header');
        var open = header.classList.toggle('gs-header--nav-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        // The drawer is fixed under the header (announcement bar included),
        // so hand it the header's bottom edge and lock page scroll behind it.
        document.documentElement.style.setProperty('--gs-mnav-top', Math.round(header.getBoundingClientRect().bottom) + 'px');
        document.body.classList.toggle('gs-mnav-open', open);
        return;
      }

      // Mobile search toggle: the field is always in the DOM (desktop
      // shows it inline); this drops it under the top row and focuses it.
      var searchToggle = evt.target.closest('[data-gs-search-toggle]');
      if (searchToggle) {
        var searchHeader = searchToggle.closest('.gs-header');
        var searchOpen = searchHeader.classList.toggle('gs-header--search-open');
        searchToggle.setAttribute('aria-expanded', searchOpen ? 'true' : 'false');
        if (searchOpen) {
          var searchInput = searchHeader.querySelector('.gs-header__search-input');
          if (searchInput) searchInput.focus();
        }
        return;
      }

      // Only one mega menu open at a time.
      var summary = evt.target.closest('.gs-mega > summary');
      document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
        if (!summary || d !== summary.parentElement) d.open = false;
      });

      if (!evt.target.closest('.gs-mega')) closeAllMega(null);
    });

    document.addEventListener('keydown', function (evt) {
      if (evt.key !== 'Escape') return;
      document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
        d.open = false;
        var summary = d.querySelector('summary');
        if (summary) summary.focus();
      });
      document.querySelectorAll('.gs-header--search-open').forEach(function (h) {
        h.classList.remove('gs-header--search-open');
        var t = h.querySelector('[data-gs-search-toggle]');
        if (t) {
          t.setAttribute('aria-expanded', 'false');
          t.focus();
        }
      });
    });

    // ---- Sticky: hide on scroll down, return on scroll up ----
    function bindSticky() {
      var header = document.querySelector('.gs-header[data-gs-sticky]');
      var section = header && header.closest('.shopify-section');
      if (!header || !section || section.gsStickyBound) return;
      section.gsStickyBound = true;

      var onScroll = header.getAttribute('data-gs-sticky') === 'on_scroll';
      var lastY = window.scrollY;
      var raf = null;

      function setHeight() {
        document.body.style.setProperty('--gs-header-height', header.offsetHeight + 'px');
      }

      // Never hide while something in the header is in use.
      function busy() {
        if (header.classList.contains('gs-header--nav-open')) return true;
        if (openMega()) return true;
        var active = document.activeElement;
        return !!(active && header.contains(active) && active.tagName === 'INPUT');
      }

      function paint() {
        raf = null;
        var y = window.scrollY;
        section.classList.toggle('gs-header-section--stuck', y > 0);
        if (onScroll) {
          if (busy() || y <= header.offsetHeight) {
            section.classList.remove('gs-header-section--hidden');
          } else if (y > lastY + 2) {
            section.classList.add('gs-header-section--hidden');
          } else if (y < lastY - 2) {
            section.classList.remove('gs-header-section--hidden');
          }
        }
        lastY = y;
      }

      window.addEventListener('scroll', function () {
        if (!raf) raf = window.requestAnimationFrame(paint);
      }, { passive: true });
      window.addEventListener('resize', setHeight);
      setHeight();
      paint();
    }

    bindAll();
    document.addEventListener('shopify:section:load', bindAll);
  })();
</script>

{% schema %}
{
  "name": "Header",
  "class": "gs-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Mobile logo",
      "info": "Shown below 990px instead of the main logo. The live store uses the stacked crest (Primary_Logo_White.png) here."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width (desktop)",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Logo width (mobile)",
      "min": 70,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 130
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "label": "Sticky behaviour",
      "info": "As v3: hide while scrolling down, return on the way up.",
      "options": [
        { "value": "on_scroll", "label": "Show when scrolling up" },
        { "value": "always", "label": "Always visible" }
      ],
      "default": "on_scroll",
      "visible_if": "{{ section.settings.sticky_header }}"
    },
    {
      "type": "header",
      "content": "Highlighted nav item"
    },
    {
      "type": "checkbox",
      "id": "highlight_enable",
      "label": "Highlight a nav item",
      "info": "Gives one menu item a coloured tab, like the red BOGO 50% on the live site.",
      "default": true
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Menu item title to highlight",
      "info": "Must match the menu item title exactly. Renaming the item in the Shopify menu silently removes the highlight.",
      "default": "BOGO 50%"
    },
    {
      "type": "color",
      "id": "highlight_background",
      "label": "Highlight background",
      "default": "#ab192d"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Highlight text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search field",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "What are you looking for..."
    },
    {
      "type": "select",
      "id": "search_visibility",
      "label": "Show search on",
      "info": "Desktop shows the search field; mobile shows the search icon. Desktop is 990px and wider.",
      "options": [
        { "value": "all", "label": "All screen sizes" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Account and cart icons"
    },
    {
      "type": "select",
      "id": "account_visibility",
      "label": "Show account icon on",
      "info": "Desktop is 990px and wider.",
      "options": [
        { "value": "all", "label": "All screen sizes" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "all"
    },
    {
      "type": "checkbox",
      "id": "account_in_mobile_menu",
      "label": "Add Account / Log in link to the mobile menu",
      "default": false
    },
    {
      "type": "select",
      "id": "cart_visibility",
      "label": "Show cart icon on",
      "options": [
        { "value": "all", "label": "All screen sizes" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "nav_background",
      "label": "Nav row background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "header_text",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_text_hover",
      "label": "Text hover",
      "default": "#e7e7e7"
    },
    {
      "type": "color",
      "id": "header_icon",
      "label": "Icons",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cart_count_background",
      "label": "Cart count background",
      "info": "The live store uses brand red #AB192D.",
      "default": "#ab192d"
    },
    {
      "type": "color",
      "id": "cart_count_text",
      "label": "Cart count text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Mega menu"
    },
    {
      "type": "color",
      "id": "mega_background",
      "label": "Panel background",
      "info": "The panel inverts against the header - white on the live site.",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mega_text",
      "label": "Panel text",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "nav_menu_img",
      "name": "Mega menu image",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu item title",
          "info": "Must match the top-level menu item title exactly. Add several blocks with the same title to show multiple tiles."
        },
        {
          "type": "image_picker",
          "id": "nav_image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "nav_link",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "nav_label",
          "label": "Caption",
          "info": "Optional. Shown over the image."
        }
      ]
    },
    {
      "type": "utility_link",
      "name": "Icon link",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "accessibility",
              "label": "Accessibility"
            },
            {
              "value": "headset",
              "label": "Headset (customer service)"
            },
            {
              "value": "pin",
              "label": "Map pin (stores)"
            },
            {
              "value": "star",
              "label": "Star (rewards)"
            },
            {
              "value": "help",
              "label": "Question mark (help)"
            }
          ],
          "default": "star"
        },
        {
          "type": "select",
          "id": "behaviour",
          "label": "Action",
          "options": [
            {
              "value": "link",
              "label": "Go to the link"
            },
            {
              "value": "accessibility",
              "label": "Open the accessibility menu (accessiBe)"
            }
          ],
          "default": "link",
          "info": "The accessibility action needs accessiBe enabled in Theme settings > Grunt Style features."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Accessible label",
          "default": "Rewards"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "show_on",
          "label": "Show on",
          "info": "On mobile this icon sits beside the menu button, left of the logo (as on the live site). Desktop is 990px and wider.",
          "options": [
            { "value": "desktop", "label": "Desktop only" },
            { "value": "mobile", "label": "Mobile only" },
            { "value": "all", "label": "All screen sizes" }
          ],
          "default": "desktop"
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Also show on mobile (old setting)",
          "info": "Replaced by Show on. While ticked, Desktop only still shows on mobile; untick it to use Show on alone.",
          "default": false,
          "visible_if": "{{ block.settings.show_on_mobile }}"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
