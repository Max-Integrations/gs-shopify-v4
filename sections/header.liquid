{% comment %}
  ==================================================================
  GS HEADER
  ==================================================================
  REBUILT, NOT PORTED. v3's sections/header.liquid is 107 KB and carries
  a retail store locator, an ADA compliance widget, a contact-us panel
  and a store-details dropdown layered onto one another over years.

  Structure:
      row 1   logo | search | icon row
      row 2   primary nav with mega menus

  The announcement bar is a separate section in header-group.json.

  ------------------------------------------------------------------
  HIGHLIGHTED NAV ITEM (the red BOGO 50% tab)
  ------------------------------------------------------------------
  v3 drives this from theme settings, found in its settings_data.json:

      holiday_link_highlight_enable: true
      matching_holiday_link_text:    "BOGO 50%"
      holiday_link_bg_color:         "#ab192d"

  Matching is on the nav item's TITLE STRING, the same fragile pattern
  the mega menu images use - rename the item in the Shopify menu and the
  highlight silently stops applying. Kept deliberately so the existing
  configuration carries over, but it is worth knowing during a nav
  reshuffle.

  Those are theme settings in v3 and section settings here, because the
  Dawn settings_schema.json has no entries for them.

  ------------------------------------------------------------------
  MEGA MENU: MULTIPLE PROMO TILES PER NAV ITEM
  ------------------------------------------------------------------
  v3 supported ONE image per nav item. This renders EVERY nav_menu_img
  block whose menu_title matches, so a nav item can carry two or three
  tiles - a drop alongside a category - instead of one.

  Block type and setting ids are unchanged (menu_title, nav_image,
  nav_link), so v3's seven configured blocks migrate untouched and render
  as single tiles. `nav_label` is new and optional.

  ------------------------------------------------------------------
  ACCESSIBLE DISCLOSURE, NOT HOVER-ONLY
  ------------------------------------------------------------------
  Mega menus use <details>/<summary>: reachable by Tab, activated by
  Enter or Space, closed by Escape, expanded state announced. v3's
  opened on mouseenter against a plain div.

  ------------------------------------------------------------------
  NOT CARRIED OVER - DECIDE BEFORE LAUNCH
  ------------------------------------------------------------------
  Retail store locator dropdown (22 location templates exist, so this is
  probably wanted), ADA compliance widget, contact-us panel, store
  details dropdown.
  ==================================================================
{% endcomment %}

{{ 'gs-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign menu = s.menu
  assign mega_blocks = section.blocks | where: 'type', 'nav_menu_img'

  # Precomputed once, outside the loop.
  assign highlight_match = ''
  if s.highlight_enable and s.highlight_text != blank
    assign highlight_match = s.highlight_text | downcase | strip
  endif
-%}

<header
  class="gs-header color-{{ s.color_scheme }}{% if s.sticky_header %} gs-header--sticky{% endif %}"
  style="
    --gs-header-bg: {{ s.header_background | default: '#000000' }};
    --gs-header-text: {{ s.header_text | default: '#ffffff' }};
    --gs-header-hover: {{ s.header_text_hover | default: '#e7e7e7' }};
    --gs-header-icon: {{ s.header_icon | default: '#ffffff' }};
    --gs-cart-count-bg: {{ s.cart_count_background | default: '#5c5c5c' }};
    --gs-cart-count-text: {{ s.cart_count_text | default: '#ffffff' }};
    --gs-nav-bg: {{ s.nav_background | default: '#000000' }};
    --gs-mega-bg: {{ s.mega_background | default: '#ffffff' }};
    --gs-mega-text: {{ s.mega_text | default: '#121212' }};
    --gs-highlight-bg: {{ s.highlight_background | default: '#ab192d' }};
    --gs-highlight-text: {{ s.highlight_text_color | default: '#ffffff' }};
    --gs-logo-width: {{ s.logo_width | default: 180 }}px;
    --gs-logo-width-mobile: {{ s.logo_width_mobile | default: 130 }}px;
  "
>
  <div class="gs-header__main">
    <div class="page-width gs-header__main-inner">

      <button
        type="button"
        class="gs-header__burger"
        aria-expanded="false"
        aria-controls="GsMobileNav"
        aria-label="{{ 'sections.header.menu' | t }}"
        data-gs-nav-toggle
      >
        <span class="gs-header__burger-bar" aria-hidden="true"></span>
        <span class="gs-header__burger-bar" aria-hidden="true"></span>
        <span class="gs-header__burger-bar" aria-hidden="true"></span>
      </button>

      <div class="gs-header__logo">
        {%- if request.page_type == 'index' -%}
          <h1 class="gs-header__logo-heading">
        {%- endif -%}
        <a href="{{ routes.root_url }}" class="gs-header__logo-link" aria-label="{{ shop.name | escape }}">
          {%- if s.logo != blank -%}
            <img
              src="{{ s.logo | image_url: width: 400 }}"
              srcset="{{ s.logo | image_url: width: 200 }} 200w, {{ s.logo | image_url: width: 400 }} 400w"
              sizes="{{ s.logo_width }}px"
              alt="{{ s.logo.alt | escape | default: shop.name | escape }}"
              width="{{ s.logo.width }}"
              height="{{ s.logo.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <span class="gs-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if request.page_type == 'index' -%}
          </h1>
        {%- endif -%}
      </div>

      {%- if s.show_search -%}
        <div class="gs-header__search">
          {%- if settings.predictive_search_enabled -%}
            <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
          {%- endif -%}
            <form action="{{ routes.search_url }}" method="get" role="search" class="gs-header__search-form">
              <label class="visually-hidden" for="GsHeaderSearch-{{ section.id }}">
                {{ 'general.search.search' | t }}
              </label>
              <svg class="gs-header__search-icon" viewBox="0 0 18 19" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.72l5.4 5.4a.5.5 0 01-.71.7l-5.41-5.38z" fill="currentColor" fill-rule="evenodd"/>
              </svg>
              <input
                id="GsHeaderSearch-{{ section.id }}"
                class="gs-header__search-input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ s.search_placeholder | escape }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="GsPredictiveResults-{{ section.id }}"
                  aria-controls="GsPredictiveResults-{{ section.id }}"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <input type="hidden" name="options[prefix]" value="last">

              <button type="reset" class="gs-header__search-reset" aria-label="{{ 'general.search.reset' | t }}">
                {{ 'general.search.reset' | t }}
              </button>

              <button type="submit" class="gs-header__search-submit" aria-label="{{ 'general.search.search' | t }}">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              {%- if settings.predictive_search_enabled -%}
                <div class="gs-header__predictive" tabindex="-1" data-predictive-search>
                  <div class="predictive-search__loading-state">
                    <svg class="spinner" viewBox="0 0 66 66" aria-hidden="true" focusable="false">
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </div>
                <span class="visually-hidden" role="status" aria-live="polite"></span>
              {%- endif -%}
            </form>
          {%- if settings.predictive_search_enabled -%}
            </predictive-search>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="gs-header__icons">
        {%- if s.rewards_link != blank -%}
          <a class="gs-header__icon" href="{{ s.rewards_link }}" aria-label="{{ s.rewards_label | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M12 2l2.9 6.3 6.9.8-5 4.7 1.3 6.8L12 17.4 5.9 20.6 7.2 13.8l-5-4.7 6.9-.8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if s.help_link != blank -%}
          <a class="gs-header__icon" href="{{ s.help_link }}" aria-label="{{ s.help_label | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <path d="M9.5 9a2.5 2.5 0 115 .5c0 1.5-2.5 2-2.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <circle cx="12" cy="17" r="1" fill="currentColor"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if s.stores_link != blank -%}
          <a class="gs-header__icon" href="{{ s.stores_link }}" aria-label="{{ s.stores_label | escape }}">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="M12 2.5c3.6 0 6.5 2.9 6.5 6.5 0 4.5-6.5 12-6.5 12S5.5 13.5 5.5 9c0-3.6 2.9-6.5 6.5-6.5z" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <circle cx="12" cy="9" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a
            class="gs-header__icon"
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            aria-label="{%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/>
              <path d="M4.5 20.5c0-4.1 3.4-6.5 7.5-6.5s7.5 2.4 7.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </a>
        {%- endif -%}

        <a
          class="gs-header__icon gs-header__cart"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'templates.cart.cart' | t }}"
          {% if settings.cart_type == 'drawer' %}id="cart-icon-bubble"{% endif %}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M4 6.5h16l-1.4 12a1.5 1.5 0 01-1.5 1.3H6.9a1.5 1.5 0 01-1.5-1.3L4 6.5z" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M8.5 9V6a3.5 3.5 0 017 0v3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="gs-header__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" aria-hidden="true">
            {{- cart.item_count -}}
          </span>
          <span class="visually-hidden">
            {{ 'sections.header.cart_count' | t: count: cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </div>

  {%- if menu != blank -%}
    <nav class="gs-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <div class="page-width">
        <ul class="gs-header__nav-list" id="GsMobileNav">
          {%- for link in menu.links -%}
            {%- liquid
              assign link_title_down = link.title | downcase | strip

              # Title-string match, as in v3. See the header note.
              assign is_highlight = false
              if highlight_match != '' and link_title_down == highlight_match
                assign is_highlight = true
              endif

              # Count matching promo blocks so the column is only rendered
              # when there is something to put in it.
              assign promo_count = 0
              for promo in mega_blocks
                assign promo_title = promo.settings.menu_title | downcase | strip
                if promo_title == link_title_down and promo.settings.nav_image != blank
                  assign promo_count = promo_count | plus: 1
                endif
              endfor
            -%}

            {%- if link.links.size > 0 -%}
              <li class="gs-header__nav-item gs-header__nav-item--has-children{% if is_highlight %} gs-header__nav-item--highlight{% endif %}">
                <details class="gs-mega" data-gs-mega>
                  <summary class="gs-header__nav-link">
                    {{- link.title -}}
                    <svg class="gs-header__nav-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false">
                      <path d="M11 1L6 6L1 1" stroke="currentColor" stroke-width="2" fill="none"/>
                    </svg>
                  </summary>

                  <div class="gs-mega__panel">
                    <div class="page-width gs-mega__inner{% if promo_count == 0 %} gs-mega__inner--no-promo{% endif %}">
                      {%- if promo_count > 0 -%}
                        <div class="gs-mega__promo gs-mega__promo--{{ promo_count }}">
                          {%- for promo in mega_blocks -%}
                            {%- liquid
                              assign promo_title = promo.settings.menu_title | downcase | strip
                              if promo_title != link_title_down
                                continue
                              endif
                              if promo.settings.nav_image == blank
                                continue
                              endif
                              assign promo_img = promo.settings.nav_image
                            -%}
                            <a
                              class="gs-mega__tile"
                              href="{{ promo.settings.nav_link | default: link.url }}"
                              {{ promo.shopify_attributes }}
                            >
                              <img
                                src="{{ promo_img | image_url: width: 600 }}"
                                srcset="{{ promo_img | image_url: width: 400 }} 400w, {{ promo_img | image_url: width: 600 }} 600w"
                                sizes="300px"
                                alt="{{ promo_img.alt | escape | default: promo.settings.nav_label | escape }}"
                                width="{{ promo_img.width }}"
                                height="{{ promo_img.height }}"
                                loading="lazy"
                              >
                              {%- if promo.settings.nav_label != blank -%}
                                <span class="gs-mega__tile-label">{{ promo.settings.nav_label }}</span>
                              {%- endif -%}
                            </a>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}

                      <div class="gs-mega__columns">
                        {%- for child in link.links -%}
                          <div class="gs-mega__column">
                            <a class="gs-mega__column-title" href="{{ child.url }}">{{ child.title }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="gs-mega__sublist">
                                {%- for grandchild in child.links -%}
                                  <li>
                                    <a class="gs-mega__sublink" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            {%- else -%}
              <li class="gs-header__nav-item{% if is_highlight %} gs-header__nav-item--highlight{% endif %}">
                <a
                  class="gs-header__nav-link"
                  href="{{ link.url }}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </nav>
  {%- endif -%}
</header>

<script>
  (function () {
    if (window.gsHeaderBound) return;
    window.gsHeaderBound = true;

    document.addEventListener('click', function (evt) {
      if (!evt.target || !evt.target.closest) return;

      var toggle = evt.target.closest('[data-gs-nav-toggle]');
      if (toggle) {
        var header = toggle.closest('.gs-header');
        var open = header.classList.toggle('gs-header--nav-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        return;
      }

      // Only one mega menu open at a time.
      var summary = evt.target.closest('.gs-mega > summary');
      document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
        if (!summary || d !== summary.parentElement) d.open = false;
      });

      if (!evt.target.closest('.gs-mega')) {
        document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
          d.open = false;
        });
      }
    });

    document.addEventListener('keydown', function (evt) {
      if (evt.key !== 'Escape') return;
      document.querySelectorAll('details[data-gs-mega][open]').forEach(function (d) {
        d.open = false;
        var summary = d.querySelector('summary');
        if (summary) summary.focus();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "class": "gs-header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width (desktop)", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 180 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 70, "max": 220, "step": 10, "unit": "px", "default": 130 },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky_header", "label": "Sticky header", "default": true },
    { "type": "header", "content": "Highlighted nav item" },
    {
      "type": "checkbox",
      "id": "highlight_enable",
      "label": "Highlight a nav item",
      "info": "Gives one menu item a coloured tab, like the red BOGO 50% on the live site.",
      "default": true
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Menu item title to highlight",
      "info": "Must match the menu item title exactly. Renaming the item in the Shopify menu silently removes the highlight.",
      "default": "BOGO 50%"
    },
    { "type": "color", "id": "highlight_background", "label": "Highlight background", "default": "#ab192d" },
    { "type": "color", "id": "highlight_text_color", "label": "Highlight text", "default": "#ffffff" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search field", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "What are you looking for..." },
    { "type": "header", "content": "Icon links" },
    { "type": "url", "id": "rewards_link", "label": "Rewards link" },
    { "type": "text", "id": "rewards_label", "label": "Rewards label", "default": "Rewards" },
    { "type": "url", "id": "help_link", "label": "Help link" },
    { "type": "text", "id": "help_label", "label": "Help label", "default": "Help" },
    { "type": "url", "id": "stores_link", "label": "Retail stores link" },
    { "type": "text", "id": "stores_label", "label": "Retail stores label", "default": "Retail stores" },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "color", "id": "header_background", "label": "Header background", "default": "#000000" },
    { "type": "color", "id": "nav_background", "label": "Nav row background", "default": "#000000" },
    { "type": "color", "id": "header_text", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "header_text_hover", "label": "Text hover", "default": "#e7e7e7" },
    { "type": "color", "id": "header_icon", "label": "Icons", "default": "#ffffff" },
    { "type": "color", "id": "cart_count_background", "label": "Cart count background", "default": "#5c5c5c" },
    { "type": "color", "id": "cart_count_text", "label": "Cart count text", "default": "#ffffff" },
    { "type": "header", "content": "Mega menu" },
    {
      "type": "color",
      "id": "mega_background",
      "label": "Panel background",
      "info": "The panel inverts against the header - white on the live site.",
      "default": "#ffffff"
    },
    { "type": "color", "id": "mega_text", "label": "Panel text", "default": "#121212" }
  ],
  "blocks": [
    {
      "type": "nav_menu_img",
      "name": "Mega menu image",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Menu item title",
          "info": "Must match the top-level menu item title exactly. Add several blocks with the same title to show multiple tiles."
        },
        { "type": "image_picker", "id": "nav_image", "label": "Image" },
        { "type": "url", "id": "nav_link", "label": "Image link" },
        { "type": "text", "id": "nav_label", "label": "Caption", "info": "Optional. Shown over the image." }
      ]
    }
  ]
}
{% endschema %}
