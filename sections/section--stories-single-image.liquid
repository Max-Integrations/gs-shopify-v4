{% comment %}
  ==================================================================
  STORIES (SINGLE IMAGE)
  Ported from gs-shopify-v3 sections/stories-single-image.liquid +
  assets/stories.css and the rules in assets/custom-theme-styles.css
  463-490 that actually produced the About page's look
  ==================================================================
  A heading over a horizontal strip of tall photo tiles, four visible
  on desktop, one on mobile. Each tile shows its title in a circular
  badge; hovering (or focusing) a tile lifts the 60% black scrim, zooms
  the photo, slides the badge up and turns it olive, and reveals the
  description. On the About page it is the "History Of Grunt Style"
  timeline, one tile per year.

  All v3 section and block setting ids are unchanged (the image is
  `image1`, as in v3), so the live template JSON ports as-is.

  ------------------------------------------------------------------
  CHANGES FROM v3
  ------------------------------------------------------------------
  - FLICKITY REMOVED. Native overflow scroller with scroll-snap; the
    arrows step one tile and disable at the ends, same as
    section--testimonials. No wrap-around (v3 had none either).
  - The hover reveal also fires on :focus-within so keyboard users can
    read each year. Touch users see the description after a tap
    because the tile receives focus.
  - The look that lived in v3's global custom-theme-styles.css (badge
    circle, scrim, 24% tiles) is baked in here, so the section does
    not depend on a theme-wide stylesheet.
  - `video1`, `pagination_style`, `pagination_position`,
    `desktop_grid_gap`, `mobile_grid_gap`, `content_background` and the
    per-block button/overlay colour settings are accepted (kept in the
    schema so old JSON validates) but only the colours the About page
    uses are applied: heading_color and text_color.
  - lazy-image and marker snippets inlined.
  ==================================================================
{% endcomment %}

{{ 'section--stories-single-image.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign highlight_class = 'line-marker highlight-underline'
  if s.highlight_style == 'background'
    assign highlight_class = 'line-marker highlight-background highlight-background-solid'
    if s.bg__color == 'gradient'
      assign highlight_class = 'line-marker highlight-background highlight-background-gradient'
    endif
  endif
  assign highlight_prefix = '<span class="' | append: highlight_class | append: '">'
  assign highlight_suffix = '</span>'
-%}

<div
  class="gs-stories color-{{ s.color_scheme | default: 'scheme-1' }}{% if s.enable_gradient %} gradient{% endif %} gs-st--visibility-{{ s.section_visibility | default: 'always' }}{% if s.section_width %} gs-st--fullwidth{% endif %}"
  id="GsStories-{{ section.id }}"
  data-gs-stories
  style="
    --st-pad-top: {{ s.top_space_desktop | default: 70 }}px;
    --st-pad-bottom: {{ s.bottom_space_desktop | default: 70 }}px;
    --st-pad-top-mobile: {{ s.top_space_mobile | default: 40 }}px;
    --st-pad-bottom-mobile: {{ s.bottom_space_mobile | default: 40 }}px;
    --st-height: {{ s.desktop_row_height | default: 600 }}px;
    --st-height-mobile: {{ s.mobile_row_height | default: 300 }}px;
  "
>
  <div class="page-width">
    {%- if s.heading != blank or s.description != blank -%}
      <div class="section-title {{ s.content_alignment | default: 'text-center' }}">
        {%- if s.heading != blank -%}
          <{{ s.seo_heading | default: 'h2' }} class="{{ s.heading_size | default: 'h1' }} section-heading">
            {{ s.heading | replace: '[', highlight_prefix | replace: ']', highlight_suffix }}
          </{{ s.seo_heading | default: 'h2' }}>
        {%- endif -%}
        {%- if s.description != blank -%}
          <p class="section-desc">{{ s.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="{% unless s.section_width %}page-width{% endunless %}">
    {%- if section.blocks.size > 0 -%}
      <div class="gs-st__scroller">
        <button
          type="button"
          class="gs-st__nav gs-st__nav--prev"
          data-gs-st="prev"
          aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous' }}"
          disabled
        >
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 6H1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5.5 1.5L1 6L5.5 10.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <ul class="gs-st__track stories-single-image-wrapper" data-gs-st-track>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- liquid
              assign align = 'center'
              if b.content_position contains '-right'
                assign align = 'right'
              elsif b.content_position contains '-left'
                assign align = 'left'
              endif
            -%}
            <li
              id="stories-grid-block-{{ block.id }}"
              class="stories-grid-block{% if b.content_on_hover %} content-on-hover{% endif %}"
              style="--st-heading-color: {{ b.heading_color | default: '#ffffff' }}; --st-text-color: {{ b.text_color | default: '#ffffff' }};"
              tabindex="0"
              {{ block.shopify_attributes }}
            >
              <div class="stories-grid-item img-zoom">
                <div class="stories-grid-image">
                  <div class="media media-fixed">
                    {%- if b.image1 != blank -%}
                      <img
                        src="{{ b.image1 | image_url: width: 800 }}"
                        srcset="{{ b.image1 | image_url: width: 400 }} 400w, {{ b.image1 | image_url: width: 600 }} 600w, {{ b.image1 | image_url: width: 800 }} 800w"
                        sizes="(min-width: 1025px) 25vw, 100vw"
                        width="{{ b.image1.width }}"
                        height="{{ b.image1.height }}"
                        loading="lazy"
                        alt="{{ b.image1.alt | default: b.heading | escape }}"
                      >
                    {%- else -%}
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                </div>

                {%- if b.heading != blank or b.description != blank -%}
                  <div class="stories-grid-content {{ b.content_position | default: 'center' }} text-{{ align }}">
                    {%- if b.heading != blank -%}
                      <{{ b.seo_heading | default: 'h2' }} class="{{ b.heading_size | default: 'h2' }} stories-grid-content-heading">{{ b.heading }}</{{ b.seo_heading | default: 'h2' }}>
                    {%- endif -%}
                    {%- if b.description != blank -%}
                      <div class="stories-grid-content-description rte">
                        <p>{{ b.description | newline_to_br }}</p>
                      </div>
                    {%- endif -%}
                    {%- if b.btn_text != blank and b.btn_link != blank -%}
                      <div class="stories-grid-content-button">
                        <a href="{{ b.btn_link }}" class="{% if b.show_button_as_link %}hyperlink{% else %}button{% endif %} {{ b.button_size | default: 'medium' }}-btn">{{ b.btn_text }}</a>
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <button
          type="button"
          class="gs-st__nav gs-st__nav--next"
          data-gs-st="next"
          aria-label="{{ 'general.slider.next_slide' | t | default: 'Next' }}"
        >
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true" focusable="false">
            <path d="M1.5 6H12.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 1.5L12.5 6L8 10.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('GsStories-{{ section.id }}');
    if (!root || root.gsBound) return;
    root.gsBound = true;

    var track = root.querySelector('[data-gs-st-track]');
    if (!track) return;
    var items = Array.prototype.slice.call(track.children);
    var prev = root.querySelector('[data-gs-st="prev"]');
    var next = root.querySelector('[data-gs-st="next"]');
    var raf = null;

    // Index of the first tile whose left edge is at or past the
    // track's scroll position.
    function firstVisible() {
      var left = track.scrollLeft;
      for (var i = 0; i < items.length; i++) {
        if (items[i].offsetLeft + items[i].offsetWidth / 2 > left) return i;
      }
      return items.length - 1;
    }

    function update() {
      var atStart = track.scrollLeft <= 1;
      var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
    }

    function goTo(i) {
      i = Math.max(0, Math.min(items.length - 1, i));
      track.scrollTo({ left: items[i].offsetLeft, behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { goTo(firstVisible() - 1); });
    if (next) next.addEventListener('click', function () { goTo(firstVisible() + 1); });

    track.addEventListener('scroll', function () {
      if (raf) return;
      raf = window.requestAnimationFrame(function () { raf = null; update(); });
    }, { passive: true });
    window.addEventListener('resize', update);

    update();
  })();
</script>

{% schema %}
{
  "name": "Stories",
  "tag": "section",
  "class": "gs-stories-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "checkbox", "id": "section_width", "label": "Full width strip", "default": false },
    {
      "type": "select",
      "id": "section_visibility",
      "label": "Show on",
      "options": [
        { "value": "always", "label": "All devices" },
        { "value": "small", "label": "Mobile only" },
        { "value": "large", "label": "Desktop only" }
      ],
      "default": "always"
    },
    { "type": "range", "id": "desktop_row_height", "label": "Tile height (desktop)", "min": 300, "max": 900, "step": 50, "unit": "px", "default": 600 },
    { "type": "range", "id": "mobile_row_height", "label": "Tile height (mobile)", "min": 200, "max": 600, "step": 50, "unit": "px", "default": 300 },
    { "type": "range", "id": "desktop_grid_gap", "label": "Gap (desktop)", "info": "Kept from v3; not used by the strip layout.", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 5 },
    { "type": "range", "id": "mobile_grid_gap", "label": "Gap (mobile)", "info": "Kept from v3; not used by the strip layout.", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 5 },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "info": "Kept from v3; the strip uses arrows only.",
      "options": [
        { "value": "bars", "label": "Bars" },
        { "value": "dots", "label": "Dots" }
      ],
      "default": "bars"
    },
    {
      "type": "select",
      "id": "pagination_position",
      "label": "Pagination position",
      "info": "Kept from v3; the strip uses arrows only.",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap words in [brackets] to highlight them.", "default": "Stories" },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "Highlight style",
      "options": [
        { "value": "underline", "label": "Underline" },
        { "value": "shape_2", "label": "Underline (shape 2)" },
        { "value": "shape_3", "label": "Underline (shape 3)" },
        { "value": "shape_4", "label": "Underline (shape 4)" },
        { "value": "shape_5", "label": "Underline (shape 5)" },
        { "value": "shape_6", "label": "Underline (shape 6)" },
        { "value": "background", "label": "Background" }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "bg__color",
      "label": "Highlight background",
      "options": [
        { "value": "gradient", "label": "Gradient" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "gradient"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "seo_heading",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    { "type": "inline_richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ],
      "default": "text-center"
    },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "enable_gradient", "label": "Use gradient background", "default": false },
    { "type": "range", "id": "top_space_desktop", "label": "Top padding (desktop)", "unit": "px", "default": 70, "min": 0, "max": 150, "step": 5 },
    { "type": "range", "id": "bottom_space_desktop", "label": "Bottom padding (desktop)", "unit": "px", "default": 70, "min": 0, "max": 150, "step": 5 },
    { "type": "range", "id": "top_space_mobile", "label": "Top padding (mobile)", "unit": "px", "default": 40, "min": 0, "max": 100, "step": 5 },
    { "type": "range", "id": "bottom_space_mobile", "label": "Bottom padding (mobile)", "unit": "px", "default": 40, "min": 0, "max": 100, "step": 5 }
  ],
  "blocks": [
    {
      "type": "stories-content",
      "name": "Story",
      "settings": [
        { "type": "image_picker", "id": "image1", "label": "Image" },
        { "type": "video", "id": "video1", "label": "Video", "info": "Kept from v3; not rendered by this port." },
        { "type": "checkbox", "id": "content_on_hover", "label": "Show description on hover", "default": true },
        { "type": "checkbox", "id": "content_background", "label": "Content background", "info": "Kept from v3; not used by this port.", "default": false },
        { "type": "text", "id": "heading", "label": "Title", "info": "Shown in the circular badge." },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Title size",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        {
          "type": "select",
          "id": "seo_heading",
          "label": "Title tag",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" },
            { "value": "h5", "label": "H5" },
            { "value": "h6", "label": "H6" }
          ],
          "default": "h2"
        },
        { "type": "textarea", "id": "description", "label": "Description" },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "center-left", "label": "Center left" },
            { "value": "center-right", "label": "Center right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "center"
        },
        { "type": "text", "id": "btn_text", "label": "Button text" },
        { "type": "url", "id": "btn_link", "label": "Button link" },
        { "type": "checkbox", "id": "show_button_as_link", "label": "Show button as a text link", "default": false },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        },
        { "type": "color", "id": "heading_color", "label": "Title color", "default": "#ffffff" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "color", "id": "btn_bg_color", "label": "Button background", "default": "#ffffff" },
        { "type": "color", "id": "btn_shadow_color", "label": "Button shadow", "default": "#575757" },
        { "type": "color", "id": "btn_text_color", "label": "Button text", "default": "#000000" },
        { "type": "color", "id": "btn_border_color", "label": "Button border", "default": "#ffffff" },
        { "type": "color", "id": "btn_hover_color", "label": "Button hover background", "default": "#000000" },
        { "type": "color", "id": "btn_hover_text_color", "label": "Button hover text", "default": "#ffffff" },
        { "type": "color", "id": "btn_hover_border_color", "label": "Button hover border", "default": "#000000" },
        { "type": "color", "id": "content_overlay_color", "label": "Overlay color", "default": "#000000" },
        { "type": "range", "id": "content_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 },
        { "type": "color", "id": "content_background_color", "label": "Content background color", "default": "#ffffff" },
        { "type": "range", "id": "content_background_opacity", "label": "Content background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stories",
      "blocks": [
        { "type": "stories-content" },
        { "type": "stories-content" },
        { "type": "stories-content" },
        { "type": "stories-content" }
      ]
    }
  ]
}
{% endschema %}
