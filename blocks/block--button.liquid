{% comment %}
  ==================================================================
  BLOCK: BUTTON (generic theme block)
  ==================================================================
  One button or text link. With no link it renders as a <span> styled
  like a button, for tiles that are already one big link (a nested <a>
  is invalid HTML). Colours are optional overrides; when blank the
  parent's --mg-btn-* custom properties apply. The border follows the
  background.
  ==================================================================
{% endcomment %}

{%- liquid
  assign s = block.settings
  assign classes = 'gs-block-button gs-block-button--' | append: s.style | append: ' gs-block-button--' | append: s.size
-%}

{%- capture style_vars -%}
  {%- if s.bg != blank and s.bg != 'rgba(0,0,0,0)' %}--gs-btn-bg: {{ s.bg }};{% endif -%}
  {%- if s.text_color != blank and s.text_color != 'rgba(0,0,0,0)' %}--gs-btn-text: {{ s.text_color }};{% endif -%}
  {%- if s.hover_bg != blank and s.hover_bg != 'rgba(0,0,0,0)' %}--gs-btn-bg-hover: {{ s.hover_bg }};{% endif -%}
  {%- if s.hover_text_color != blank and s.hover_text_color != 'rgba(0,0,0,0)' %}--gs-btn-text-hover: {{ s.hover_text_color }};{% endif -%}
{%- endcapture -%}

{%- if s.label != blank or request.design_mode -%}
  <div class="gs-block-button-wrap" {{ block.shopify_attributes }}>
    {%- if s.link != blank -%}
      <a
        class="{{ classes }}"
        href="{{ s.link }}"
        {% if s.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
        {% if style_vars != blank %}style="{{ style_vars | strip }}"{% endif %}
      >
        {{- s.label | default: 'Button' -}}
      </a>
    {%- else -%}
      <span class="{{ classes }}" {% if style_vars != blank %}style="{{ style_vars | strip }}"{% endif %}>
        {{- s.label | default: 'Button' -}}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .gs-block-button {
    display: inline-block;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .gs-block-button--button {
    background-color: var(--gs-btn-bg, var(--mg-btn-bg, #ffffff));
    color: var(--gs-btn-text, var(--mg-btn-text, #000000));
    border: 1px solid var(--gs-btn-bg, var(--mg-btn-bg, #ffffff));
  }
  .gs-block-button--button:hover,
  .gs-block-button--button:focus-visible,
  .gs-block-hover-target:hover .gs-block-button--button {
    background-color: var(--gs-btn-bg-hover, var(--mg-btn-bg-hover, #000000));
    color: var(--gs-btn-text-hover, var(--mg-btn-text-hover, #ffffff));
    border-color: var(--gs-btn-bg-hover, var(--mg-btn-bg-hover, #000000));
  }
  .gs-block-button--small { padding: 0.6em 1.4em; font-size: 0.875rem; }
  .gs-block-button--medium { padding: 0.8em 1.8em; font-size: 1rem; }
  .gs-block-button--large { padding: 1em 2.2em; font-size: 1.125rem; }
  .gs-block-button--link {
    padding: 0;
    background: transparent;
    border: 0;
    color: var(--gs-btn-text, var(--mg-text, inherit));
    text-decoration: underline;
  }
  a.gs-block-button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .gs-block-button { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "tag": null,
  "name": "Button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave empty inside a tile that is linked as a whole." },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "button", "label": "Button" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "button"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in a new tab", "default": false },
    { "type": "header", "content": "Overrides", "info": "Empty inherits the section's button colors." },
    { "type": "color", "id": "bg", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "hover_bg", "label": "Hover background" },
    { "type": "color", "id": "hover_text_color", "label": "Hover text" }
  ],
  "presets": [
    { "name": "Button" }
  ]
}
{% endschema %}
