{% doc %}
  @prompt
    two column layout for mobile and desktop adjustments, title, subcopy and ability to embed code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-layout__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-two-column-layout__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-two-column-layout__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-two-column-layout__subcopy-{{ ai_gen_id }} {
    font-size: {{ block.settings.subcopy_size }}px;
    color: {{ block.settings.subcopy_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-two-column-layout__embed-{{ ai_gen_id }} {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-layout__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-two-column-layout__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-two-column-layout__subcopy-{{ ai_gen_id }} {
      font-size: {{ block.settings.subcopy_size_mobile }}px;
    }

    .ai-two-column-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-two-column-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-layout__container-{{ ai_gen_id }}">
    <div class="ai-two-column-layout__column-{{ ai_gen_id }}">
      {% if block.settings.column_1_title != blank %}
        <h2 class="ai-two-column-layout__title-{{ ai_gen_id }}">
          {{ block.settings.column_1_title }}
        </h2>
      {% endif %}

      {% if block.settings.column_1_subcopy != blank %}
        <div class="ai-two-column-layout__subcopy-{{ ai_gen_id }}">
          {{ block.settings.column_1_subcopy }}
        </div>
      {% endif %}

      {% if block.settings.column_1_embed != blank %}
        <div class="ai-two-column-layout__embed-{{ ai_gen_id }}">
          {{ block.settings.column_1_embed }}
        </div>
      {% endif %}
    </div>

    <div class="ai-two-column-layout__column-{{ ai_gen_id }}">
      {% if block.settings.column_2_title != blank %}
        <h2 class="ai-two-column-layout__title-{{ ai_gen_id }}">
          {{ block.settings.column_2_title }}
        </h2>
      {% endif %}

      {% if block.settings.column_2_subcopy != blank %}
        <div class="ai-two-column-layout__subcopy-{{ ai_gen_id }}">
          {{ block.settings.column_2_subcopy }}
        </div>
      {% endif %}

      {% if block.settings.column_2_embed != blank %}
        <div class="ai-two-column-layout__embed-{{ ai_gen_id }}">
          {{ block.settings.column_2_embed }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

