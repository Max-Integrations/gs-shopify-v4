{% comment %}
  ==================================================================
  BLOCK: CONTACT CHANNEL (theme block for section--contact-channels)
  ==================================================================
  One way to reach customer service: an icon, a title, a detail line
  (hours, the address itself) and an action. The action is either a
  link (mailto:, tel:, or a page) or "chat", which opens the Gorgias
  widget.

  CHAT: v3 rendered a button labelled "Chat N/A" that flipped to "Chat
  Now!" only if GorgiasChat.isChatOnline() answered, and called
  GorgiasChat.open() unguarded. Here the button starts hidden. The
  section's script waits for the Gorgias app embed (GorgiasChat.init()
  or the gorgias-widget-loaded event), then shows the button with the
  online or offline label from isBusinessHours(). If Gorgias never
  loads, the card still shows its hours; there is no dead button.
  ==================================================================
{% endcomment %}

{%- liquid
  assign s = block.settings
  assign has_action = false
  if s.action == 'chat'
    assign has_action = true
  elsif s.link != blank and s.label != blank
    assign has_action = true
  endif
-%}

<div class="gs-contact-card" {{ block.shopify_attributes }}>
  {%- if s.icon != 'none' -%}
    <span class="gs-contact-card__icon" aria-hidden="true">
      {%- case s.icon -%}
        {%- when 'chat' -%}
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H9l-4.2 3.4c-.4.3-.8 0-.8-.5V5.5Z"/><path d="M8 8h8M8 11.5h5"/></svg>
        {%- when 'email' -%}
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
        {%- when 'phone' -%}
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 3h3l1.7 4.2-2.1 1.6a12 12 0 0 0 6.1 6.1l1.6-2.1L20 14.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3Z"/></svg>
        {%- when 'store' -%}
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5 5.2 4h13.6L20 9.5"/><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0"/><path d="M5.5 12v8h13v-8"/><path d="M10 20v-5h4v5"/></svg>
      {%- endcase -%}
    </span>
  {%- endif -%}

  {%- if s.title != blank -%}
    <h3 class="gs-contact-card__title h4">{{ s.title }}</h3>
  {%- endif -%}

  {%- if s.detail != blank -%}
    <div class="gs-contact-card__detail rte">{{ s.detail }}</div>
  {%- endif -%}

  {%- if has_action -%}
    <div class="gs-contact-card__action">
      {%- if s.action == 'chat' -%}
        <button
          type="button"
          class="button gs-contact-card__button"
          data-gs-chat
          data-label-online="{{ s.label_online | default: 'Chat now' | escape }}"
          data-label-offline="{{ s.label_offline | default: 'Leave us a message' | escape }}"
          hidden
        >
          {{- s.label_online | default: 'Chat now' -}}
        </button>
      {%- else -%}
        <a class="button gs-contact-card__button" href="{{ s.link }}">{{ s.label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "tag": null,
  "name": "Contact channel",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "chat", "label": "Chat" },
        { "value": "email", "label": "Email" },
        { "value": "phone", "label": "Phone" },
        { "value": "store", "label": "Store" },
        { "value": "none", "label": "None" }
      ],
      "default": "chat"
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Chat" },
    { "type": "richtext", "id": "detail", "label": "Detail", "info": "Hours, the address, or a short note.", "default": "<p>Mon - Fri: 9am - 5pm CST</p>" },
    {
      "type": "select",
      "id": "action",
      "label": "Action",
      "options": [
        { "value": "link", "label": "Link" },
        { "value": "chat", "label": "Open live chat" }
      ],
      "default": "link"
    },
    { "type": "text", "id": "label", "label": "Link label", "info": "For the Link action.", "default": "Email us" },
    { "type": "url", "id": "link", "label": "Link", "info": "Pages, mailto: and tel: links all work." },
    { "type": "text", "id": "label_online", "label": "Chat label (during business hours)", "default": "Chat now" },
    { "type": "text", "id": "label_offline", "label": "Chat label (outside business hours)", "default": "Leave us a message" }
  ],
  "presets": [
    { "name": "Contact channel" }
  ]
}
{% endschema %}
