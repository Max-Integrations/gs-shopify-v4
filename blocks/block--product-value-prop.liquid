{% comment %}
  BLOCK: PRODUCT VALUE PROP (child of block--product-value-props)
  ==================================================================
  One icon + caption tile, optionally linked, optionally hidden for
  tagged products. The caption is uppercase 11px bold as on the live
  site.
  ==================================================================
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign p = closest.product | default: product
  assign hidden = false
  if s.hide_for_tags != blank
    assign hay = p.tags | join: '|' | downcase | prepend: '|' | append: '|'
    assign list = s.hide_for_tags | split: ','
    for t in list
      assign needle = t | strip | downcase | prepend: '|' | append: '|'
      if needle != '||' and hay contains needle
        assign hidden = true
      endif
    endfor
  endif
  assign tag = 'div'
  if s.link != blank
    assign tag = 'a'
  endif
-%}

{%- unless hidden -%}
  {%- if s.image != blank or s.text != blank or request.design_mode -%}
    <{{ tag }} class="gs-product__prop"{% if s.link != blank %} href="{{ s.link }}"{% endif %} {{ block.shopify_attributes }}>
      <span class="gs-product__prop-icon">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 250 | image_tag: loading: 'lazy', alt: s.image.alt | default: '' }}
        {%- endif -%}
      </span>
      {%- if s.text != blank -%}
        <span class="gs-product__prop-text">{{ s.text | newline_to_br }}</span>
      {%- endif -%}
    </{{ tag }}>
  {%- endif -%}
{%- endunless -%}

{% stylesheet %}
  .gs-product__prop {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    padding: 4px;
    border-right: 1px solid #666;
    color: inherit;
    text-decoration: none;
  }

  .gs-product__prop:last-child { border-right-color: transparent; }

  .gs-product__prop-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75%;
    min-height: 70px;
  }

  .gs-product__prop-icon img {
    display: block;
    width: 100%;
    max-height: 85px;
    height: auto;
    object-fit: contain;
  }

  .gs-product__prop-text {
    font-size: 11px;
    font-weight: 700;
    line-height: 15px;
    letter-spacing: 1px;
    text-align: center;
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "tag": null,
  "name": "Value prop",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Icon" },
    { "type": "textarea", "id": "text", "label": "Caption" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "hide_for_tags", "label": "Hide for products tagged", "info": "Comma separated." }
  ],
  "presets": [{ "name": "Value prop" }]
}
{% endschema %}
