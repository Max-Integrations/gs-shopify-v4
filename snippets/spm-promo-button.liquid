{% comment %}
  Renders one "button" block for section--sale-promo-message.
  Accepts:
  - block: the section block
{% endcomment %}
<a
    href="{{ block.settings.url }}"
    class="promo-btn"
    style="
        --color: {{ block.settings.text_color }};
        --background-color: {{ block.settings.background_color }};
        --border-color: {{ block.settings.border_color }};
        --border-width: {{ block.settings.border_width }}px;
        --padding-x-desktop: {{ block.settings.padding_horizontal_desktop }}px;
        --padding-y-desktop: {{ block.settings.padding_vertical_desktop }}px;
        --padding-x-mobile: {{ block.settings.padding_horizontal_mobile }}px;
        --padding-y-mobile: {{ block.settings.padding_vertical_mobile }}px;
        --font-size-desktop: {{ block.settings.size_scale_desktop }};
        --font-size-mobile: {{ block.settings.size_scale_mobile }};
        --letter-spacing: {{ block.settings.letter_spacing }}px;
        {% if block.settings.text_color_hover != blank %}--color-hover: {{ block.settings.text_color_hover }};{% endif %}
        {% if block.settings.background_color_hover != blank %}--background-color-hover: {{ block.settings.background_color_hover }};{% endif %}
        {% if block.settings.border_color_hover != blank %}--border-color-hover: {{ block.settings.border_color_hover }};{% endif %}
        {% if block.settings.text_color_hover != blank or block.settings.background_color_hover != blank or block.settings.border_color_hover != blank %}--hover-opacity: 1;{% endif %}
    "
    {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
    {{ block.shopify_attributes }}
>
    {{ block.settings.text }}
</a>
